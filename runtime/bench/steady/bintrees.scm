(define (make d) (if (= d 0) (cons #f #f) (cons (make (- d 1)) (make (- d 1)))))
(define (check t) (if (car t) (+ 1 (check (car t)) (check (cdr t))) 1))
(define max-depth 16)
(define (iterate d acc)
  (if (> d max-depth) acc
      (let ((iters (expt 2 (+ (- max-depth d) 4))))
        (let loop ((i 0) (sum acc))
          (if (< i iters) (loop (+ i 1) (+ sum (check (make d))))
              (iterate (+ d 2) sum))))))
(define (run)
  (let* ((stretch (check (make (+ max-depth 1))))
         (long-lived (make max-depth))
         (sum (iterate 4 stretch)))
    (+ sum (check long-lived))))
