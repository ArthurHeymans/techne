;; Setup is outside the timed loop. Run each key mode in a fresh VM.
(define n 200000)
(define mode (cadr (command-line)))
(define h (make-hash-table))
(define key
  (cond ((string=? mode "integer") (lambda (i) i))
        ((or (string=? mode "fresh") (string=? mode "convert")) number->string)
        ((string=? mode "reused")
         (let ((keys (make-vector n)))
           (do ((i 0 (+ i 1))) ((= i n)) (vector-set! keys i (number->string i)))
           (lambda (i) (vector-ref keys i))))
        (else (error "expected integer, fresh, reused or convert"))))
(define conversion? (string=? mode "convert"))
(unless conversion?
  (do ((i 0 (+ i 1))) ((= i n)) (hash-table-set! h (key i) i)))
(define (lookup)
  (let loop ((i 0) (acc 0))
    (if (= i n) acc (loop (+ i 1) (+ acc (hash-table-ref/default h (key i) -1))))))
(define (convert)
  (let loop ((i 0) (acc 0))
    (if (= i n) acc (loop (+ i 1) (+ acc (string-length (key i)))))))
(define work (if conversion? convert lookup))
;; With the opt-in census binary, bracket one warmed call. Never time the census.
(define census? (get-environment-variable "TECHNE_ALLOC_CENSUS"))
(do ((trial 0 (+ trial 1))) ((= trial 10))
  (when (and census? (= trial 9)) (gc-stats))
  (let* ((start (current-jiffy)) (sum (work)) (end (current-jiffy)))
    (when (and census? (= trial 9)) (gc-stats))
    (unless (= sum (if conversion? 1088890 (quotient (* n (- n 1)) 2))) (error "wrong checksum"))
    (write (- end start)) (newline)))
