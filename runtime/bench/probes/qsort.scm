;; Same input recurrence as steady/qsort.scm; reuse its sorter and checker.
(require "../steady/qsort.scm")
(do ((trial 0 (+ trial 1))) ((= trial 10))
  (let ((start (current-jiffy)))
    (let fill ((i 0) (seed 42))
      (when (< i n)
        (vector-set! v i seed)
        (fill (+ i 1) (modulo (+ (* seed 75) 74) 65537))))
    (let ((filled (current-jiffy)))
      (qsort 0 (- n 1))
      (let* ((sorted (current-jiffy)) (ok (sorted? 0)) (checked (current-jiffy)))
        (unless (and ok (= 32758 (vector-ref v (quotient n 2))) (= 65535 (vector-ref v (- n 1))))
          (error "wrong qsort result"))
        (write (list (- filled start) (- sorted filled) (- checked sorted))) (newline)))))
