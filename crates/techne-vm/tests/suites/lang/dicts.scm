;;; Persistent dicts and sets.

(test-begin "dicts")

(define d {a 1 b 2 "s" (1 2)})
(test 3 (dict-size d))
(test 1 (dict-ref d 'a))
(test '(1 2) (dict-ref d "s"))
(test 'none (dict-ref d 'zz 'none))
(test-error (dict-ref d 'zz))
(test #t (dict-contains? d 'b))
(test #f (dict-contains? d 'c))
;; Updates leave the dict they start from as it was.
(test 3 (dict-ref (dict-set d 'c 3) 'c))
(test 9 (dict-ref (dict-set d 'a 9) 'a))
(test 3 (dict-size (dict-set d 'a 9)))
(test 2 (dict-size (dict-delete d 'a)))
(test 3 (dict-size (dict-delete d 'zz)))
(test 1 (dict-ref d 'a))
(test {a 2} (dict-update {a 1} 'a (lambda (x) (+ x 1))))
(test {a 1} (dict-update {} 'a (lambda (x) (+ x 1)) 0))
(test 3 (dict-fold (lambda (k v acc) (+ v acc)) 0 {a 1 b 2}))
(test {a 1 b 3 c 4} (dict-merge {a 1 b 2} {b 3} {c 4}))

;; Equal dicts are equal however they were made, and hash the same.
(test #t (equal? {a 1 b 2} (dict 'b 2 'a 1)))
(test #f (equal? {a 1 b 2} {a 1 b 3}))
(test #f (equal? {a 1} {a 1 b 2}))
(test #f (equal? {a 1} #{a}))
(test (hash {x 1 y (2)}) (hash (dict 'y (list 2) 'x 1)))
(test {b 2} (dict-delete {a 1 b 2} 'a))
(test {} (dict-delete {a 1} 'a))
(test 'v (dict-ref (dict-set {} {k #(1)} 'v) (dict 'k (vector 1))))
(test 2 (dict-ref (dict 'a 1 'a 2) 'a))
(test 1 (dict-ref (alist->dict '((a . 1) (a . 2))) 'a))
(test '((a . 1)) (dict->alist {a 1}))
(test '(b) (dict-keys {b 1}))
(test '(1) (dict-values {b 1}))
(test-error (dict 'a))
(test-error (dict-set '((a . 1)) 'a 2))

;; Many keys: what is deleted is gone, the rest stays.
(define (squares n) (let loop ((i 0) (d {})) (if (= i n) d (loop (+ i 1) (dict-set d i (* i i))))))
(define big (squares 5000))
(test 5000 (dict-size big))
(test (* 777 777) (dict-ref big 777))
(define evens (let loop ((i 1) (d big)) (if (>= i 5000) d (loop (+ i 2) (dict-delete d i)))))
(test 2500 (dict-size evens))
(test #f (dict-contains? evens 777))
(test (* 778 778) (dict-ref evens 778))
(test #t (equal? evens (alist->dict (map (lambda (i) (cons (* 2 i) (* 4 i i))) (iota 2500)))))
(test #t (equal? {} (let loop ((i 0) (d big)) (if (= i 5000) d (loop (+ i 1) (dict-delete d i))))))

;; Literals: written as read, data inside, quasiquote evaluates.
(test "{a 1}" (call-with-output-string (lambda (p) (write {a 1} p))))
(test "#{x}" (call-with-output-string (lambda (p) (write #{x} p))))
(test {a #{1 2} b #(1 2)} (read (open-input-string "{a #{1 2} b #(1 2)}")))
(test {a (+ 1 2)} (dict 'a '(+ 1 2)))
(let ((x 5)) (test {a 5 b 6} `{a ,x b ,(+ x 1)}))
(let ((xs '(1 2))) (test #{0 1 2} `#{0 ,@xs}))
(test 1 (eval '(dict-ref {a 1} 'a)))
(test-error (read (open-input-string "{a}")))
(test-error (read (open-input-string "{a 1 . b}")))
(test '((1 2) {a (1 2)}) (read (open-input-string "(#0=(1 2) {a #0#})")))
(test {(1) (1)} (read (open-input-string "{#0=(1) #0#}")))
;; What a dict holds is made before it: none of it can be circular yet.
(test-error (read (open-input-string "#0=(x {a #0#})")))
(test-error (read (open-input-string "{a #0=(1 . #0#)}")))
(test-error (read (open-input-string "(#0=(1 . #0#) {#0# 1})")))
(define-syntax make-entry (syntax-rules () ((_ k v) {k v})))
(test {key value} (make-entry key value))

(test-end)

(test-begin "sets")

(define s #{1 2 3})
(test 3 (set-size s))
(test #t (set-contains? s 2))
(test #f (set-contains? s 4))
(test 4 (set-size (set-add s 4)))
(test 3 (set-size (set-add s 3)))
(test 2 (set-size (set-delete s 3)))
(test #t (equal? #{1 2 3} (list->set '(3 2 1 2))))
(test '(1) (set->list (set 1 1)))
(test #{1 2 3 4} (set-union #{1 2} #{3} #{4 1}))
(test #{2} (set-intersection #{1 2 3} #{2 3} #{2}))
(test #{1} (set-difference #{1 2 3} #{2} #{3 4}))
(test 6 (set-fold + 0 #{1 2 3}))
(test #t (set? #{}))
(test #f (set? {}))
(test #t (dict? {}))

;; Keys sharing a long prefix hash the same: collision nodes, compared
;; in any order, also when the data is circular through them.
(define prefix (make-list 20 0))
(define (circular) (let* ((v (vector #f)) (s (set (append prefix (list v)) (append prefix '(p))))) (vector-set! v 0 s) s))
(test #t (equal? (circular) (circular)))
(test #t (equal? (set (append prefix '(a)) (append prefix '(b))) (set (append prefix '(b)) (append prefix '(a)))))
(test 1 (set-size (set-delete (set (append prefix '(a)) (append prefix '(b))) (append prefix '(a)))))

(test-end)
