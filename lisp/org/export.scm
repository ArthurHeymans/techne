;;; Native Org-mode export to Markdown, HTML, and Hugo (YAML front matter).
;;; Pure Scheme, reusing lisp/org/syntax.scm.

(require "syntax.scm")

(provide org->markdown org->hugo org->html)

(define (html-escape s)
  (let ((n (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (>= i n)
          (apply string-append (reverse acc))
          (let ((c (string-ref s i)))
            (loop (+ i 1)
                  (cons (case c
                          ((#\&) "&amp;")
                          ((#\<) "&lt;")
                          ((#\>) "&gt;")
                          ((#\") "&quot;")
                          (else (string c)))
                        acc)))))))

(define (safe-url? url)
  (let* ((u (string-trim url))
         (n (string-length u))
         (colon (string-index u #\:))
         (sep (let loop ((i 0))
                (cond ((>= i n) #f)
                      ((memv (string-ref u i) '(#\/ #\? #\#)) i)
                      (else (loop (+ i 1)))))))
    (or (not colon)
        (and sep (< sep colon))
        (and (member (string-downcase (substring u 0 colon)) '("http" "https" "mailto")) #t))))

(define (render-inlines-md text from to)
  (let* ((inlines (org-parse-inline text from to)))
    (let loop ((pos from) (ins inlines) (acc '()))
      (if (null? ins)
          (apply string-append (reverse (cons (org-slice-bytes text pos to) acc)))
          (let* ((in (car ins))
                 (s (org-inline-start in))
                 (e (org-inline-end in))
                 (k (org-inline-kind in))
                 (d (org-inline-data in)))
            (if (< s pos)
                (loop pos (cdr ins) acc)
                (let* ((pre (org-slice-bytes text pos s))
                       (rep
                        (case k
                          ((bold) (string-append "**" (org-slice-bytes text (+ s 1) (- e 1)) "**"))
                          ((italic) (string-append "*" (org-slice-bytes text (+ s 1) (- e 1)) "*"))
                          ((code verbatim) (string-append "`" (org-slice-bytes text (+ s 1) (- e 1)) "`"))
                          ((strike) (string-append "~~" (org-slice-bytes text (+ s 1) (- e 1)) "~~"))
                          ((link)
                           (let ((url (car d))
                                 (desc (and (cadr d) (org-slice-bytes text (cadr d) (caddr d)))))
                             (if (safe-url? url)
                                 (string-append "[" (or desc url) "](" url ")")
                                 (or desc url))))
                          (else (org-slice-bytes text s e)))))
                  (loop e (cdr ins) (cons rep (cons pre acc))))))))))

(define (render-inlines-html text from to)
  (let* ((inlines (org-parse-inline text from to)))
    (let loop ((pos from) (ins inlines) (acc '()))
      (if (null? ins)
          (apply string-append (reverse (cons (html-escape (org-slice-bytes text pos to)) acc)))
          (let* ((in (car ins))
                 (s (org-inline-start in))
                 (e (org-inline-end in))
                 (k (org-inline-kind in))
                 (d (org-inline-data in)))
            (if (< s pos)
                (loop pos (cdr ins) acc)
                (let* ((pre (html-escape (org-slice-bytes text pos s)))
                       (rep
                        (case k
                          ((bold) (string-append "<strong>" (html-escape (org-slice-bytes text (+ s 1) (- e 1))) "</strong>"))
                          ((italic) (string-append "<em>" (html-escape (org-slice-bytes text (+ s 1) (- e 1))) "</em>"))
                          ((code verbatim) (string-append "<code>" (html-escape (org-slice-bytes text (+ s 1) (- e 1))) "</code>"))
                          ((strike) (string-append "<del>" (html-escape (org-slice-bytes text (+ s 1) (- e 1))) "</del>"))
                          ((link)
                           (let ((url (car d))
                                 (desc (and (cadr d) (org-slice-bytes text (cadr d) (caddr d)))))
                             (if (safe-url? url)
                                 (string-append "<a href=\"" (html-escape url) "\">" (html-escape (or desc url)) "</a>")
                                 (html-escape (or desc url)))))
                          (else (html-escape (org-slice-bytes text s e))))))
                  (loop e (cdr ins) (cons rep (cons pre acc))))))))))

(define (export-elements-md text elems)
  (apply string-append
         (filter-map
          (lambda (el)
            (let ((k (org-element-kind el))
                  (s (org-element-start el))
                  (e (org-element-end el))
                  (d (org-element-data el)))
              (case k
                ((paragraph) (string-append (render-inlines-md text s e) "\n"))
                ((list-item)
                 (let ((indent (car d))
                       (bullet (org-slice-bytes text (list-ref d 1) (list-ref d 2)))
                       (cb (list-ref d 6))
                       (body-start (list-ref d 7)))
                   (string-append (make-string indent #\space)
                                  (if (string=? bullet "+") "-" bullet) " "
                                  (case cb ((on) "[x] ") ((off) "[ ] ") ((trans) "[-] ") (else ""))
                                  (string-trim (render-inlines-md text body-start e)) "\n")))
                ((src-block)
                 (let ((lang (car d)) (bs (list-ref d 3)) (be (list-ref d 4)))
                   (string-append "```" lang "\n" (org-slice-bytes text bs be) "```\n\n")))
                ((block)
                 (let ((bs (list-ref d 3)) (be (list-ref d 4)))
                   (string-append "```\n" (org-slice-bytes text bs be) "```\n\n")))
                ((table) (string-append (org-slice-bytes text s e) "\n"))
                ((rule) "---\n\n")
                (else #f))))
          elems)))

(define (export-elements-html text elems)
  (apply string-append
         (filter-map
          (lambda (el)
            (let ((k (org-element-kind el))
                  (s (org-element-start el))
                  (e (org-element-end el))
                  (d (org-element-data el)))
              (case k
                ((paragraph) (string-append "<p>" (string-trim (render-inlines-html text s e)) "</p>\n"))
                ((list-item)
                 (let ((cb (list-ref d 6))
                       (body-start (list-ref d 7)))
                   (string-append "<li>"
                                  (case cb ((on) "&#9745; ") ((off) "&#9744; ") (else ""))
                                  (string-trim (render-inlines-html text body-start e)) "</li>\n")))
                ((src-block)
                 (let ((lang (car d)) (bs (list-ref d 3)) (be (list-ref d 4)))
                   (string-append "<pre><code class=\"language-" (html-escape lang) "\">"
                                  (html-escape (org-slice-bytes text bs be)) "</code></pre>\n")))
                ((block)
                 (let ((bs (list-ref d 3)) (be (list-ref d 4)))
                   (string-append "<pre>" (html-escape (org-slice-bytes text bs be)) "</pre>\n")))
                ((table)
                 (let* ((raw (org-slice-bytes text s e))
                        (lines (filter (lambda (ln)
                                         (let ((t (string-trim ln)))
                                           (and (string-prefix? "|" t)
                                                (not (string-prefix? "|-" t)))))
                                       (string-split raw "\n")))
                        (rows-html
                         (map (lambda (ln)
                                (let* ((t (string-trim ln))
                                       (inner (substring t 1 (if (and (> (string-length t) 1)
                                                                      (char=? (string-ref t (- (string-length t) 1)) #\|))
                                                                 (- (string-length t) 1)
                                                                 (string-length t))))
                                       (cells (string-split inner "|")))
                                  (string-append "<tr>"
                                                 (apply string-append
                                                        (map (lambda (c)
                                                               (string-append "<td>" (html-escape (string-trim c)) "</td>"))
                                                             cells))
                                                 "</tr>\n")))
                              lines)))
                   (string-append "<table>\n" (apply string-append rows-html) "</table>\n")))
                ((rule) "<hr/>\n")
                (else #f))))
          elems)))

(define (outline-keyword-val ol key)
  (let ((uk (string-upcase key)))
    (let loop ((ks (org-outline-keywords ol)))
      (cond ((null? ks) #f)
            ((string=? (string-upcase (car (car ks))) uk) (string-trim (cdr (car ks))))
            (else (loop (cdr ks)))))))

(define (org->markdown text ol)
  "Export Org TEXT and outline OL to GitHub-flavored Markdown."
  (let* ((hs (org-outline-headings ol))
         (n (vector-length hs))
         (title (outline-keyword-val ol "TITLE"))
         (first-h (if (> n 0) (org-heading-start (vector-ref hs 0)) (org-utf8-length text)))
         (pre (if (> first-h 0) (export-elements-md text (org-parse-section text 0 first-h)) ""))
         (parts (list (if title (string-append "# " title "\n\n") "") pre)))
    (let loop ((i 0) (acc (reverse parts)))
      (if (>= i n)
          (apply string-append (reverse acc))
          (let* ((h (vector-ref hs i))
                 (lvl (min 6 (+ (org-heading-level h) (if title 1 0))))
                 (tr (org-heading-title-range h))
                 (hdr (string-append (make-string lvl #\#) " " (render-inlines-md text (car tr) (cdr tr)) "\n\n"))
                 (bs (org-heading-body-start h))
                 (se (org-heading-section-end ol h))
                 (body (if (< bs se) (export-elements-md text (org-parse-section text bs se)) "")))
            (loop (+ i 1) (cons body (cons hdr acc))))))))

(define (yaml-quote s)
  (let ((n (string-length s)))
    (let loop ((i 0) (acc '("\"")))
      (if (>= i n)
          (apply string-append (reverse (cons "\"" acc)))
          (let ((c (string-ref s i)))
            (loop (+ i 1)
                  (cons (case c
                          ((#\\) "\\\\")
                          ((#\") "\\\"")
                          ((#\newline) "\\n")
                          ((#\return) "\\r")
                          ((#\tab) "\\t")
                          (else (string c)))
                        acc)))))))

(define (valid-yaml-date? s)
  (let ((n (string-length s)))
    (and (>= n 10)
         (char-numeric? (string-ref s 0)) (char-numeric? (string-ref s 1))
         (char-numeric? (string-ref s 2)) (char-numeric? (string-ref s 3))
         (char=? (string-ref s 4) #\-)
         (char-numeric? (string-ref s 5)) (char-numeric? (string-ref s 6))
         (char=? (string-ref s 7) #\-)
         (char-numeric? (string-ref s 8)) (char-numeric? (string-ref s 9))
         (let loop ((i 10))
           (or (>= i n)
               (let ((c (string-ref s i)))
                 (and (or (char-numeric? c) (memv c '(#\T #\t #\space #\: #\- #\+ #\Z #\z #\.)))
                      (loop (+ i 1)))))))))

(define (org->hugo text ol)
  "Export Org TEXT and outline OL to Hugo Markdown with YAML front matter."
  (let* ((title (or (outline-keyword-val ol "TITLE") "Untitled"))
         (date (outline-keyword-val ol "DATE"))
         (draft (outline-keyword-val ol "HUGO_DRAFT"))
         (draft-lc (and draft (string-downcase (string-trim draft))))
         (tags (org-outline-filetags ol))
         (fm (string-append
              "---\n"
              "title: " (yaml-quote title) "\n"
              (if date
                  (string-append "date: " (if (valid-yaml-date? date) date (yaml-quote date)) "\n")
                  "")
              (if (pair? tags)
                  (string-append "tags: [" (string-join (map yaml-quote tags) ", ") "]\n")
                  "")
              (if (and draft-lc (or (string=? draft-lc "true") (string=? draft-lc "false")))
                  (string-append "draft: " draft-lc "\n")
                  "")
              "---\n\n"))
         ;; Strip top-level # title since Hugo renders front matter title.
         (md (org->markdown text ol))
         (body (if (string-prefix? "# " md)
                   (let ((nl (string-index md #\newline)))
                     (if nl (string-trim (substring md (+ nl 1))) md))
                   md)))
    (string-append fm body "\n")))

(define (org->html text ol)
  "Export Org TEXT and outline OL to a standalone HTML document."
  (let* ((hs (org-outline-headings ol))
         (n (vector-length hs))
         (title (or (outline-keyword-val ol "TITLE") "Org Export"))
         (first-h (if (> n 0) (org-heading-start (vector-ref hs 0)) (org-utf8-length text)))
         (pre (if (> first-h 0) (export-elements-html text (org-parse-section text 0 first-h)) "")))
    (let loop ((i 0) (acc (list pre (string-append "<h1>" (html-escape title) "</h1>\n"))))
      (if (>= i n)
          (string-append "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>"
                         (html-escape title) "</title></head><body>\n"
                         (apply string-append (reverse acc))
                         "</body></html>\n")
          (let* ((h (vector-ref hs i))
                 (lvl (min 6 (+ (org-heading-level h) 1)))
                 (tag (string-append "h" (number->string lvl)))
                 (tr (org-heading-title-range h))
                 (hdr (string-append "<" tag ">" (render-inlines-html text (car tr) (cdr tr)) "</" tag ">\n"))
                 (bs (org-heading-body-start h))
                 (se (org-heading-section-end ol h))
                 (body (if (< bs se) (export-elements-html text (org-parse-section text bs se)) "")))
            (loop (+ i 1) (cons body (cons hdr acc))))))))
