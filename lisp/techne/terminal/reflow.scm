;;; Rewrap saved main-screen lines. Keep the live and alternate grids
;;; intact for applications that repaint them after SIGWINCH.
(define (rewrap-line! t cols text prompt)
  (let loop ((xs text) (row (make-vector cols #f)) (n 0) (prompt prompt))
    (define (save! more)
      (keep-row! t (make-row cols row #f 'single #f prompt (and more n))))
    (if (null? xs) (save! #f)
        (let* ((wide (and (pair? (cdr xs)) (eq? (cadr xs) 'tail))) (w (if wide 2 1)))
          (cond ((or (= n cols) (and (> n 0) (> (+ n w) cols)))
                 (save! #t) (loop xs (make-vector cols #f) 0 #f))
                ((and wide (= cols 1)) (vector-set! row n (cons "�" (cdr (car xs))))
                 (loop (cddr xs) row (+ n 1) prompt))
                (else (vector-set! row n (car xs))
                      (when wide (vector-set! row (+ n 1) 'tail))
                      (loop (if wide (cddr xs) (cdr xs)) row (+ n w) prompt)))))))

(define (reflow-scrollback! t cols)
  (let* ((start (first t)) (end (next t)) (ring (history t)) (size (vector-length ring))
         (rows (map (lambda (i) (vector-ref ring (modulo i size))) (iota (- end start) start))))
    (unless (null? rows)
      (clear-history! t)
      (let loop ((rest rows) (text '()) (prompt #f))
        (unless (null? rest)
          (let ((row (car rest)))
            (if (terminal-row-double-width? row)
                (begin (keep-row! t row) (loop (cdr rest) '() #f))
                (let* ((v (terminal-row-cells row)) (wrap (continuation row))
                       (n (or wrap (let trim ((n (vector-length v)))
                                     (if (and (> n 0) (not (vector-ref v (- n 1)))) (trim (- n 1)) n))))
                       (prompt (or prompt (terminal-row-prompt? row))))
                  (do ((i 0 (+ i 1))) ((= i n)) (set! text (cons (vector-ref v i) text)))
                  (if (and wrap (pair? (cdr rest)) (not (terminal-row-prompt? (cadr rest)))
                           (not (terminal-row-double-width? (cadr rest))))
                      (loop (cdr rest) text prompt)
                      (begin (rewrap-line! t cols (reverse text) prompt)
                             (loop (cdr rest) '() #f)))))))))))
