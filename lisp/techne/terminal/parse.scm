;;; VT stream decoder. State and bounded headers survive arbitrary PTY
;;; chunk boundaries. String protocols never act on the clipboard or files.

(define esc (string #\x1b))
(define csi (string-append esc "["))
(define (respond t . parts) ((reply t) (apply string-append parts)))

(define (tab! t n delta)
  (let* ((s (active t)) (right (margin-right t (sy s)))
         (limit (if (and (> delta 0) (<= (sx s) right)) right (line-right t (sy s)))))
    (let loop ((x (+ (sx s) delta)) (n n))
      (cond ((or (<= x 0) (>= x limit)) (sx-set! s (clip 0 x limit)))
            ((not (vector-ref (tabs t) x)) (loop (+ x delta) n))
            ((<= n 1) (sx-set! s x))
            (else (loop (+ x delta) (- n 1)))))
    (wrap-set! s #f)))

(define (control! t c)
  (case c
    ((#\x08) (backward! t 1))
    ((#\x09) (tab! t 1 1))
    ((#\x0a #\x0b #\x0c) (if (terminal-mode? t 'newline) (next-line! t) (index! t 1)))
    ((#\x0d) (carriage-return! t))
    ((#\x0e) (shifted-set! t #t))
    ((#\x0f) (shifted-set! t #f))))

(define (dec-graphic t c)
  (if (and (if (shifted? t) (g1 t) (g0 t)) (char<=? #\_ c #\~))
      (string-ref " ◆▒␉␌␍␊°±␤␋┘┐┌└┼⎺⎻─⎼⎽├┤┴┬│≤≥π≠£·" (- (char->integer c) 95)) c))

(define (erase-line! t kind protection)
  (let ((x (terminal-x t)) (y (terminal-y t)) (cols (terminal-columns t)))
    (case kind
      ((0) (erase! t y x cols #:initialized #t #:protection protection))
      ((1) (erase! t y 0 (+ x 1) #:initialized #t #:protection protection))
      ((2) (erase! t y 0 cols #:initialized #t #:protection protection)))))

(define (erase-display! t kind protection)
  (let ((y (terminal-y t)) (cols (terminal-columns t)) (rows (terminal-rows t)))
    (define (whole from to initialized)
      (do ((i from (+ i 1))) ((>= i to))
        (erase! t i 0 cols #:initialized initialized #:protection protection)))
    (case kind
      ((0) (erase-line! t 0 protection) (whole (+ y 1) rows #t))
      ((1) (whole 0 y #t) (erase-line! t 1 protection))
      ((2) (whole 0 rows (if (screen-has-protection? t protection) 'preserve #f)))
      ((3) (unless (terminal-alternate? t) (clear-history! t))))))

(define (dec-mode! t private n on)
  (let ((table (if private (dec-modes t) (ansi-modes t))))
    (when (memv n (if private '(4 5 18 19 35 42 66 67 2026) '(2 4 12 20)))
      (hash-table-set! table n on)))
  (if private
      (case n
        ((1) (mode-set! t 'application-cursor on))
        ((3) (column-mode! t on))
        ((6) (mode-set! t 'origin on) (address t 0 0))
        ((7) (mode-set! t 'wrap on) (unless on (wrap-set! (active t) #f)))
        ((25) (mode-set! t 'cursor on))
        ((45) (mode-set! t 'reverse-wrap on))
        ((69) (mode-set! t 'horizontal-margins on)
              (let ((s (active t))) (left-set! s 0) (right-set! s (- (terminal-columns t) 1))))
        ((1045) (mode-set! t 'reverse-extended on))
        ((47 1047 1049) (alternate! t n on))
        ((66) (mode-set! t 'application-keypad on))
        ((1048) (if on (save-cursor! t) (restore-cursor! t)))
        ((2004) (mode-set! t 'bracketed-paste on)))
      (case n ((4) (mode-set! t 'insert on)) ((20) (mode-set! t 'newline on)))))

(define (decimal str)
  (let ((n (string-length str)))
    (and (> n 0)
         (let loop ((i 0) (value 0))
           (if (= i n) value
               (let ((d (- (char->integer (string-ref str i)) 48)))
                 (and (<= 0 d 9) (loop (+ i 1) (min 65535 (+ (* value 10) d))))))))))

(define (color-byte? n) (and n (<= 0 n 255)))
(define (color! t n kind args)
  (let ((key (if (= n 38) 'fg 'bg)))
    (case kind
      ((5) (when (and (pair? args) (color-byte? (car args))) (put-style! t key (car args))))
      ((2) (when (and (= (length args) 3) (every color-byte? args)) (put-style! t key args))))))

(define (sgr! t params)
  (let loop ((p params))
    (unless (null? p)
      (let ((n (car p)) (rest (cdr p)))
        (cond
          ((pair? n)
           (let ((code (car n)) (args (cdr n)))
             (cond ((and (memv code '(38 48)) (pair? args))
                    (let ((values (cdr args)))
                      (color! t code (car args) (if (and (eqv? (car args) 2) (= (length values) 4)) (cdr values) values))))
                   ((eqv? code 4) (put-style! t 'underline (not (equal? args '(0)))))))
           (loop rest))
          ((memv n '(38 48 58))
           (when (pair? rest)
             (let* ((kind (car rest)) (count (case kind ((2) 3) ((5) 1) (else 0)))
                    (args (cdr rest)))
               (when (>= (length args) count)
                 (when (not (= n 58)) (color! t n kind (take args count)))
                 (loop (drop args count))))))
          (else
           (case (or n 0)
             ((0) (style-set! t '())) ((1) (put-style! t 'weight 'bold)) ((2) (put-style! t 'weight 'light))
             ((3) (put-style! t 'slant 'italic)) ((4 21) (put-style! t 'underline #t))
             ((7) (put-style! t 'inverse #t)) ((8) (put-style! t 'conceal #t)) ((9) (put-style! t 'strike #t))
             ((22) (put-style! t 'weight #f)) ((23) (put-style! t 'slant #f)) ((24) (put-style! t 'underline #f))
             ((27) (put-style! t 'inverse #f)) ((28) (put-style! t 'conceal #f)) ((29) (put-style! t 'strike #f))
             ((39) (put-style! t 'fg #f)) ((49) (put-style! t 'bg #f))
             (else (cond ((<= 30 n 37) (put-style! t 'fg (- n 30)))
                         ((<= 40 n 47) (put-style! t 'bg (- n 40)))
                         ((<= 90 n 97) (put-style! t 'fg (- n 82)))
                         ((<= 100 n 107) (put-style! t 'bg (- n 92))))))
           (loop rest)))))))

(define (dispatch-csi! t header final)
  (let* ((len (string-length header)) (first (and (> len 0) (string-ref header 0)))
         (prefix (and first (memv first '(#\? #\> #\= #\<)) first))
         (start (if prefix 1 0))
         (end (let loop ((i start))
                (if (and (< i len) (>= (char->integer (string-ref header i)) 48)) (loop (+ i 1)) i)))
         (body (substring header start end)) (marker (substring header end))
         (valid (and (every (lambda (c) (or (char<=? #\0 c #\9) (memv c '(#\; #\:)))) (string->list body))
                     (every (lambda (c) (<= 32 (char->integer c) 47)) (string->list marker)))))
    (when valid
      (let* ((p (map (lambda (s) (if (string-index s #\:) (map decimal (string-split s ":")) (decimal s)))
                     (string-split body ";")))
             (raw (lambda (i) (let ((n (and (< i (length p)) (list-ref p i)))) (if (number? n) n 0))))
             (a (raw 0)) (n (max 1 a)) (m (max 1 (raw 1))) (s (active t))
             (x (sx s)) (y (sy s)) (cols (terminal-columns t)) (rows (terminal-rows t)))
        (cond
          ((not (string=? marker "")) (dispatch-intermediate! t marker prefix final raw))
          ((and (memv final '(#\h #\l)) (or (not prefix) (eqv? prefix #\?)))
           (for-each (lambda (k) (dec-mode! t prefix k (char=? final #\h))) (filter number? p)))
          ((and (char=? final #\c) (= a 0))
           (cond ((not prefix) (respond t csi "?1;2c"))
                 ((eqv? prefix #\>) (respond t csi ">0;0;0c"))))
          ((and (char=? final #\n) (or (not prefix) (eqv? prefix #\?)))
           (case a
             ((5) (unless prefix (respond t csi "0n")))
             ((6) (respond t csi (if prefix "?" "")
                           (number->string (+ 1 (- y (if (terminal-mode? t 'origin) (top s) 0))))
                           ";" (number->string (+ 1 (- x (if (terminal-mode? t 'origin) (margin-left t) 0)))) "R"))))
          ((eqv? prefix #\?)
           (case final ((#\J) (erase-display! t a 'both)) ((#\K) (erase-line! t a 'both))))
          ((not prefix)
           (case final
             ((#\A) (relative t 0 (- n))) ((#\B #\e) (relative t 0 n))
             ((#\C #\a) (relative t n 0)) ((#\D #\j) (backward! t n))
             ((#\E) (carriage-return! t) (relative t 0 n)) ((#\F) (carriage-return! t) (relative t 0 (- n)))
             ((#\G #\`) (address t (- n 1) (- y (if (terminal-mode? t 'origin) (top s) 0))))
             ((#\d) (address t (- x (if (terminal-mode? t 'origin) (margin-left t) 0)) (- n 1)))
             ((#\H #\f) (address t (- m 1) (- n 1)))
             ((#\I) (tab! t n 1)) ((#\Z) (tab! t n -1))
             ((#\g) (case a ((0) (vector-set! (tabs t) x #f)) ((3) (vector-fill! (tabs t) #f))))
             ((#\J) (erase-display! t a 'iso))
             ((#\K) (erase-line! t a 'iso))
             ((#\X) (erase! t y x (min cols (+ x n)) #:initialized #t #:protection 'iso))
             ((#\@) (wrap-set! s #f) (shift-cells! t n)) ((#\P) (wrap-set! s #f) (shift-cells! t (- n)))
             ((#\L #\M) (wrap-set! s #f)
              (when (and (inside-horizontal? t) (<= (top s) y (bottom s)))
                (scroll! t y (bottom s) (if (char=? final #\L) (- n) n) #f)))
             ((#\S #\T) (scroll! t (top s) (bottom s) (if (char=? final #\S) n (- n)) #f))
             ((#\r) (let ((lo (- n 1)) (hi (- (if (= (raw 1) 0) rows (min rows m)) 1)))
                      (when (< lo hi) (top-set! s lo) (bottom-set! s hi) (address t 0 0))))
             ((#\m) (sgr! t (if (null? p) '(0) p)))
             ((#\s) (if (terminal-mode? t 'horizontal-margins)
                         (let ((l (- n 1)) (r (- (if (zero? (raw 1)) cols (min m cols)) 1)))
                           (when (< l r) (left-set! s l) (right-set! s r) (address t 0 0)))
                         (when (string=? body "") (save-cursor! t))))
             ((#\u) (when (string=? body "") (restore-cursor! t)))
             ((#\t) (cond ((= a 8) (child-resize! t (if (zero? (raw 1)) rows m) (if (zero? (raw 2)) cols (raw 2)))
                                    (page-length-set! t (terminal-rows t)))
                           ((or (= a 18) (= a 19)) (respond t csi (if (= a 18) "8;" "9;") (number->string rows) ";" (number->string cols) "t"))
                           ((>= a 24) (page-length-set! t a)))))))))))

(define (finish-osc! t)
  (let* ((s (header t)) (i (string-index s #\;)))
    (when (and i (member (substring s 0 i) '("0" "2"))) (title-set! t (substring s (+ i 1)))))
  (header-set! t ""))

(define (parse-char! t c)
  (let ((state (parser-state t)) (n (char->integer c)))
    (cond
      ((memv n '(24 26)) (parser-state-set! t 'ground) (header-set! t ""))
      ((memq state '(osc dcs string osc-escape dcs-escape string-escape))
       (cond ((or (= n #x9c) (and (eq? state 'osc) (= n 7))
                  (and (memq state '(osc-escape dcs-escape string-escape)) (char=? c #\\)))
              (let ((h (header t)))
                (parser-state-set! t 'ground)
                (cond ((memq state '(osc osc-escape)) (finish-osc! t))
                      (else (header-set! t "")
                            (when (and (memq state '(dcs dcs-escape)) (string-prefix? "$q" h))
                              (setting-report t (substring h 2)))))))
             ((memq state '(osc-escape dcs-escape string-escape))
              (header-set! t "") (parser-state-set! t 'escape) (parse-char! t c))
             ((= n 27) (parser-state-set! t (case state ((osc) 'osc-escape) ((dcs) 'dcs-escape) (else 'string-escape))))
             ((and (memq state '(osc dcs)) (>= n 32) (not (<= 127 n 159)))
              (if (< (string-length (header t)) 1024) (header-set! t (string-append (header t) (string c)))
                  (begin (header-set! t "") (parser-state-set! t (if (eq? state 'osc) 'osc-drop 'string)))))))
      ((memq state '(osc-drop osc-drop-escape))
       (cond ((or (= n #x9c) (= n 7) (and (eq? state 'osc-drop-escape) (char=? c #\\)))
              (parser-state-set! t 'ground))
             ((eq? state 'osc-drop-escape) (parser-state-set! t 'escape) (parse-char! t c))
             ((= n 27) (parser-state-set! t 'osc-drop-escape))))
      ((= n 27) (header-set! t "") (parser-state-set! t 'escape))
      ((< n 32) (control! t c))
      ((= n 127) #f)
      ((<= #x80 n #x9f)
       (case n
         ((#x84) (index! t 1)) ((#x85) (next-line! t)) ((#x8d) (index! t -1))
         ((#x96) (mode-set! t 'iso-protect #t)) ((#x97) (mode-set! t 'iso-protect #f))
         ((#x9b #x9d #x90 #x98 #x9e #x9f)
          (header-set! t "") (parser-state-set! t (case n ((#x9b) 'csi) ((#x9d) 'osc) ((#x90) 'dcs) (else 'string))))))
      ((eq? state 'ground) (graphic! t (dec-graphic t c)))
      ((eq? state 'escape)
       (parser-state-set! t 'ground)
       (case c
         ((#\[) (parser-state-set! t 'csi)) ((#\]) (parser-state-set! t 'osc))
         ((#\P) (parser-state-set! t 'dcs)) ((#\X #\^ #\_) (parser-state-set! t 'string))
         ((#\#) (parser-state-set! t 'hash-escape))
         ((#\() (parser-state-set! t 'g0)) ((#\)) (parser-state-set! t 'g1))
         ((#\7) (save-cursor! t)) ((#\8) (restore-cursor! t))
         ((#\D) (index! t 1)) ((#\E) (next-line! t)) ((#\M) (index! t -1))
         ((#\V) (mode-set! t 'iso-protect #t)) ((#\W) (mode-set! t 'iso-protect #f))
         ((#\H) (vector-set! (tabs t) (terminal-x t) #t))
         ((#\=) (mode-set! t 'application-keypad #t)) ((#\>) (mode-set! t 'application-keypad #f))
         ((#\c) (terminal-reset! t))
         (else (when (<= 32 n 47) (parser-state-set! t 'escape-intermediate)))))
      ((memq state '(csi csi-drop))
       (cond ((<= 64 n 126) (parser-state-set! t 'ground)
              (let ((h (header t)))
                (header-set! t "")
                (when (eq? state 'csi) (dispatch-csi! t h c))))
             ((and (eq? state 'csi) (<= 32 n 63) (< (string-length (header t)) 128))
              (header-set! t (string-append (header t) (string c))))
             (else (parser-state-set! t 'csi-drop))))
      ((not (<= 32 n 47))
       (parser-state-set! t 'ground)
       (case state
         ((g0) (g0-set! t (char=? c #\0))) ((g1) (g1-set! t (char=? c #\0)))
         ((hash-escape)
          (case c
            ((#\3) (row-rendition! t 'double-top)) ((#\4) (row-rendition! t 'double-bottom))
            ((#\5) (row-rendition! t 'single)) ((#\6) (row-rendition! t 'double))
            ((#\8) (alignment-test! t)))))))))

(define (terminal-feed! t text #:start [start 0] #:end [end (string-length text)])
  "Feed TEXT from character START up to END into terminal T.
Incomplete control sequences resume at the next call."
  (do ((i start (+ i 1))) ((>= i end)) (parse-char! t (string-ref text i))))
