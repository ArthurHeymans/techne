;;; VT editing and reporting beyond the ordinary xterm text controls.

(define (line-right t y)
  (- (if (terminal-row-double-width? (terminal-row t y))
         (max 1 (quotient (terminal-columns t) 2)) (terminal-columns t)) 1))
(define (margin-left t)
  (if (terminal-mode? t 'horizontal-margins) (left (active t)) 0))
(define (margin-right t y)
  (let ((edge (line-right t y)))
    (if (terminal-mode? t 'horizontal-margins) (min edge (right (active t))) edge)))
(define (inside-horizontal? t)
  (<= (margin-left t) (terminal-x t) (margin-right t (terminal-y t))))
(define (print-right t)
  (if (inside-horizontal? t) (margin-right t (terminal-y t)) (line-right t (terminal-y t))))

(define (carriage-return! t)
  (let ((s (active t)) (left (margin-left t)))
    (sx-set! s (min (line-right t (sy s)) (if (or (>= (sx s) left) (terminal-mode? t 'origin)) left 0)))
    (wrap-set! s #f)))
(define (next-line! t)
  (index! t 1) (carriage-return! t)
  (barrier-set! (terminal-row t (terminal-y t)) #t))

(define (backward! t count)
  (let* ((s (active t)) (extended (terminal-mode? t 'reverse-extended))
         (reverse (or extended (terminal-mode? t 'reverse-wrap)))
         (n (if (and reverse (wrap? s)) (- count 1) count)))
    (wrap-set! s #f)
    (let loop ((n n))
      (when (> n 0)
        (let* ((x (sx s)) (y (sy s)) (left (if (inside-horizontal? t) (margin-left t) 0))
               (step (min n (- x left))))
          (cond ((> step 0) (sx-set! s (- x step)) (loop (- n step)))
                ((and reverse (terminal-mode? t 'wrap) (not (barrier? (terminal-row t y))))
                 (let ((target (cond ((= y (top s)) (bottom s)) ((> y 0) (- y 1))
                                     (extended (- (terminal-rows t) 1)) (else #f))))
                   (when target
                     (sy-set! s target) (sx-set! s (margin-right t target)) (loop (- n 1)))))))))))

(define (row-rendition! t kind)
  (let* ((y (terminal-y t)) (r (terminal-row t y)) (s (active t)))
    (rendition-set! r kind)
    (terminal-row-cache-set! r #f)
    (let ((edge (line-right t y)))
      (when (not (eq? kind 'single)) (erase! t y (+ edge 1) (terminal-columns t)))
      (sx-set! s (min (sx s) edge)) (wrap-set! s #f))))

(define (sever-wide! cells at)
  (when (and (> at 0) (< at (vector-length cells)) (eq? (vector-ref cells at) 'tail))
    (vector-set! cells (- at 1) #f) (vector-set! cells at #f)))

(define (graphic-cell t c)
  (let* ((attrs (style t))
         (attrs (if (terminal-mode? t 'iso-protect) (cons '(iso-protect . #t) attrs) attrs))
         (attrs (if (terminal-mode? t 'dec-protect) (cons '(dec-protect . #t) attrs) attrs)))
    (cons (string c) attrs)))

(define (scroll-rectangle! t lo hi amount)
  (let* ((left (margin-left t)) (end (+ 1 (right (active t))))
         (n (min (abs amount) (+ 1 (- hi lo)))) (dir (if (> amount 0) 1 -1))
         (cells (lambda (y) (terminal-row-cells (terminal-row t y))))
         (fill (blank t)))
    (do ((y lo (+ y 1))) ((> y hi))
      (sever-wide! (cells y) left) (sever-wide! (cells y) end))
    (do ((y (if (> dir 0) lo hi) (+ y dir))) ((not (<= lo y hi)))
      (let ((src (+ y (* dir n))) (v (cells y)))
        (if (<= lo src hi) (vector-copy! v left (cells src) left end)
            (vector-fill! v fill left end))
        (terminal-row-cache-set! (terminal-row t y) #f)))))

(define (rect-coordinates t raw offset)
  (let* ((origin (terminal-mode? t 'origin))
         (y0 (if origin (top (active t)) 0)) (x0 (if origin (margin-left t) 0))
         (rows (terminal-rows t)) (cols (terminal-columns t))
         (coord (lambda (n default origin) (+ origin (- (let ((v (raw (+ n offset)))) (if (zero? v) default v)) 1))))
         (a (coord 0 1 y0)) (b (coord 1 1 x0)) (c (coord 2 rows y0)) (d (coord 3 cols x0)))
    (and (<= a c) (<= b d) (< a rows) (< b cols) (list a b (min c (- rows 1)) (min d (- cols 1))))))

(define (fill-rect! t cell a b c d)
  (do ((y a (+ y 1))) ((> y c))
    (let* ((r (terminal-row t y)) (v (terminal-row-cells r)))
      (sever-wide! v b) (sever-wide! v (+ d 1))
      (vector-fill! v cell b (+ d 1))
      (terminal-row-cache-set! r #f))))

(define (copy-rect! t dst-y dst-x a b c d)
  (let ((rows (min (+ 1 (- c a)) (- (terminal-rows t) dst-y)))
        (cols (min (+ 1 (- d b)) (- (terminal-columns t) dst-x))))
    (when (and (> rows 0) (> cols 0))
      ;; Snapshot first, including for overlapping source and destination.
      (let ((snapshot (make-vector rows)))
        (do ((i 0 (+ i 1))) ((= i rows))
          (let* ((v (terminal-row-cells (terminal-row t (+ i a)))) (end (+ b cols))
                 (cut (vector-copy v b end)))
            (when (eq? (vector-ref cut 0) 'tail) (vector-set! cut 0 #f))
            (when (and (< end (vector-length v)) (eq? (vector-ref v end) 'tail))
              (vector-set! cut (- cols 1) #f))
            (vector-set! snapshot i cut)))
        (do ((i 0 (+ i 1))) ((= i rows))
          (let* ((r (terminal-row t (+ dst-y i))) (v (terminal-row-cells r)))
            (sever-wide! v dst-x) (sever-wide! v (+ dst-x cols))
            (vector-copy! v dst-x (vector-ref snapshot i))
            (terminal-row-cache-set! r #f)))))))

(define (rect-checksum t rect)
  (let ((sum 0))
    (when rect
      (apply (lambda (a b c d)
               (do ((y a (+ y 1))) ((> y c))
                 (let ((v (terminal-row-cells (terminal-row t y))))
                   (do ((x b (+ x 1))) ((> x d))
                     (let ((cell (vector-ref v x)))
                       (when (pair? cell) (set! sum (+ sum (char->integer (string-ref (car cell) 0)))))))))) rect))
    (let ((hex (string-upcase (number->string (- #x10000 (modulo sum #x10000)) 16))))
      (string-append (make-string (max 0 (- 4 (string-length hex))) #\0) hex))))

(define (soft-reset! t)
  (let ((s (active t)))
    (modes-set! t (if (terminal-mode? t 'wide-columns) '(wrap cursor wide-columns) '(wrap cursor)))
    (style-set! t '()) (g0-set! t #f) (g1-set! t #f) (shifted-set! t #f)
    (top-set! s 0) (bottom-set! s (- (terminal-rows t) 1))
    (left-set! s 0) (right-set! s (- (terminal-columns t) 1))
    (wrap-set! s #f) (saved-set! s #f)
    (for-each (lambda (table) (for-each (lambda (k) (hash-table-delete! table k)) (hash-table-keys table)))
              (list (ansi-modes t) (dec-modes t)))))

(define (child-resize! t rows cols)
  (let ((rows (clip 1 rows 256)) (cols (clip 1 cols 512)))
    (unless (and (= rows (terminal-rows t)) (= cols (terminal-columns t)))
      (terminal-resize! t rows cols)
      ((resize-request t) rows cols))))

(define (column-mode! t on)
  (child-resize! t (terminal-rows t) (if on 132 80))
  (mode-set! t 'wide-columns on)
  (let* ((s (active t)) (rows (terminal-rows t)) (cols (terminal-columns t)))
    (top-set! s 0) (bottom-set! s (- rows 1)) (left-set! s 0) (right-set! s (- cols 1))
    (move t 0 0 0 (- rows 1)) (tabs-set! t (default-tabs cols))
    (do ((i 0 (+ i 1))) ((= i rows)) (vector-set! (lines s) i (fresh-row cols (blank t))))))

(define (alignment-test! t)
  (let ((s (active t)) (rows (terminal-rows t)) (cols (terminal-columns t)))
    (top-set! s 0) (bottom-set! s (- rows 1)) (left-set! s 0) (right-set! s (- cols 1))
    (move t 0 0 0 (- rows 1))
    (do ((i 0 (+ i 1))) ((= i rows)) (vector-set! (lines s) i (fresh-row cols (cons "E" '()))))))

(define (mode-report t private n)
  (define (flag value) (if value 1 2))
  (define (enabled flag-name) (flag (terminal-mode? t flag-name)))
  (when (>= (level t) 63)
    (let ((status
           (if private
               (case n
                 ((8 60) 4) ((1) (enabled 'application-cursor)) ((3) (enabled 'wide-columns))
                 ((6) (enabled 'origin)) ((7) (enabled 'wrap)) ((25) (enabled 'cursor))
                 ((45) (enabled 'reverse-wrap)) ((69) (enabled 'horizontal-margins))
                 ((1045) (enabled 'reverse-extended)) ((2004) (enabled 'bracketed-paste))
                 ((4 5 18 19 35 42 66 67 2026) (flag (hash-table-ref/default (dec-modes t) n #f)))
                 (else 0))
               (case n
                 ((2 4 12 20) (flag (hash-table-ref/default (ansi-modes t) n #f)))
                 ((1 5 7 10 11 13 14 15 16 17 18 19) 4)
                 (else 0)))))
      (respond t csi (if private "?" "") (number->string n) ";" (number->string status) "$y"))))

(define (rendition-status t)
  (define (field k) (let ((p (assq k (style t)))) (and p (cdr p))))
  (define (color k base ext)
    (let ((c (field k)))
      (cond ((not c) '()) ((pair? c) (cons ext (cons 2 c)))
            ((< c 8) (list (+ base c))) ((< c 16) (list (+ base 60 (- c 8))))
            (else (list ext 5 c)))))
  (string-join
   (append '("0")
           (filter-map (lambda (p) (and (field (car p)) (cdr p)))
                       `((weight . ,(if (eq? (field 'weight) 'bold) "1" "2"))
                         (slant . "3") (underline . "4:1") (inverse . "7") (conceal . "8") (strike . "9")))
           (map number->string (append (color 'fg 30 38) (color 'bg 40 48)))) ";"))

(define (setting-report t request)
  (let* ((s (active t)) (lines (or (page-length t) (terminal-rows t)))
         (value
          (cond ((member request '("$}" "*x" "$~")) (string-append "0" request))
                ((string=? request "\"q") (if (terminal-mode? t 'dec-protect) "1\"q" "0\"q"))
                ((string=? request "\"p") (string-append (number->string (level t)) ";1\"p"))
                ((string=? request "r") (string-append (number->string (+ 1 (top s))) ";" (number->string (+ 1 (bottom s))) "r"))
                ((string=? request "s") (string-append (number->string (+ 1 (margin-left t))) ";"
                                                        (number->string (+ 1 (margin-right t (sy s)))) "s"))
                ((string=? request "m") (string-append (rendition-status t) "m"))
                ((string=? request " q") (string-append (number->string (cursor-style t)) " q"))
                ((member request '("t" "*|")) (string-append (number->string lines) request))
                (else #f))))
    (respond t esc "P" (if value "1$r" "0$r") (or value "") esc "\\")))

(define (dispatch-intermediate! t marker prefix final raw)
  (let ((a (raw 0)))
    (cond
      ((and (string=? marker "$") (char=? final #\p) (or (not prefix) (eqv? prefix #\?))) (mode-report t prefix a))
      (prefix #f)
      ((and (string=? marker "!") (char=? final #\p)) (soft-reset! t))
      ((and (string=? marker "\"") (char=? final #\p)) (terminal-reset! t) (level-set! t (if (= a 0) 65 a)))
      ((and (string=? marker "\"") (char=? final #\q)) (mode-set! t 'dec-protect (= a 1)))
      ((and (string=? marker " ") (char=? final #\q)) (cursor-style-set! t (if (= a 0) 1 (if (<= a 6) a 2))))
      ((and (string=? marker "*") (char=? final #\|)) (page-length-set! t (if (= a 0) (terminal-rows t) a)))
      ((and (string=? marker "*") (char=? final #\y))
       (respond t esc "P" (number->string a) "!~" (rect-checksum t (rect-coordinates t raw 2)) esc "\\"))
      ((string=? marker "$")
       (case final
         ((#\z #\{)
          (let ((rect (rect-coordinates t raw 0)))
            (when rect
              (apply (lambda (a b c d)
                       (do ((y a (+ y 1))) ((> y c))
                         (erase! t y b (+ d 1) #:initialized #t #:protection (and (char=? final #\{) 'dec)))) rect))))
         ((#\x)
          (when (or (<= 32 a 126) (<= 160 a 255))
            (let ((rect (rect-coordinates t raw 1)))
              (when rect (apply fill-rect! t (graphic-cell t (integer->char a)) rect)))))
         ((#\v)
          (let ((rect (rect-coordinates t raw 0)) (origin (terminal-mode? t 'origin)))
            (when (and rect (<= 0 (raw 4) 1) (<= 0 (raw 7) 1))
              (apply copy-rect! t (+ (- (max 1 (raw 5)) 1) (if origin (top (active t)) 0))
                     (+ (- (max 1 (raw 6)) 1) (if origin (margin-left t) 0)) rect)))))))))
