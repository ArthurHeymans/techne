;;; Repository query policy. Only bounded filesystem and parser mechanisms
;;; cross into Rust; snapshots, paging, search and edits are ordinary Lisp.
(define-record-type tool-project-state
  (%project root namespace listing cache) tool-project?
  (root %project-root) (namespace %namespace)
  (listing %listing %listing-set!) (cache %cache %cache-set!))
(define-record-type source-snapshot
  (%snapshot id path revision source bytes) %snapshot?
  (id %id) (path %path) (revision %revision) (source %source) (bytes %bytes))
(define %file-limit (* 1024 1024))
(define %cache-limit (* 16 %file-limit))
(define (%tool-open root) (%project (%repository-canonical-root root) (%repository-nonce) #f '()))
(define (%tool-root p) (string-copy (%project-root p)))
;; Replies own their mutable strings and pairs: callers must not be able
;; to change a cached filename, revision or snapshot by editing a reply.
(define (%response value)
  (cond ((string? value) (string-copy value))
        ((pair? value) (cons (%response (car value)) (%response (cdr value))))
        (else value)))
(define (%keep! p s)
  (let trim ((cache (cons s (remove (lambda (old) (string=? (%id old) (%id s))) (%cache p)))))
    (if (or (> (length cache) 128) (> (apply + (map %bytes cache)) %cache-limit))
        (trim (take cache (- (length cache) 1)))
        (%cache-set! p cache)))
  s)
(define (%peek p data)
  ;; The cached snapshot of DATA, or a new one not yet kept.
  (let ((path (tool-ref data 'path)) (revision (tool-ref data 'revision)))
    (or (find (lambda (s) (and (string=? (%path s) path) (string=? (%revision s) revision))) (%cache p))
        (%snapshot (%repository-nonce) path revision (tool-ref data 'text) (tool-ref data 'bytes)))))
(define (%remember! p data) (%keep! p (%peek p data)))
(define (%read-data p path) (%repository-read (%project-root p) path %file-limit))
(define (%read-snapshot p path)
  (let ((data (%read-data p path)))
    (unless (tool-ref data 'text) (error "tool: not UTF-8 text" path))
    (%remember! p data)))
(define (%files p)
  (or (%listing p) (let ((listed (%repository-list (%project-root p) 10000))) (%listing-set! p listed) listed)))
(define (%tool-files p prefix limit offset)
  (%count limit 50 "tool-files") (%offset offset)
  (let* ((listed (%files p))
         (files (filter (lambda (path) (string-prefix? prefix path)) (tool-ref listed 'items))))
    (append (%page files limit offset #:complete (tool-ref listed 'complete))
      (map (lambda (key) (list key (tool-ref listed key))) '(revision skipped problems)))))
(define (%handle p s start end)
  (string-join (list (%namespace p) (%id s) (number->string start) (number->string end)) ":"))
(define (%line-starts source)
  (let ((size (string-length source)))
    (list->vector
      (let loop ((lines (string-split source "\n")) (at 0) (starts '()))
        (if (null? lines) (reverse starts)
            (loop (cdr lines) (+ at (string-length (car lines)) 1)
                  (if (or (= at 0) (< at size)) (cons at starts) starts)))))))
(define (%line-at starts at)
  (let loop ((lo 0) (hi (vector-length starts)))
    (if (= lo hi) lo
        (let ((mid (quotient (+ lo hi) 2)))
          (if (<= (vector-ref starts mid) at) (loop (+ mid 1) hi) (loop lo mid))))))
(define (%tool-expand p handle offset chars)
  (%offset offset) (%count chars 16000 "tool-expand")
  (let* ((found (%snapshot-at p handle "tool-expand")) (s (car found)) (a (cadr found)) (b (caddr found)))
      (let* ((size (- b a)) (end (min size (+ offset chars))))
        (when (> offset size)
          (error (string-append "tool-expand: offset " (number->string offset) " past end (body has " (number->string size) " characters)")))
        `((path ,(%path s)) (revision ,(%revision s)) (handle ,handle)
          (line ,(+ (%line-at (%line-starts (%source s)) (+ a offset))
                    (if (and (= (+ a offset) (string-length (%source s))) (string-suffix? "\n" (%source s))) 1 0)))
          (text ,(substring (%source s) (+ a offset) (+ a end))) (offset ,offset)
          (characters ,size) (truncated ,(< end size)) (next ,(and (< end size) end))))))
(define (%tool-read p path from lines chars)
  (%offset from) (when (= from 0) (error "tool-read: expected a positive line"))
  (%count lines 200 "tool-read") (%count chars 16000 "tool-read")
  (let* ((s (%read-snapshot p path)) (starts (%line-starts (%source s))) (n (vector-length starts)))
    (when (> from n) (error "tool-read: line past end"))
    (%tool-expand p (%handle p s (vector-ref starts (- from 1))
                      (if (< (+ from lines -1) n) (vector-ref starts (+ from lines -1)) (string-length (%source s)))) 0 chars)))
(define (%tool-refresh! p) (%listing-set! p #f) (%cache-set! p '()))
(define (%index source needle from)
  (let* ((suffix (if (= from 0) source (substring source from (string-length source))))
         (found (string-contains suffix needle)))
    (and found (+ from (string-cursor->index suffix found)))))
(define (%tool-search p query prefix limit offset)
  (%count limit 50 "tool-search") (%offset offset)
  (when (string=? query "") (error "tool-search: query must not be empty"))
  (let* ((listed (%files p)) (items '()) (selected '()) (selected-bytes 0) (page-full #f)
         (total 0) (scanned 0) (work 0) (binary 0)
         (skipped (tool-ref listed 'skipped)) (problems (tool-ref listed 'problems))
         (complete (tool-ref listed 'complete)))
    (let files ((paths (filter (lambda (path) (string-prefix? prefix path)) (tool-ref listed 'items))))
      (unless (null? paths)
        (let ((data (guard (e (#t (set! skipped (+ skipped 1))
                                (when (< (length problems) 3) (set! problems (append problems (list (%clip (condition/report-string e) 240))))) #f))
                      (%read-data p (car paths)))))
          (cond ((not data) (files (cdr paths)))
                ((> (+ work (tool-ref data 'bytes)) (* 64 %file-limit)) (set! complete #f))
                (else
                  (set! work (+ work (tool-ref data 'bytes)))
                  (if (not (tool-ref data 'text)) (set! binary (+ binary 1))
                    (let* ((s (%peek p data)) (source (%source s)) (size (string-length source)))
                      (set! scanned (+ scanned 1))
                      (let lines ((rest (string-split source "\n")) (at 0) (line 1))
                        (unless (or (null? rest) (>= at size))
                          (let* ((end (min size (+ at (string-length (car rest)) 1)))
                                 (body (if (> end (+ at (string-length (car rest)))) (string-append (car rest) "\n") (car rest)))
                                 (hit (%index body query 0)))
                            (when hit
                              (when (and (>= total offset) (< (length items) limit) (not page-full)
                                         (not (memq s selected)))
                                (if (> (+ selected-bytes (%bytes s)) %cache-limit) (set! page-full #t)
                                  (begin (set! selected (cons s selected)) (set! selected-bytes (+ selected-bytes (%bytes s))))))
                              (when (and (>= total offset) (< (length items) limit) (not page-full))
                                (let* ((before (max 0 (- hit 60))) (preview (%clip (substring body before (string-length body)) 240)))
                                  (set! items (cons `((path ,(%path s)) (revision ,(%revision s)) (line ,line)
                                    (text ,preview) (column ,(+ hit 1)) (preview-offset ,before)
                                    (preview-truncated ,(or (> before 0) (< (+ before (string-length preview)) (string-length body))))
                                    (handle ,(%handle p s at end))) items))))
                              (set! total (+ total 1)))
                            (lines (cdr rest) end (+ line 1)))))))
                  (files (cdr paths)))))))
    ;; Only the files this reply has handles into are kept, so a search
    ;; does not evict the handles of earlier replies.
    (for-each (lambda (s) (%keep! p s)) selected)
    (let ((next (+ offset (length items))) (complete (and complete (= skipped 0))))
      `((items ,(reverse items)) (total ,total) (complete ,complete)
        (truncated ,(or (< next total) (not complete))) (next ,(and (< next total) next))
        (scanned ,scanned) (binary ,binary) (skipped ,skipped) (problems ,problems)))))
(define (%utf8-size text) (bytevector-length (string->utf8 text)))
(define (%tool-edit! p path expected edits)
  (let* ((plan (%edit-plan p path expected edits "tool-edit!"))
         (s (car plan)) (changes (cadr plan)) (source (caddr plan)) (starts (%line-starts (%source s))))
      (let* ((revision (%repository-write (%project-root p) (%path s) expected source))
             (next (%remember! p `((path ,(%path s)) (revision ,revision) (text ,source) (bytes ,(%utf8-size source))))))
        `((path ,(%path s)) (revision ,revision) (previous ,expected)
          (changes ,(map (lambda (c) `((line ,(%line-at starts (car c))) (old ,(%clip (cadddr c) 240))
                        (new ,(%clip (caddr c) 240)) (truncated ,(or (> (string-length (cadddr c)) 240) (> (string-length (caddr c)) 240))))) changes))
          (handle ,(%handle p next 0 (string-length source)))))))
;;; One snapshot's region, named by a handle from any reply.
(define (%snapshot-at p handle who)
  (let ((parts (if (string? handle) (string-split handle ":") '()))
        (expired (string-append who ": expired or foreign handle; query again")))
    (unless (and (= (length parts) 4) (string=? (car parts) (%namespace p))) (error expired))
    (let* ((s (find (lambda (s) (string=? (%id s) (cadr parts))) (%cache p)))
           (a (string->number (caddr parts))) (b (string->number (cadddr parts))))
      (unless s (error expired))
      (unless (and (integer? a) (exact? a) (integer? b) (exact? b) (<= 0 a b (string-length (%source s))))
        (error (string-append who ": invalid range")))
      (list s a b))))
;;; Lines of one snapshot region containing QUERY: a file read, a search
;;; hit's line, or a process's kept output.
(define (%tool-find p handle query limit offset)
  (%count limit 50 "tool-find") (%offset offset)
  (when (string=? query "") (error "tool-find: query must not be empty"))
  (let* ((found (%snapshot-at p handle "tool-find"))
         (s (car found)) (a (cadr found)) (b (caddr found)) (size (- b a))
         (items '()) (total 0))
    (let lines ((rest (string-split (substring (%source s) a b) "\n")) (at 0)
                (line (%line-at (%line-starts (%source s)) a)))
      (unless (or (null? rest) (>= at size))
        (let* ((body (car rest)) (end (min size (+ at (string-length body) 1))) (hit (%index body query 0)))
          (when hit
            (when (and (>= total offset) (< (length items) limit))
              (let* ((before (max 0 (- hit 60))) (preview (%clip (substring body before (string-length body)) 240)))
                (set! items (cons `((path ,(%path s)) (line ,line) (text ,preview) (column ,(+ hit 1))
                                    (preview-offset ,before)
                                    (preview-truncated ,(or (> before 0) (< (+ before (string-length preview)) (string-length body))))
                                    (handle ,(%handle p s (+ a at) (+ a end))))
                                  items))))
            (set! total (+ total 1)))
          (lines (cdr rest) end (+ line 1)))))
    (let ((next (+ offset (length items))))
      `((items ,(reverse items)) (total ,total) (complete #t)
        (truncated ,(< next total)) (next ,(and (< next total) next))))))
;;; Every line of a snapshot region containing any of PATTERNS, in one
;;; pass: as `%tool-find`'s items, unpaged.
(define (%matching-lines p handle patterns)
  (let* ((found (%snapshot-at p handle "tool-check"))
         (s (car found)) (a (cadr found)) (b (caddr found)) (size (- b a)) (acc '()))
    (let lines ((rest (string-split (substring (%source s) a b) "\n")) (at 0)
                (line (%line-at (%line-starts (%source s)) a)))
      (unless (or (null? rest) (>= at size))
        (let* ((body (car rest)) (end (min size (+ at (string-length body) 1)))
               (hit (any (lambda (q) (%index body q 0)) patterns)))
          (when hit
            (let* ((before (max 0 (- hit 60))) (preview (%clip (substring body before (string-length body)) 240)))
              (set! acc (cons `((path ,(%path s)) (line ,line) (text ,preview) (column ,(+ hit 1))
                                (preview-offset ,before)
                                (preview-truncated ,(or (> before 0) (< (+ before (string-length preview)) (string-length body))))
                                (handle ,(%handle p s (+ a at) (+ a end))))
                              acc))))
          (lines (cdr rest) end (+ line 1)))))
    (reverse acc)))
;;; Lines FROM.. of a snapshot, by its file's line numbers, within the
;;; handle's region: around a `tool-find` hit in kept output, say.
(define (%tool-lines p handle from lines chars)
  (%offset from) (when (= from 0) (error "tool-lines: expected a positive line"))
  (%count lines 200 "tool-lines") (%count chars 16000 "tool-lines")
  (let* ((found (%snapshot-at p handle "tool-lines")) (s (car found)) (a (cadr found)) (b (caddr found))
         (source (%source s)) (starts (%line-starts source)) (n (vector-length starts)))
    (when (> from n) (error "tool-lines: line past end"))
    (let ((start (max a (vector-ref starts (- from 1))))
          (end (min b (if (< (+ from lines -1) n) (vector-ref starts (+ from lines -1)) (string-length source)))))
      (when (or (> start end) (and (= start end) (< a b)))
        (error "tool-lines: those lines are outside the handle's region"))
      (%tool-expand p (%handle p s start end) 0 chars))))
;;; Checked replacements, planned without writing: the snapshot, the
;;; changes ordered by place, and the text they make.
(define (%edit-plan p path expected edits who)
  (unless (and (list? edits) (<= 1 (length edits) 100)) (error (string-append who ": expected 1 to 100 replacements")))
  (let* ((s (%read-snapshot p path)) (original (%source s)))
    (unless (string=? expected (%revision s)) (error (string-append who ": stale revision; read again") path))
    (let ((changes
            (sort (map (lambda (edit)
                         (unless (and (list? edit) (= (length edit) 2) (every string? edit) (not (string=? (car edit) "")))
                           (error (string-append who ": each replacement is (non-empty-old new)")))
                         (let* ((old (car edit)) (at (%index original old 0)))
                           (unless at (error (string-append who ": old text not found") path (%clip old 240)))
                           (when (%index original old (+ at 1))
                             (error (string-append who ": old text is ambiguous") path (%clip old 240)))
                           (list at (+ at (string-length old)) (cadr edit) old)))
                       edits)
                  (lambda (a b) (< (car a) (car b))))))
      (let check ((rest changes))
        (when (pair? (cdr rest))
          (when (> (cadar rest) (caadr rest)) (error (string-append who ": replacements overlap") path))
          (check (cdr rest))))
      (when (> (fold (lambda (c n) (+ n (%utf8-size (caddr c)) (- (%utf8-size (cadddr c))))) (%bytes s) changes) %file-limit)
        (error (string-append who ": result exceeds 1 MiB") path))
      (list s changes
            (apply string-append
              (let loop ((rest changes) (at 0))
                (if (null? rest) (list (substring original at (string-length original)))
                    (cons (substring original at (caar rest))
                          (cons (caddar rest) (loop (cdr rest) (cadar rest)))))))))))
;;; Search/replace blocks, the format agents already write: no escaping.
;;;   FILE [@REVISION]
;;;   <<<<<<< SEARCH
;;;   old lines
;;;   =======
;;;   new lines
;;;   >>>>>>> REPLACE
;;; A block without a file line uses the previous block's file; Markdown
;;; fence lines between blocks are ignored. An empty SEARCH creates a
;;; file that must not exist.
(define (%marker? line marker) (string=? (string-trim-right line) marker))
(define (%parse-blocks text)
  (let loop ((lines (string-split text "\n")) (file #f) (blocks '()))
    (cond ((null? lines) (reverse blocks))
          ((%marker? (car lines) "<<<<<<< SEARCH")
           (unless file (error "tool-apply!: a SEARCH block needs its file on a line before it"))
           (let collect ((rest (cdr lines)) (old '()) (new #f))
             (cond ((null? rest) (error "tool-apply!: a block has no >>>>>>> REPLACE" (car file)))
                   ((and (not new) (%marker? (car rest) "=======")) (collect (cdr rest) old '()))
                   ((and new (%marker? (car rest) ">>>>>>> REPLACE"))
                    (loop (cdr rest) file
                          (cons (list (car file) (cdr file) (string-join (reverse old) "\n") (string-join (reverse new) "\n"))
                                blocks)))
                   (new (collect (cdr rest) old (cons (car rest) new)))
                   (else (collect (cdr rest) (cons (car rest) old) new)))))
          (else
           (let ((line (string-trim (car lines))))
             (loop (cdr lines)
                   (if (or (string=? line "") (string-prefix? "```" line)) file
                       (let ((at (string-contains line " @")))
                         (if at
                             (let ((i (string-cursor->index line at)))
                               (cons (string-trim (substring line 0 i)) (string-trim (substring line (+ i 2) (string-length line)))))
                             (cons line #f))))
                   blocks))))))
(define (%absent? p path) (guard (e (#t #t)) (%read-data p path) #f))
;; What `%repository-create` refuses, checked while planning, before any
;; file of the patch is written.
(define (%creatable! p path source)
  (unless (and (not (string=? path "")) (not (string-prefix? "/" path))
               (every (lambda (part) (not (member part '("" "." "..")))) (string-split path "/")))
    (error "tool-apply!: expected a relative path without . or .." path))
  (when (> (%utf8-size source) %file-limit) (error "tool-apply!: a new file exceeds 1 MiB" path))
  (unless (%absent? p path) (error "tool-apply!: an empty SEARCH creates a file, and this one exists" path)))
(define (%tool-apply! p text)
  (let* ((blocks (%parse-blocks text)) (paths (delete-duplicates (map car blocks))))
    (when (null? blocks) (error "tool-apply!: no SEARCH/REPLACE blocks"))
    (when (> (length paths) 20) (error "tool-apply!: at most 20 files at once"))
    ;; Plan every file before writing any.
    (let ((plans
            (map (lambda (path)
                   (let* ((mine (filter (lambda (b) (string=? (car b) path)) blocks))
                          (wanted (delete-duplicates (filter-map cadr mine))))
                     (when (> (length wanted) 1) (error "tool-apply!: two revisions for one file" path))
                     (if (and (= (length mine) 1) (string=? (caddr (car mine)) ""))
                         ;; The block's lines are whole lines, the last one's newline too.
                         (let* ((new (cadddr (car mine))) (source (if (string=? new "") "" (string-append new "\n"))))
                           (%creatable! p path source)
                           (list 'create path source))
                         (let ((s (%read-snapshot p path)))
                           (when (and (pair? wanted)
                                      (not (and (>= (string-length (car wanted)) 8) (string-prefix? (car wanted) (%revision s)))))
                             (error "tool-apply!: stale revision; read again" path))
                           (list 'edit path (%revision s)
                                 (%edit-plan p path (%revision s) (map (lambda (b) (list (caddr b) (cadddr b))) mine) "tool-apply!"))))))
                 paths))
          (written '()))
      (guard (e ((pair? written)
                 (error (string-append "tool-apply!: wrote " (string-join (reverse written) ", ")
                                       ", then failed: " (condition/report-string e)))))
        (map (lambda (plan)
               (let* ((path (cadr plan)) (create? (eq? (car plan) 'create))
                      (source (if create? (caddr plan) (caddr (cadddr plan))))
                      (revision (if create?
                                    (%repository-create (%project-root p) path source)
                                    (%repository-write (%project-root p) path (caddr plan) source)))
                      (s (%remember! p `((path ,path) (revision ,revision) (text ,source) (bytes ,(%utf8-size source))))))
                 (set! written (cons path written))
                 `((path ,path) (revision ,revision) (created ,create?)
                   (replacements ,(if create? 0 (length (cadr (cadddr plan)))))
                   (handle ,(%handle p s 0 (string-length source))))))
             plans)))))
;;; Plain text for a reply, for a caller reading it rather than parsing.
(define (%written x) (call-with-output-string (lambda (port) (write x port))))
(define (%str x)
  (cond ((string? x) x) ((symbol? x) (symbol->string x)) ((number? x) (number->string x)) (else (%written x))))
(define (%reply? x)
  (and (pair? x) (list? x)
       (every (lambda (e) (and (pair? e) (symbol? (car e)) (pair? (cdr e)) (null? (cddr e)))) x)))
(define (%chomp s) (if (string-suffix? "\n" s) (substring s 0 (- (string-length s) 1)) s))
(define (%show-item item)
  (cond ((not (%reply? item)) (%str item))
        ((and (tool-ref item 'path) (tool-ref item 'line) (string? (tool-ref item 'text)))
         (string-append (tool-ref item 'path) ":" (%str (tool-ref item 'line)) ": " (%chomp (tool-ref item 'text))))
        ((and (tool-ref item 'name) (tool-ref item 'end-line))
         (string-append (tool-ref item 'path) ":" (%str (tool-ref item 'line)) "-" (%str (tool-ref item 'end-line))
                        " " (%str (tool-ref item 'kind)) " " (%str (tool-ref item 'name))))
        ((and (tool-ref item 'name) (assq 'signature item))
         (let ((signature (tool-ref item 'signature)))
           (string-append (if (or (not signature) (equal? signature "")) (%str (tool-ref item 'name)) (%str signature))
                          "  ; " (%str (tool-ref item 'doc)))))
        (else (%str item))))
(define (%show-items reply)
  (let* ((items (tool-ref reply 'items)) (shown (map %show-item items))
         (notes (filter-map (lambda (x) x)
                  (list (and (tool-ref reply 'next)
                             (string-append (%str (length items)) " of " (%str (tool-ref reply 'total))
                                            "; more with #:offset " (%str (tool-ref reply 'next))))
                        (and (assq 'complete reply) (not (tool-ref reply 'complete))
                             (string-append "incomplete: skipped " (%str (or (tool-ref reply 'skipped) 0))
                                            " " (%str (or (tool-ref reply 'problems) '()))))
                        ;; Discovery short of every word.
                        (let ((partial (tool-ref reply 'partial)))
                          (and partial
                               (string-append "partial: " (%str (tool-ref partial 'matched)) " of "
                                              (%str (tool-ref partial 'of)) " words matched")))
                        (let ((libraries (tool-ref reply 'libraries)))
                          (and libraries
                               (string-append "in libraries not imported: "
                                              (string-join (map (lambda (l)
                                                                  (string-append (%str (tool-ref l 'name)) " "
                                                                                 (%written (tool-ref l 'library))))
                                                                libraries)
                                                           ", ")
                                              (if (> (or (tool-ref reply 'libraries-total) 0) (length libraries))
                                                  (string-append "; " (%str (length libraries)) " of "
                                                                 (%str (tool-ref reply 'libraries-total)))
                                                  ""))))))))
    (string-join (append (if (null? items) '("(none)") shown) (map (lambda (n) (string-append "[" n "]")) notes)) "\n")))
(define (%show-stream name stream)
  (let ((text (tool-ref stream 'text)))
    (string-append "--- " name " (" (%str (tool-ref stream 'characters)) " characters"
                   (if (tool-ref stream 'truncated) (string-append ", last " (%str (string-length text)) " shown") "")
                   (if (tool-ref stream 'handle)
                       (string-append "; all " (%str (tool-ref stream 'kept)) " kept: " (%written (tool-ref stream 'handle)))
                       "")
                   ") ---" (if (string=? text "") "" (string-append "\n" (%chomp text))))))
(define (%show-text reply)
  (let ((text (tool-ref reply 'text)))
    (if (tool-ref reply 'next)
        (string-append text (if (string-suffix? "\n" text) "" "\n")
                       "[truncated: (tool-expand project " (%written (tool-ref reply 'handle))
                       " #:offset " (%str (tool-ref reply 'next)) ")]")
        (%chomp text))))
(define (%tool-show reply)
  (cond ((string? reply) reply)
        ((%reply? reply)
         (cond ((and (assq 'program reply) (not (assq 'hits reply)))
                (string-append (cond ((tool-ref reply 'running) "running: the output so far")
                                     ((tool-ref reply 'timed-out) (string-append "timed out, killed: status " (%str (tool-ref reply 'status))))
                                     (else (string-append "status " (%str (tool-ref reply 'status)))))
                               "\n"
                               (%show-stream "stdout" (tool-ref reply 'stdout)) "\n"
                               (%show-stream "stderr" (tool-ref reply 'stderr))))
               ((assq 'hits reply)
                (let ((hits (tool-ref reply 'hits)) (out (tool-ref reply 'stdout)) (err (tool-ref reply 'stderr)))
                  (string-append
                    (if (tool-ref reply 'timed-out) "timed out, killed: status " "status ") (%str (tool-ref reply 'status))
                    "; stdout " (%written (tool-ref out 'handle)) ", stderr " (%written (tool-ref err 'handle)) "\n"
                    (cond ((pair? (tool-ref hits 'items))
                           (string-append (%show-items hits)
                                          (if (tool-ref hits 'truncated) "\n[more matching lines than shown: raise #:limit, or tool-find a handle]" "")
                                          (if (tool-ref reply 'lost) "\n[output past the 1048576 characters kept was not searched]" "")))
                          ((and (eqv? 0 (tool-ref reply 'status)) (not (tool-ref reply 'timed-out))) "(nothing matched)")
                          (else (string-append "(nothing matched; the tails)\n--- stdout\n" (%chomp (tool-ref out 'tail))
                                               "\n--- stderr\n" (%chomp (tool-ref err 'tail))))))))
               ((assq 'ok reply)
                (if (tool-ref reply 'ok) (%tool-show (tool-ref reply 'value)) (string-append "error: " (tool-ref reply 'error))))
               ((assq 'items reply) (%show-items reply))
               ((assq 'replacements reply)
                (string-append (tool-ref reply 'path) ": "
                               (if (tool-ref reply 'created) "created" (string-append (%str (tool-ref reply 'replacements)) " replaced"))
                               ", revision " (tool-ref reply 'revision)))
               ((assq 'previous reply)
                (string-append (tool-ref reply 'path) ": " (%str (length (tool-ref reply 'changes))) " replaced, revision "
                               (tool-ref reply 'revision)))
               ((string? (tool-ref reply 'text)) (%show-text reply))
               (else (%str reply))))
        ((list? reply) (string-join (map %tool-show reply) "\n"))
        (else (%str reply))))
;;; Definition policy: the reader supplies exact Lisp syntax; other
;;; languages use the same declarations and definition queries as imenu.
(define (%scheme-definitions forms source)
  (define out '())
  (define (visit node scope)
    (when (string=? (car node) "list")
      (let* ((xs (list-ref node 4)) (head (and (pair? xs) (cadar xs)))
             (defining (and head (or (string=? head "define") (string-prefix? "define-" head)))))
        (unless (member head '("quote" "quasiquote" "syntax-rules"))
          (when (and defining (pair? (cdr xs)))
            (let* ((sig (cadr xs))
                   (names (cond ((string=? head "define-library") (list (call-with-output-string (lambda (p) (write (read (open-input-string (substring source (caddr sig) (cadddr sig)))) p)))))
                                ((string=? head "define-values") (filter-map cadr (list-ref sig 4)))
                                (else (let name ((node sig))
                                        (if (and (string=? (car node) "list") (pair? (list-ref node 4))) (name (car (list-ref node 4)))
                                            (if (cadr node) (list (cadr node)) '())))))))
              (for-each (lambda (name) (set! out (cons (list name head (caddr node) (cadddr node)
                                                       (if (string=? head "define-library") "library" scope)) out))) names)))
          (let ((local (or (and defining (not (member head '("define-library" "define-values")))
                                               (pair? (cdr xs)) (string=? (caadr xs) "list"))
                           (member head '("lambda" "case-lambda" "let" "let*" "letrec" "letrec*" "let-values" "let*-values")))))
            (for-each (lambda (child) (visit child (if local "local" scope))) xs))))))
  (for-each (lambda (node) (visit node "module")) forms)
  (reverse out))
(define (%relative tree node parent)
  (%source-relative tree (car node) (cadr node) (caddr node) parent))
(define (%definition-start tree node)
  (let loop ((previous (%relative tree node #f)) (start (cadr node)))
    (if (not previous) start
      (let* ((kind (car previous)) (text (%source-text tree (cadr previous) (caddr previous)))
             (attribute (member kind '("attribute_item" "outer_attribute_item")))
             (comment (member kind '("line_comment" "block_comment")))
             (inner (or (string-prefix? "//!" text) (string-prefix? "/*!" text)))
             (doc (or (and (string-prefix? "///" text) (not (string-prefix? "////" text)))
                      (and (string-prefix? "/**" text) (not (string-prefix? "/***" text)) (not (string-prefix? "/**/" text))))))
        (if (or inner (not (or attribute comment))) start
            (loop (%relative tree previous #f) (if (or attribute doc) (cadr previous) start)))))))
(define (%definition-scope tree node)
  (let loop ((parent (%relative tree node #t)))
    (cond ((not parent) "module")
          ((member (car parent) '("function_item" "function_definition" "function_declaration" "method_definition")) "local")
          ((member (car parent) '("impl_item" "trait_item" "class_definition" "class_declaration")) "member")
          (else (loop (%relative tree parent #t))))))
(define (%tool-symbols p path name limit offset)
  (%count limit 50 "tool-symbols") (%offset offset)
  (let* ((s (%read-snapshot p path)) (source (%source s)) (lang (source-language path))
         (complete #t) (provider "scheme-reader") (parsed #f)
         (definitions
           (if (and lang (eq? (language-value lang 'grammar) 'scheme))
               (%scheme-definitions (%source-reader source) source)
               (begin
                 (unless (and lang (language-value lang 'definitions)) (error "tool-symbols: unsupported source language; use tool-search"))
                 (let* ((grammar (symbol->string (language-value lang 'grammar))) (tree (%source-parse grammar source))
                        (reply (%source-query tree (language-value lang 'definitions)))
                        (defs (captured-definitions (lambda (a b) (%source-text tree a b)) (tool-ref reply 'items))))
                   (set! parsed tree)
                   (set! provider (string-append "tree-sitter-" grammar))
                   (set! complete (tool-ref reply 'complete))
                   (filter-map (lambda (d)
                     (let ((node (%source-node tree (car d) (cadr d))))
                       ;; imenu navigates impl blocks; an impl is not a new binding.
                       (and (caddr d) (not (string=? (car node) "impl_item"))
                            (list (caddr d) (car node) (car d) (cadr d) #f)))) defs)))))
         (found (filter (lambda (d) (or (string=? name "") (string=? name (car d)))) definitions))
         (starts (%line-starts source))
         (reply (%page found limit offset #:complete complete)))
    (cons (list 'items (map (lambda (d)
      (let* ((node (and parsed (%source-node parsed (caddr d) (cadddr d))))
             (start (if node (%definition-start parsed node) (caddr d)))
             (scope (if node (%definition-scope parsed node) (list-ref d 4))))
        `((name ,(car d)) (kind ,(cadr d)) (scope ,scope) (path ,(%path s)) (revision ,(%revision s))
          (provider ,provider) (line ,(%line-at starts start)) (end-line ,(%line-at starts (max start (- (cadddr d) 1))))
          (handle ,(%handle p s start (cadddr d)))))) (tool-ref reply 'items))) (cdr reply))))
