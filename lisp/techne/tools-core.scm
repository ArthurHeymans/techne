;;; Repository query policy. Only bounded filesystem and parser mechanisms
;;; cross into Rust; snapshots, paging, search and edits are ordinary Lisp.
(define-record-type tool-project-state
  (%project root namespace listing cache) tool-project?
  (root %project-root) (namespace %namespace)
  (listing %listing %listing-set!) (cache %cache %cache-set!))
(define-record-type source-snapshot
  (%snapshot id path revision source bytes disk-source?) %snapshot?
  (id %id) (path %path) (revision %revision) (source %source) (bytes %bytes) (disk-source? %disk-source?))
(define %file-limit (* 1024 1024))
(define %cache-limit (* 16 %file-limit))
(define (%tool-open root) (%project (%repository-canonical-root root) (%repository-nonce) #f '()))
(define (%tool-root p) (string-copy (%project-root p)))
;; Replies own their mutable strings and pairs: callers must not be able
;; to change a cached filename, revision or snapshot by editing a reply.
(define (%response value)
  (cond ((string? value) (string-copy value))
        ((pair? value) (cons (%response (car value)) (%response (cdr value))))
        (else value)))
(define (%keep! p s)
  (let trim ((cache (cons s (remove (lambda (old) (string=? (%id old) (%id s))) (%cache p)))))
    (if (or (> (length cache) 128) (> (apply + (map %bytes cache)) %cache-limit))
        (trim (take cache (- (length cache) 1)))
        (%cache-set! p cache)))
  s)
(define (%peek p data)
  ;; The cached snapshot of DATA, or a new one not yet kept.
  (let ((path (tool-ref data 'path)) (revision (tool-ref data 'revision)))
    (or (find (lambda (s) (and (string=? (%path s) path) (string=? (%revision s) revision))) (%cache p))
        (%snapshot (%repository-nonce) path revision (tool-ref data 'text) (tool-ref data 'bytes) #t))))
(define (%remember! p data) (%keep! p (%peek p data)))
(define (%read-data p path) (%repository-read (%project-root p) path %file-limit))
(define (%read-snapshot p path)
  (let ((data (%read-data p path)))
    (unless (tool-ref data 'text) (error "tool: not UTF-8 text" path))
    (%remember! p data)))
(define (%files p)
  (or (%listing p) (let ((listed (%repository-list (%project-root p) 10000))) (%listing-set! p listed) listed)))
;;; The files PREFIX names, as a listing: the project's, or, where none
;;; of those starts with it and it names an ignored directory or file
;;; (`target/`), those there, walked without ignore rules, with ignored
;;; #t. A caller naming them asks for them; a prefix naming nothing on
;;; disk, or the root, is not walked.
(define (%prefix-files p prefix)
  (let* ((listed (%files p))
         (files (filter (lambda (path) (string-prefix? prefix path)) (tool-ref listed 'items))))
    (or (and (null? files) (%ignored-files p prefix))
        `((items ,files) (complete ,(tool-ref listed 'complete)) (revision ,(tool-ref listed 'revision))
          (skipped ,(tool-ref listed 'skipped)) (problems ,(tool-ref listed 'problems)) (ignored #f)))))
(define (%ignored-files p prefix)
  (let* ((root (%project-root p))
         (kind (lambda (path)
                 (let ((a (guard (e (#t #f)) (file-attributes (string-append root "/" path)))))
                   (and a (car a)))))
         (slash (let loop ((i (- (string-length prefix) 1)))
                  (cond ((< i 0) #f) ((char=? (string-ref prefix i) #\/) i) (else (loop (- i 1))))))
         ;; The directory to walk: PREFIX itself, or the one its last part is in.
         (dir (cond ((string-suffix? "/" prefix) (substring prefix 0 (- (string-length prefix) 1)))
                    ((memq (kind prefix) '(directory file)) prefix)
                    (slash (substring prefix 0 slash))
                    (else #f)))
         (files '()) (count 0) (complete #t) (skipped 0) (problems '()))
    (define (entries dir)
      (guard (e (#t (set! skipped (+ skipped 1)) (set! complete #f)
                    (when (< (length problems) 3)
                      (set! problems (append problems (list (%clip (condition/report-string e) 240)))))
                    '()))
        (directory-list (string-append root "/" dir))))
    (define (walk dirs)
      (when (pair? dirs)
        (let loop ((rest (entries (car dirs))) (below '()))
          (cond ((null? rest) (walk (append (reverse below) (cdr dirs))))
                ((>= count 10000) (set! complete #f))
                (else
                  (let* ((name (car rest)) (sub? (string-suffix? "/" name))
                         (path (string-append (car dirs) "/" (if sub? (substring name 0 (- (string-length name) 1)) name)))
                         (k (kind path)))
                    (cond ((and sub? (eq? k 'directory) (string-prefix? prefix (string-append path "/"))
                                (not (member name '(".git/" ".jj/" ".hg/" ".svn/"))))
                           (loop (cdr rest) (cons path below)))
                          ((and (not sub?) (eq? k 'file) (string-prefix? prefix path))
                           (set! files (cons path files))
                           (set! count (+ count 1))
                           (loop (cdr rest) below))
                          (else (loop (cdr rest) below)))))))))
    (and dir (not (string=? dir "")) (not (string-prefix? "/" prefix))
         (every (lambda (part) (not (member part '("." ".." ".git" ".jj" ".hg" ".svn")))) (string-split prefix "/"))
         (memq (kind dir) '(directory file))
         (begin
           (if (eq? (kind dir) 'file) (set! files (list dir)) (walk (list dir)))
           `((items ,(sort files string<?)) (complete ,complete) (revision #f)
             (skipped ,skipped) (problems ,problems) (ignored #t))))))
(define (%tool-files p prefix limit offset)
  (%count limit 50 "tool-files" "#:limit") (%offset offset)
  (let* ((listed (%prefix-files p prefix)) (files (tool-ref listed 'items)))
    (append (%page files limit offset #:complete (tool-ref listed 'complete))
      (map (lambda (key) (list key (tool-ref listed key))) '(revision skipped problems ignored)))))
(define (%handle p s start end)
  (string-join (list (%namespace p) (%id s) (number->string start) (number->string end)) ":"))
(define (%line-starts source)
  (let ((size (string-length source)))
    (list->vector
      (let loop ((lines (string-split source "\n")) (at 0) (starts '()))
        (if (null? lines) (reverse starts)
            (loop (cdr lines) (+ at (string-length (car lines)) 1)
                  (if (or (= at 0) (< at size)) (cons at starts) starts)))))))
(define (%line-at starts at)
  (let loop ((lo 0) (hi (vector-length starts)))
    (if (= lo hi) lo
        (let ((mid (quotient (+ lo hi) 2)))
          (if (<= (vector-ref starts mid) at) (loop (+ mid 1) hi) (loop lo mid))))))
(define (%tool-expand p handle offset chars)
  (%offset offset) (%count chars 16000 "tool-expand" "#:chars")
  (let* ((found (%snapshot-at p handle "tool-expand")) (s (car found)) (a (cadr found)) (b (caddr found)))
      (let* ((source (%source s)) (starts (%line-starts source))
             (size (- b a)) (end (min size (+ offset chars)))
             (complete (= end size)) (following (%line-at starts b)))
        (when (> offset size)
          (error (string-append "tool-expand: offset " (number->string offset) " past end (body has " (number->string size) " characters)")))
        `((path ,(%path s)) (revision ,(%revision s)) (handle ,handle)
          (line ,(+ (%line-at starts (+ a offset))
                    (if (and (= (+ a offset) (string-length source)) (string-suffix? "\n" source)) 1 0)))
          (text ,(substring source (+ a offset) (+ a end))) (offset ,offset)
          (characters ,size) (truncated ,(not complete)) (next ,(and (not complete) end))
          (region-complete ,complete) (file-lines ,(and (%disk-source? s) (vector-length starts)))
          (file-eof ,(and (%disk-source? s) complete (= b (string-length source))))
          (next-line ,(and (%disk-source? s) complete (< b (string-length source))
                           (= b (vector-ref starts (- following 1))) following))))))
(define (%tool-read p path from lines chars)
  (%offset from) (when (= from 0) (error "tool-read: expected a positive line"))
  (%count lines 200 "tool-read" "#:lines") (%count chars 16000 "tool-read" "#:chars")
  (let* ((s (%read-snapshot p path)) (starts (%line-starts (%source s))) (n (vector-length starts)))
    (when (> from n) (error "tool-read: line past end"))
    (%tool-expand p (%handle p s (vector-ref starts (- from 1))
                      (if (< (+ from lines -1) n) (vector-ref starts (+ from lines -1)) (string-length (%source s)))) 0 chars)))
(define (%tool-refresh! p) (%listing-set! p #f) (%cache-set! p '()))
(define (%index source needle from)
  (let* ((suffix (if (= from 0) source (substring source from (string-length source))))
         (found (string-contains suffix needle)))
    (and found (+ from (string-cursor->index suffix found)))))
(define (%utf8-size text) (bytevector-length (string->utf8 text)))
(define (%tool-edit! p path expected edits)
  (let* ((plan (%edit-plan p path expected edits "tool-edit!"))
         (s (car plan)) (changes (cadr plan)) (source (caddr plan)) (starts (%line-starts (%source s))))
      (let* ((revision (%repository-write (%project-root p) (%path s) (%revision s) source))
             (next (%remember! p `((path ,(%path s)) (revision ,revision) (text ,source) (bytes ,(%utf8-size source))))))
        `((path ,(%path s)) (revision ,revision) (previous ,(%revision s))
          (changes ,(map (lambda (c) `((line ,(%line-at starts (car c))) (old ,(%clip (cadddr c) 240))
                        (new ,(%clip (caddr c) 240)) (truncated ,(or (> (string-length (cadddr c)) 240) (> (string-length (caddr c)) 240))))) changes))
          (handle ,(%handle p next 0 (string-length source)))))))
;;; The handle a caller means: a handle, or a reply that has one; else
;;; an error saying what to pass.
(define (%handle-of x who)
  (define (refuse . why) (error (apply string-append who ": " why)))
  (cond ((string? x) x)
        ((tool-job? x)
         (refuse "a job is not its output; pass a stream of its result, "
                 "(tool-ref (tool-process-result JOB) 'stdout), run with tool-run #:keep"))
        ((not (%reply? x)) (refuse "expected a handle string, or a reply that has one"))
        ((tool-ref x 'handle) => (lambda (h) (%handle-of h who)))
        ;; A process result: the one stream that has output, else say
        ;; which to name.
        ((and (assq 'stdout x) (assq 'stderr x))
         (let ((wrote (filter (lambda (s) (positive? (or (tool-ref (tool-ref x s) 'characters) 0))) '(stdout stderr))))
           (if (= (length wrote) 1) (%handle-of (tool-ref x (car wrote)) who)
               (refuse "a process result holds two streams; pass one, (tool-ref RESULT 'stdout) or (tool-ref RESULT 'stderr)"))))
        ((assq 'characters x)
         (refuse "this output was not kept; run it with tool-run #:keep CHARACTERS to search or read it"))
        ((assq 'items x) (refuse "a reply of items has no one handle; pass an item, or its handle"))
        (else (refuse "this reply has no handle"))))
;;; One snapshot's region, named by a handle from any reply.
(define (%snapshot-at p handle who)
  (let* ((handle (%handle-of handle who))
         (parts (string-split handle ":"))
         (expired (string-append who ": expired or foreign handle; query again")))
    (unless (and (= (length parts) 4) (string=? (car parts) (%namespace p))) (error expired))
    (let* ((s (find (lambda (s) (string=? (%id s) (cadr parts))) (%cache p)))
           (a (string->number (caddr parts))) (b (string->number (cadddr parts))))
      (unless s (error expired))
      (unless (and (integer? a) (exact? a) (integer? b) (exact? b) (<= 0 a b (string-length (%source s))))
        (error (string-append who ": invalid range")))
      (list s a b))))
;;; Call (PROC BODY LINE START END) for each line of SOURCE's region A to
;;; B, BODY without its newline, LINE its number in SOURCE, START and END
;;; its place there, newline included.
(define (%each-line source a b proc)
  (let ((size (- b a)))
    (let lines ((rest (string-split (substring source a b) "\n")) (at 0)
                (line (%line-at (%line-starts source) a)))
      (unless (or (null? rest) (>= at size))
        (let* ((body (car rest)) (end (min size (+ at (string-length body) 1))))
          (proc body line (+ a at) (+ a end))
          (lines (cdr rest) end (+ line 1)))))))
;;; A found line's item: a preview around column HIT, and its handle.
(define (%line-item p s body line hit start end)
  (let* ((before (max 0 (- hit 60))) (preview (%clip (substring body before (string-length body)) 240)))
    `((path ,(%path s)) (line ,line) (text ,preview) (column ,(+ hit 1))
      (preview-offset ,before)
      (preview-truncated ,(or (> before 0) (< (+ before (string-length preview)) (string-length body))))
      (handle ,(%handle p s start end)))))
;;; Lines of one snapshot region containing QUERY: a file read, a search
;;; hit's line, or a process's kept output; with WHOLE, all its snapshot.
;;; A region's reply counts the matching lines outside it: a read of one
;;; line that finds nothing says what the rest of the file holds.
(define (%tool-find p handle query limit offset whole)
  (%count limit 50 "tool-find" "#:limit") (%offset offset)
  (when (string=? query "") (error "tool-find: query must not be empty"))
  (let* ((found (%snapshot-at p handle "tool-find"))
         (s (car found)) (source (%source s)) (size (string-length source))
         (a (if whole 0 (cadr found))) (b (if whole size (caddr found)))
         (items '()) (shown 0) (total 0))
    (%each-line source a b
      (lambda (body line start end)
        (let ((hit (%index body query 0)))
          (when hit
            (when (and (>= total offset) (< shown limit))
              (set! items (cons (%line-item p s body line hit start end) items))
              (set! shown (+ shown 1)))
            (set! total (+ total 1))))))
    (let ((next (+ offset shown))
          (outside (if (and (= a 0) (= b size)) 0
                       (let ((n 0))
                         (%each-line source 0 size
                           (lambda (body line start end) (when (%index body query 0) (set! n (+ n 1)))))
                         (max 0 (- n total))))))
      `((items ,(reverse items)) (total ,total) (complete #t)
        (truncated ,(< next total)) (next ,(and (< next total) next))
        (outside ,outside)))))
;;; Every line of a snapshot region containing any of PATTERNS, in one
;;; pass: as `%tool-find`'s items, unpaged.
(define (%matching-lines p handle patterns)
  (let* ((found (%snapshot-at p handle "tool-check")) (s (car found)) (acc '()))
    (%each-line (%source s) (cadr found) (caddr found)
      (lambda (body line start end)
        (let ((hit (any (lambda (q) (%index body q 0)) patterns)))
          (when hit (set! acc (cons (%line-item p s body line hit start end) acc))))))
    (reverse acc)))
;;; Lines FROM.. of a snapshot, by its file's line numbers, within the
;;; handle's region: around a `tool-find` hit in kept output, say.
(define (%tool-lines p handle from lines chars)
  (%offset from) (when (= from 0) (error "tool-lines: expected a positive line"))
  (%count lines 200 "tool-lines" "#:lines") (%count chars 16000 "tool-lines" "#:chars")
  (let* ((found (%snapshot-at p handle "tool-lines")) (s (car found)) (a (cadr found)) (b (caddr found))
         (source (%source s)) (starts (%line-starts source)) (n (vector-length starts)))
    (when (> from n) (error "tool-lines: line past end"))
    (let ((start (max a (vector-ref starts (- from 1))))
          (end (min b (if (< (+ from lines -1) n) (vector-ref starts (+ from lines -1)) (string-length source)))))
      (when (or (> start end) (and (= start end) (< a b)))
        (error "tool-lines: those lines are outside the handle's region"))
      (%tool-expand p (%handle p s start end) 0 chars))))
;;; A revision as a caller gives it: the whole one a read returned, or 8
;;; or more characters of its start, as a reply abbreviates it.
(define (%revision! expected s who path)
  (unless (and (string? expected) (>= (string-length expected) 8)
               ;; Not char-numeric?, which takes any script's digits.
               (every (lambda (c) (memv c (string->list "0123456789abcdef"))) (string->list expected)))
    (error (string-append who ": a revision is the lowercase hex a read returns, or 8 or more characters of its start") expected))
  (unless (string-prefix? expected (%revision s)) (error (string-append who ": stale revision; read again") path)))
;;; Checked replacements, planned without writing: the snapshot, the
;;; changes ordered by place, and the text they make.
(define (%edit-plan p path expected edits who)
  (unless (and (list? edits) (<= 1 (length edits) 100)) (error (string-append who ": expected 1 to 100 replacements")))
  (let* ((s (%read-snapshot p path)) (original (%source s)))
    (%revision! expected s who path)
    (let ((changes
            (sort (map (lambda (edit)
                         (unless (and (list? edit) (= (length edit) 2) (every string? edit) (not (string=? (car edit) "")))
                           (error (string-append who ": each replacement is (non-empty-old new)")))
                         (let* ((old (car edit)) (at (%index original old 0)))
                           (unless at (error (string-append who ": old text not found") path (%clip old 240)))
                           (when (%index original old (+ at 1))
                             (error (string-append who ": old text is ambiguous") path (%clip old 240)))
                           (list at (+ at (string-length old)) (cadr edit) old)))
                       edits)
                  (lambda (a b) (< (car a) (car b))))))
      (let check ((rest changes))
        (when (pair? (cdr rest))
          (when (> (cadar rest) (caadr rest)) (error (string-append who ": replacements overlap") path))
          (check (cdr rest))))
      (when (> (fold (lambda (c n) (+ n (%utf8-size (caddr c)) (- (%utf8-size (cadddr c))))) (%bytes s) changes) %file-limit)
        (error (string-append who ": result exceeds 1 MiB") path))
      (let ((source (apply string-append
                      (let loop ((rest changes) (at 0))
                        (if (null? rest) (list (substring original at (string-length original)))
                            (cons (substring original at (caar rest))
                                  (cons (caddar rest) (loop (cdr rest) (cadar rest)))))))))
        (%readable! path original source who)
        (list s changes source)))))
;;; A Scheme file an edit would leave unreadable, a parenthesis too many
;;; or too few, is refused before anything is written: the reply would
;;; not say so, and the file would fail only when next loaded, far from
;;; the edit. One that did not read before may stay so. ORIGINAL is #f
;;; for a file being made.
(define (%read-problem path source)
  (let ((lang (source-language path)))
    (and lang (eq? (language-value lang 'grammar) 'scheme) (%source-read-problem source))))
(define (%readable! path original source who)
  (let ((problem (%read-problem path source)))
    (when (and problem (not (and original (%read-problem path original))))
      (error (string-append who ": " path " would not read as Scheme: " (car problem)
                            (if (cadr problem)
                                (string-append " at line " (number->string (%line-at (%line-starts source) (cadr problem))))
                                "")
                            "; nothing was written")))))
;;; Search/replace blocks, the format agents already write: no escaping.
;;;   FILE [@REVISION]
;;;   <<<<<<< SEARCH
;;;   old lines
;;;   =======
;;;   new lines
;;;   >>>>>>> REPLACE
;;; A block without a file line uses the previous block's file; Markdown
;;; fence lines between blocks are ignored. An empty SEARCH creates a
;;; file that must not exist. Markers may be longer than seven, all three
;;; of a block alike: text holding a seven-character marker (a merge
;;; conflict) is edited inside longer ones.
(define (%marker? line marker) (string=? (string-trim-right line) marker))
;; The length of LINE's opening marker, or #f.
(define (%opening line)
  (let* ((line (string-trim-right line)) (k (- (string-length line) 7)))
    (and (>= k 7) (string=? (substring line k (string-length line)) " SEARCH")
         (every (lambda (c) (char=? c #\<)) (string->list (substring line 0 k)))
         k)))
(define (%parse-blocks text)
  (let loop ((lines (string-split text "\n")) (file #f) (blocks '()))
    (cond ((null? lines) (reverse blocks))
          ((%opening (car lines))
           => (lambda (k)
                (unless file (error "tool-apply!: a SEARCH block needs its file on a line before it"))
                (let ((divider (make-string k #\=)) (closing (string-append (make-string k #\>) " REPLACE")))
                  (let collect ((rest (cdr lines)) (old '()) (new #f))
                    (cond ((null? rest) (error (string-append "tool-apply!: a block has no " closing) (car file)))
                          ((and (not new) (%marker? (car rest) divider)) (collect (cdr rest) old '()))
                          ((and new (%marker? (car rest) closing))
                           (loop (cdr rest) file
                                 (cons (list (car file) (cdr file) (string-join (reverse old) "\n") (string-join (reverse new) "\n"))
                                       blocks)))
                          (new (collect (cdr rest) old (cons (car rest) new)))
                          (else (collect (cdr rest) (cons (car rest) old) new)))))))
          (else
           (let ((line (string-trim (car lines))))
             ;; A divider or closing marker outside a block is a block
             ;; whose SEARCH line is missing, not a file's name: refused,
             ;; not quietly skipped with its edit.
             (when (or (and (>= (string-length line) 7) (every (lambda (c) (char=? c #\=)) (string->list line)))
                       (and (string-suffix? " REPLACE" line) (string-prefix? ">>>>>>>" line)))
               (error "tool-apply!: a ======= or >>>>>>> REPLACE outside a block: its <<<<<<< SEARCH line is missing" line))
             (loop (cdr lines)
                   (if (or (string=? line "") (string-prefix? "```" line)) file
                       (let ((at (string-contains line " @")))
                         (if at
                             (let ((i (string-cursor->index line at)))
                               (cons (string-trim (substring line 0 i)) (string-trim (substring line (+ i 2) (string-length line)))))
                             (cons line #f))))
                   blocks))))))
(define (%absent? p path) (guard (e (#t #t)) (%read-data p path) #f))
;; What `%repository-create` refuses, checked while planning, before any
;; file of the patch is written.
(define (%creatable! p path source)
  (unless (and (not (string=? path "")) (not (string-prefix? "/" path))
               (every (lambda (part) (not (member part '("" "." "..")))) (string-split path "/")))
    (error "tool-apply!: expected a relative path without . or .." path))
  (when (> (%utf8-size source) %file-limit) (error "tool-apply!: a new file exceeds 1 MiB" path))
  (unless (%absent? p path) (error "tool-apply!: an empty SEARCH creates a file, and this one exists" path))
  (%readable! path #f source "tool-apply!"))
(define (%tool-apply! p text)
  (let* ((blocks (%parse-blocks text)) (paths (delete-duplicates (map car blocks))))
    (when (null? blocks) (error "tool-apply!: no SEARCH/REPLACE blocks"))
    (when (> (length paths) 20) (error "tool-apply!: at most 20 files at once"))
    ;; Plan every file before writing any.
    (let ((plans
            (map (lambda (path)
                   (let* ((mine (filter (lambda (b) (string=? (car b) path)) blocks))
                          (wanted (delete-duplicates (filter-map cadr mine))))
                     (when (> (length wanted) 1) (error "tool-apply!: two revisions for one file" path))
                     (if (and (= (length mine) 1) (string=? (caddr (car mine)) ""))
                         ;; The block's lines are whole lines, the last one's newline too.
                         (let* ((new (cadddr (car mine))) (source (if (string=? new "") "" (string-append new "\n"))))
                           (%creatable! p path source)
                           (list 'create path source))
                         (let ((s (%read-snapshot p path)))
                           (when (pair? wanted) (%revision! (car wanted) s "tool-apply!" path))
                           (list 'edit path (%revision s)
                                 (%edit-plan p path (%revision s) (map (lambda (b) (list (caddr b) (cadddr b))) mine) "tool-apply!"))))))
                 paths))
          (written '()))
      (guard (e ((pair? written)
                 (error (string-append "tool-apply!: wrote " (string-join (reverse written) ", ")
                                       ", then failed: " (condition/report-string e)))))
        (map (lambda (plan)
               (let* ((path (cadr plan)) (create? (eq? (car plan) 'create))
                      (source (if create? (caddr plan) (caddr (cadddr plan))))
                      (revision (if create?
                                    (%repository-create (%project-root p) path source)
                                    (%repository-write (%project-root p) path (caddr plan) source)))
                      (s (%remember! p `((path ,path) (revision ,revision) (text ,source) (bytes ,(%utf8-size source))))))
                 (set! written (cons path written))
                 `((path ,path) (revision ,revision) (created ,create?)
                   (replacements ,(if create? 0 (length (cadr (cadddr plan)))))
                   (handle ,(%handle p s 0 (string-length source))))))
             plans)))))
;;; Plain text for a reply, for a caller reading it rather than parsing.
(define (%written x) (call-with-output-string (lambda (port) (write x port))))
(define (%str x)
  (cond ((string? x) x) ((symbol? x) (symbol->string x)) ((number? x) (number->string x)) (else (%written x))))
(define (%reply? x)
  (and (pair? x) (list? x)
       (every (lambda (e) (and (pair? e) (symbol? (car e)) (pair? (cdr e)) (null? (cddr e)))) x)))
(define (%chomp s) (if (string-suffix? "\n" s) (substring s 0 (- (string-length s) 1)) s))
(define (%show-item item)
  (let ((shown (%show-item-base item)))
    (if (and (%reply? item) (assq 'enclosing-status item))
        (string-append shown (%show-enclosing item)) shown)))
(define (%show-item-base item)
  (cond ((not (%reply? item)) (%str item))
        ((tool-ref item 'context-handle) (%show-search-context item))
        ((and (tool-ref item 'path) (assq 'count item))
         (string-append (tool-ref item 'path) ": " (%str (tool-ref item 'count))
                        (if (= 1 (tool-ref item 'count)) " matching line" " matching lines")))
        ((and (tool-ref item 'path) (tool-ref item 'line) (string? (tool-ref item 'text)))
         (string-append (tool-ref item 'path) ":" (%str (tool-ref item 'line)) ": " (%chomp (tool-ref item 'text))))
        ((and (tool-ref item 'name) (tool-ref item 'end-line))
         (string-append (tool-ref item 'path) ":" (%str (tool-ref item 'line)) "-" (%str (tool-ref item 'end-line))
                        " " (%str (tool-ref item 'kind)) " " (%str (tool-ref item 'name))))
        ((and (tool-ref item 'name) (assq 'signature item))
         (let ((signature (tool-ref item 'signature)))
           (string-append (if (or (not signature) (equal? signature "")) (%str (tool-ref item 'name)) (%str signature))
                          "  ; " (%str (tool-ref item 'doc)))))
        (else (%str item))))
;; CONTINUED: the hit's context goes on from the previous hit's, under
;; its header.
(define (%show-search-context item [continued #f])
  (let* ((context (tool-ref item 'context))
         (summary (%show-item-base (remove (lambda (entry) (memq (car entry) '(context context-handle))) item))))
    (cond ((and continued context (not (tool-ref context 'truncated))) (%numbered-text context #f))
          ((not context)
           (string-append summary "\n[context omitted; (tool-expand project "
                          (%written (tool-ref item 'context-handle)) ")]"))
          ((tool-ref context 'truncated)
           (string-append summary "\n" (%numbered-text context)
                          "\n[context clipped; (tool-expand project "
                          (%written (tool-ref item 'context-handle)) " #:offset "
                          (%str (tool-ref context 'next)) ")]"))
          (else (%numbered-text context)))))
;;; Items, a hit whose context continues the previous hit's joined to it:
;;; one header, each one's new lines, then their enclosing definitions,
;;; each once, so that close hits do not repeat their shared lines.
(define (%show-runs items)
  (let loop ((rest items) (out '()))
    (if (null? rest) (reverse out)
        (let collect ((more (cdr rest)) (run (list (car rest))))
          (if (and (pair? more) (%reply? (car more)) (tool-ref (car more) 'context-continues))
              (collect (cdr more) (cons (car more) run))
              (if (null? (cdr run))
                  (loop more (cons (%show-item (car run)) out))
                  (let* ((run (reverse run))
                         (texts (cons (%show-item-base (car run))
                                      (map (lambda (i) (%show-search-context i #t)) (cdr run))))
                         (notes (delete-duplicates
                                  (filter-map (lambda (i) (and (assq 'enclosing-status i) (%show-enclosing i))) run))))
                    (loop more (cons (string-append (string-join (remove (lambda (t) (string=? t "")) texts) "\n")
                                                    (apply string-append notes))
                                     out)))))))))
(define (%show-items reply)
  (let* ((items (tool-ref reply 'items)) (shown (%show-runs items))
         (notes (filter-map (lambda (x) x)
                  (list (and (tool-ref reply 'ignored)
                             (string-append "ignore rules (.gitignore, .ignore) leave these files out of the project; "
                                            "named by the prefix, they were walked without them"))
                        (let ((outside (tool-ref reply 'outside)))
                          (and outside (> outside 0)
                               (string-append (%str outside) " more matching " (if (= outside 1) "line" "lines")
                                              " outside this handle's region; #:whole #t searches all of its snapshot")))
                        (and (eq? (tool-ref reply 'match-mode) 'literal) (= 0 (tool-ref reply 'total))
                             (string-append "0 matches in scanned text; literal query " (%written (tool-ref reply 'query))
                                            (if (tool-ref reply 'query-truncated) " (query clipped)" "")
                                            "; prefix " (%written (tool-ref reply 'prefix))
                                            (if (tool-ref reply 'prefix-truncated) " (prefix clipped)" "")
                                            "; scanned " (%str (tool-ref reply 'scanned))
                                            (if (= 1 (tool-ref reply 'scanned)) " text file. " " text files. ")
                                            "Regex operators are not interpreted; batch separate literal queries for alternatives."))
                        (and (eq? (tool-ref reply 'group-by) 'path)
                             (string-append (%str (tool-ref reply 'total)) " matching lines in "
                                            (%str (tool-ref reply 'files))
                                            (if (= 1 (tool-ref reply 'files)) " file" " files")))
                        (and (tool-ref reply 'next)
                             (string-append (%str (length items)) " of " (%str (or (tool-ref reply 'files) (tool-ref reply 'total)))
                                            "; more with #:offset " (%str (tool-ref reply 'next))))
                        (and (assq 'complete reply) (not (tool-ref reply 'complete))
                             (if (eqv? 0 (or (tool-ref reply 'skipped) 0))
                                 "incomplete: a walk or scan limit was reached (tool-help 'guide lists them); narrow the prefix"
                                 (string-append "incomplete: skipped " (%str (or (tool-ref reply 'skipped) 0))
                                                " " (%str (or (tool-ref reply 'problems) '())))))
                        ;; Discovery short of every word.
                        (let ((partial (tool-ref reply 'partial)))
                          (and partial
                               (string-append "partial: " (%str (tool-ref partial 'matched)) " of "
                                              (%str (tool-ref partial 'of)) " words matched")))
                        (let ((libraries (tool-ref reply 'libraries)))
                          (and libraries
                               (string-append "in libraries not imported: "
                                              (string-join (map (lambda (l)
                                                                  (string-append (%str (tool-ref l 'name)) " "
                                                                                 (%written (tool-ref l 'library))))
                                                                libraries)
                                                           ", ")
                                              (if (> (or (tool-ref reply 'libraries-total) 0) (length libraries))
                                                  (string-append "; " (%str (length libraries)) " of "
                                                                 (%str (tool-ref reply 'libraries-total)))
                                                  ""))))))))
    (string-join (append (if (null? items) '("(none)") shown) (map (lambda (n) (string-append "[" n "]")) notes)) "\n")))
(define (%show-stream name stream)
  (let ((text (tool-ref stream 'text)) (head (tool-ref stream 'head))
        (kept (tool-ref stream 'kept)) (seen (tool-ref stream 'characters)))
    (string-append "--- " name " (" (%str seen) " characters"
                   (if (tool-ref stream 'truncated)
                       (string-append (if head ", first " ", last ") (%str (string-length text)) " shown"
                                      (if head "; the last without #:head" "; #:head #t shows the first"))
                       "")
                   (if (tool-ref stream 'handle)
                       (string-append (if (= kept seen) "; all " "; the first ") (%str kept) " kept: "
                                      (%written (tool-ref stream 'handle))
                                      (if (tool-ref stream 'truncated)
                                          "; tool-find searches it, tool-expand reads it from #:offset 0"
                                          ""))
                       "")
                   ") ---" (if (string=? text "") "" (string-append "\n" (%chomp text))))))
;; HEADED #f leaves out a disk source's header: a block going on under
;; the previous one's.
(define (%numbered-text reply [headed #t])
  (let* ((disk? (tool-ref reply 'file-lines))
         (header (and disk? headed
                      (string-append "[snapshot file-lines: " (%str disk?) "; "
                                     (%written (tool-ref reply 'path)) "; revision "
                                     (%str (tool-ref reply 'revision)) "]")))
         (body
           (if (string=? (tool-ref reply 'text) "") ""
               (let loop ((lines (string-split (%chomp (tool-ref reply 'text)) "\n"))
                          (line (tool-ref reply 'line)) (out '()))
                 (if (null? lines) (string-join (reverse out) "\n")
                     (loop (cdr lines) (+ line 1)
                           (cons (string-append (if disk? "" (string-append (tool-ref reply 'path) ":"))
                                                (%str line) ": " (car lines)) out)))))))
    (if header (string-append header (if (string=? body "") "" (string-append "\n" body))) body)))
(define (%show-text reply numbered)
  (let* ((raw (tool-ref reply 'text))
         (text (if (and numbered (tool-ref reply 'path) (tool-ref reply 'line))
                   (%numbered-text reply) (%chomp raw)))
         (shown
           (cond ((tool-ref reply 'next)
                  (string-append text "\n[truncated region: (tool-expand project "
                                 (%written (tool-ref reply 'handle)) " #:offset "
                                 (%str (tool-ref reply 'next)) ")]"))
                 ((tool-ref reply 'next-line)
                  (string-append text "\n[region complete; more file lines: (tool-read project "
                                 (%written (tool-ref reply 'path)) " #:from "
                                 (%str (tool-ref reply 'next-line)) ")]"))
                 (else text))))
    shown))
(define (%tool-show reply [numbered #t])
  (cond ((string? reply) reply)
        ((%reply? reply)
         (cond ((eq? (tool-ref reply 'kind) 'help)
                (string-join
                  (append (list (tool-ref reply 'purpose))
                          (map %written (tool-ref reply 'signatures))
                          (map (lambda (key) (tool-ref reply key)) '(workflow evidence details))) "\n"))
               ((eq? (tool-ref reply 'kind) 'citation) (%show-citation reply))
               ((and (assq 'program reply) (not (assq 'hits reply)))
                (string-append (cond ((tool-ref reply 'running) "running: the output so far")
                                     ((tool-ref reply 'timed-out) (string-append "timed out, killed: status " (%str (tool-ref reply 'status))))
                                     (else (string-append "status " (%str (tool-ref reply 'status)))))
                               "\n"
                               (%show-stream "stdout" (tool-ref reply 'stdout)) "\n"
                               (%show-stream "stderr" (tool-ref reply 'stderr))))
               ((assq 'hits reply)
                (let ((hits (tool-ref reply 'hits)) (out (tool-ref reply 'stdout)) (err (tool-ref reply 'stderr)))
                  (string-append
                    (if (tool-ref reply 'timed-out) "timed out, killed: status " "status ") (%str (tool-ref reply 'status))
                    "; stdout " (%written (tool-ref out 'handle)) ", stderr " (%written (tool-ref err 'handle)) "\n"
                    (cond ((pair? (tool-ref hits 'items))
                           (string-append (%show-items hits)
                                          (if (tool-ref hits 'truncated) "\n[more matching lines than shown: raise #:limit, or tool-find a handle]" "")
                                          (let ((passing (or (tool-ref hits 'passing) 0)))
                                            (if (> passing 0)
                                                (string-append "\n[" (%str passing) " passing "
                                                               (if (= passing 1) "summary" "summaries")
                                                               " (#:passing) not listed, as other lines matched; #:passing '() lists them]")
                                                ""))
                                          (if (tool-ref reply 'lost) "\n[output past the 1048576 characters kept was not searched]" "")))
                          ((and (eqv? 0 (tool-ref reply 'status)) (not (tool-ref reply 'timed-out))) "(nothing matched)")
                          (else (string-append "(nothing matched; the tails)\n--- stdout\n" (%chomp (tool-ref out 'tail))
                                               "\n--- stderr\n" (%chomp (tool-ref err 'tail))))))))
               ((assq 'ok reply)
                (if (tool-ref reply 'ok) (%tool-show (tool-ref reply 'value) numbered) (string-append "error: " (tool-ref reply 'error))))
               ((assq 'items reply) (%show-items reply))
               ((assq 'replacements reply)
                (string-append (tool-ref reply 'path) ": "
                               (if (tool-ref reply 'created) "created" (string-append (%str (tool-ref reply 'replacements)) " replaced"))
                               ", revision " (tool-ref reply 'revision)))
               ((assq 'previous reply)
                (string-append (tool-ref reply 'path) ": " (%str (length (tool-ref reply 'changes))) " replaced, revision "
                               (tool-ref reply 'revision)))
               ((string? (tool-ref reply 'text)) (%show-text reply numbered))
               (else (%str reply))))
        ((list? reply) (string-join (map (lambda (item) (%tool-show item numbered)) reply) "\n"))
        (else (%str reply))))
;;; Definition policy: the reader supplies exact Lisp syntax; other
;;; languages use the same declarations and definition queries as imenu.
(define (%scheme-definitions forms source)
  (define out '())
  (define (visit node scope)
    (when (string=? (car node) "list")
      (let* ((xs (list-ref node 4)) (head (and (pair? xs) (cadar xs)))
             (defining (and head (or (string=? head "define") (string-prefix? "define-" head)))))
        (unless (member head '("quote" "quasiquote" "syntax-rules"))
          (when (and defining (pair? (cdr xs)))
            (let* ((sig (cadr xs))
                   (names (cond ((string=? head "define-library") (list (call-with-output-string (lambda (p) (write (read (open-input-string (substring source (caddr sig) (cadddr sig)))) p)))))
                                ((string=? head "define-values") (filter-map cadr (list-ref sig 4)))
                                (else (let name ((node sig))
                                        (if (and (string=? (car node) "list") (pair? (list-ref node 4))) (name (car (list-ref node 4)))
                                            (if (cadr node) (list (cadr node)) '())))))))
              (for-each (lambda (name) (set! out (cons (list name head (caddr node) (cadddr node)
                                                       (if (string=? head "define-library") "library" scope)) out))) names)))
          (let ((local (or (and defining (not (member head '("define-library" "define-values")))
                                               (pair? (cdr xs)) (string=? (caadr xs) "list"))
                           (member head '("lambda" "case-lambda" "let" "let*" "letrec" "letrec*" "let-values" "let*-values")))))
            (for-each (lambda (child) (visit child (if local "local" scope))) xs))))))
  (for-each (lambda (node) (visit node "module")) forms)
  (reverse out))
(define (%relative tree node parent)
  (%source-relative tree (car node) (cadr node) (caddr node) parent))
(define (%definition-start tree node)
  (let loop ((previous (%relative tree node #f)) (start (cadr node)))
    (if (not previous) start
      (let* ((kind (car previous)) (text (%source-text tree (cadr previous) (caddr previous)))
             (attribute (member kind '("attribute_item" "outer_attribute_item")))
             (comment (member kind '("line_comment" "block_comment")))
             (inner (or (string-prefix? "//!" text) (string-prefix? "/*!" text)))
             (doc (or (and (string-prefix? "///" text) (not (string-prefix? "////" text)))
                      (and (string-prefix? "/**" text) (not (string-prefix? "/***" text)) (not (string-prefix? "/**/" text))))))
        (if (or inner (not (or attribute comment))) start
            (loop (%relative tree previous #f) (if (or attribute doc) (cadr previous) start)))))))
(define (%definition-scope tree node)
  (let loop ((parent (%relative tree node #t)))
    (cond ((not parent) "module")
          ((member (car parent) '("function_item" "function_definition" "function_declaration" "method_definition")) "local")
          ((member (car parent) '("impl_item" "trait_item" "class_definition" "class_declaration")) "member")
          (else (loop (%relative tree parent #t))))))
(define (%snapshot-definitions s)
  (let* ((source (%source s)) (lang (source-language (%path s)))
         (complete #t) (provider "scheme-reader") (parsed #f)
         (definitions
           (if (and lang (eq? (language-value lang 'grammar) 'scheme))
               (%scheme-definitions (%source-reader source) source)
               (begin
                 (unless (and lang (language-value lang 'definitions)) (error "tool-symbols: unsupported source language; use tool-search"))
                 (let* ((grammar (symbol->string (language-value lang 'grammar))) (tree (%source-parse grammar source))
                        (reply (%source-query tree (language-value lang 'definitions)))
                        (defs (captured-definitions (lambda (a b) (%source-text tree a b)) (tool-ref reply 'items))))
                   (set! parsed tree)
                   (set! provider (string-append "tree-sitter-" grammar))
                   (set! complete (tool-ref reply 'complete))
                   (filter-map (lambda (d)
                     (let ((node (%source-node tree (car d) (cadr d))))
                       ;; imenu navigates impl blocks; an impl is not a new binding.
                       (and (caddr d) (not (string=? (car node) "impl_item"))
                            (list (caddr d) (car node) (car d) (cadr d) #f)))) defs)))))
         (normalized
           (map (lambda (d)
                  (let* ((node (and parsed (%source-node parsed (caddr d) (cadddr d))))
                         (start (if node (%definition-start parsed node) (caddr d)))
                         (scope (if node (%definition-scope parsed node) (list-ref d 4))))
                    (list (car d) (cadr d) start (cadddr d) scope)))
                definitions)))
    `((definitions ,normalized) (complete ,complete) (provider ,provider))))
(define (%definition-item p s d starts provider)
  `((name ,(car d)) (kind ,(cadr d)) (scope ,(list-ref d 4))
    (path ,(%path s)) (revision ,(%revision s)) (provider ,provider)
    (line ,(%line-at starts (caddr d)))
    (end-line ,(%line-at starts (max (caddr d) (- (cadddr d) 1))))
    (handle ,(%handle p s (caddr d) (cadddr d)))))
(define (%tool-symbols p path name limit offset chars)
  (%count limit 50 "tool-symbols" "#:limit") (%offset offset) (%count chars 16000 "tool-symbols" "#:chars")
  (let* ((s (%read-snapshot p path)) (parsed (%snapshot-definitions s))
         (found (filter (lambda (d) (or (string=? name "") (string=? name (car d))))
                        (tool-ref parsed 'definitions)))
         (starts (%line-starts (%source s)))
         (page (%page found limit offset #:complete (tool-ref parsed 'complete)))
         (candidates (map (lambda (d) (%definition-item p s d starts (tool-ref parsed 'provider)))
                          (tool-ref page 'items))))
    ;; Budget rendered definition labels, not random handle lengths. Always
    ;; emit the first item so even a tiny budget advances the item cursor.
    (let take-budget ((rest candidates) (used 0) (out '()))
      (let ((cost (and (pair? rest) (+ (string-length (%show-item (car rest))) (if (null? out) 0 1)))))
        (if (or (null? rest) (and (pair? out) (> (+ used cost) chars)))
            (let* ((items (reverse out)) (next (+ offset (length items))) (total (length found)))
              `((items ,items) (total ,total) (complete ,(tool-ref parsed 'complete))
                (truncated ,(or (< next total) (not (tool-ref parsed 'complete))))
                (next ,(and (< next total) next))
                (characters ,used) (budget-exceeded ,(> used chars))))
            (take-budget (cdr rest) (+ used cost) (cons (car rest) out)))))))
