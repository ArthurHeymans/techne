;;; Bounds/revision validation only: a valid location need not support a claim.
(define (%tool-cite p path from to revision)
  (%count from 2147483647 "tool-cite FROM")
  (%count to 2147483647 "tool-cite TO")
  (when (> from to) (error "tool-cite: FROM must not exceed TO"))
  (unless (or (not revision) (string? revision))
    (error "tool-cite: REVISION must be a string or #f"))
  (let* ((data (%read-data p path)) (source (tool-ref data 'text)))
    (unless source (error "tool-cite: not UTF-8 text" path))
    ;; Do not populate the snapshot cache just to validate a location.
    (let* ((lines (vector-length (%line-starts source)))
           (actual (tool-ref data 'revision))
           (reason (cond ((and revision (not (string=? revision actual))) 'stale-revision)
                         ((> to lines) 'past-end)
                         (else #f)))
           (citation (and (not reason)
                          (string-append (tool-ref data 'path) ":" (number->string from)
                                         (if (= from to) "" (string-append "-" (number->string to)))))))
      `((kind citation) (valid ,(not reason)) (reason ,reason)
        (path ,(tool-ref data 'path)) (from ,from) (to ,to)
        (file-lines ,lines) (revision ,actual) (citation ,citation)))))
(define (%show-citation reply)
  (string-append
    (if (tool-ref reply 'valid)
        (string-append "valid bounds: " (tool-ref reply 'citation))
        (string-append "invalid citation: " (%written (tool-ref reply 'path)) ":"
                       (%str (tool-ref reply 'from)) "-" (%str (tool-ref reply 'to))
                       "; " (%str (tool-ref reply 'reason))))
    "; snapshot file-lines " (%str (tool-ref reply 'file-lines))
    "; revision " (tool-ref reply 'revision)
    (if (tool-ref reply 'valid) "; claim support not checked" "; read again")))
