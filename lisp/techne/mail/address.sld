;;; Mailbox syntax is Scheme policy, shared by envelope and header formatting.
(define-library (techne mail address)
  (export mail-parse-addresses mail-display-addresses)
  (import (techne) (techne mail mime))
  (begin
    (define (bad) (error "Invalid mailbox list: check quotes, comments and addresses"))
    (define (parts text)
      (unless (and (string? text) (<= (string-length text) 65536)
                   (every (lambda (c) (let ((n (char->integer c)))
                                       (and (or (>= n 32) (= n 9)) (not (= n 127))))) (string->list text))) (bad))
      (let ((out (open-output-string)) (items '()))
        (define (flush!)
          (let ((s (string-trim (get-output-string out))))
            (unless (string=? s "") (set! items (cons s items)))
            (when (> (length items) 1000) (bad))
            (set! out (open-output-string))))
        (let loop ((i 0) (quoted? #f) (escaped? #f) (comments 0) (angle? #f))
          (if (= i (string-length text))
              (begin (when (or quoted? escaped? (> comments 0) angle?) (bad)) (flush!) (reverse items))
              (let ((c (string-ref text i)))
                (cond
                 ((> comments 0)
                  (cond (escaped? (loop (+ i 1) quoted? #f comments angle?))
                        ((char=? c #\\) (loop (+ i 1) quoted? #t comments angle?))
                        ((char=? c #\() (when (>= comments 16) (bad)) (loop (+ i 1) quoted? #f (+ comments 1) angle?))
                        ((char=? c #\)) (loop (+ i 1) quoted? #f (- comments 1) angle?))
                        (else (loop (+ i 1) quoted? #f comments angle?))))
                 (escaped? (write-char c out) (loop (+ i 1) quoted? #f 0 angle?))
                 ((and quoted? (char=? c #\\)) (write-char c out) (loop (+ i 1) quoted? #t 0 angle?))
                 ((char=? c #\") (write-char c out) (loop (+ i 1) (not quoted?) #f 0 angle?))
                 (quoted? (write-char c out) (loop (+ i 1) #t #f 0 angle?))
                 ((char=? c #\() (write-char #\space out) (loop (+ i 1) #f #f 1 angle?))
                 ((char=? c #\)) (bad))
                 ((char=? c #\<) (when angle? (bad)) (write-char c out) (loop (+ i 1) #f #f 0 #t))
                 ((char=? c #\>) (unless angle? (bad)) (write-char c out) (loop (+ i 1) #f #f 0 #f))
                 ((and (not angle?) (char=? c #\,)) (flush!) (loop (+ i 1) #f #f 0 #f))
                 (else (write-char c out) (loop (+ i 1) #f #f 0 angle?))))))))
    (define (ascii? s) (every (lambda (c) (<= 32 (char->integer c) 126)) (string->list s)))
    (define (atom-char? c)
      (or (char<=? #\a c #\z) (char<=? #\A c #\Z) (char<=? #\0 c #\9)
          (and (string-index "!#$%&'*+-/=?^_`{|}~" c) #t)))
    (define (normalize-address address)
      ;; CFWS around @ is legal; whitespace inside an atom is not. Preserve
      ;; quoted local parts exactly rather than deleting arbitrary spaces.
      (let scan ((i 0) (quoted? #f) (escaped? #f) (at #f))
        (if (= i (string-length address))
            (if at (string-append (string-trim (substring address 0 at)) "@"
                                  (string-trim (substring address (+ at 1) (string-length address)))) address)
            (let ((c (string-ref address i)))
              (cond (escaped? (scan (+ i 1) quoted? #f at))
                    ((and quoted? (char=? c #\\)) (scan (+ i 1) #t #t at))
                    ((char=? c #\") (scan (+ i 1) (not quoted?) #f at))
                    ((and (not quoted?) (char=? c #\@)) (if at address (scan (+ i 1) #f #f i)))
                    (else (scan (+ i 1) quoted? #f at)))))))
    (define (valid-address? address)
      (and (<= 3 (string-length address) 254) (ascii? address)
           (let scan ((i 0) (quoted? #f) (escaped? #f) (at #f))
             (if (= i (string-length address))
                 (and (not quoted?) (not escaped?) at
                      (let* ((local (substring address 0 at)) (domain (substring address (+ at 1) (string-length address)))
                             (labels (string-split domain ".")))
                        (and (<= 1 (string-length local) 64) (> (string-length domain) 0)
                             (if (char=? (string-ref local 0) #\")
                                 ;; The scanner validated quoting/escapes; a quoted
                                 ;; local part must consist of exactly one string.
                                 (let check ((i 1) (escaped? #f))
                                   (and (< i (string-length local))
                                        (let ((c (string-ref local i)))
                                          (cond (escaped? (check (+ i 1) #f))
                                                ((char=? c #\\) (check (+ i 1) #t))
                                                ((char=? c #\") (= i (- (string-length local) 1)))
                                                (else (check (+ i 1) #f))))))
                                 (every (lambda (a) (and (> (string-length a) 0) (every atom-char? (string->list a))))
                                        (string-split local ".")))
                             (if (char=? (string-ref domain 0) #\[)
                                 (and (> (string-length domain) 2) (string-suffix? "]" domain)
                                      (every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (memv c '(#\. #\: #\-))))
                                             (string->list (substring domain 1 (- (string-length domain) 1)))))
                                 (every (lambda (label)
                                          (and (<= 1 (string-length label) 63)
                                               (not (string-prefix? "-" label)) (not (string-suffix? "-" label))
                                               (every (lambda (c) (or (char-alphabetic? c) (char-numeric? c) (char=? c #\-))) (string->list label)))) labels)))))
                 (let ((c (string-ref address i)))
                   (cond (escaped? (scan (+ i 1) quoted? #f at))
                         ((and quoted? (char=? c #\\)) (scan (+ i 1) #t #t at))
                         ((char=? c #\") (scan (+ i 1) (not quoted?) #f at))
                         ((and (not quoted?) (char=? c #\@)) (and (not at) (scan (+ i 1) #f #f i)))
                         (else (scan (+ i 1) quoted? #f at))))))))
    (define (unquote-name text)
      (let ((out (open-output-string)))
        (let loop ((i 0) (quoted? #f) (escaped? #f))
          (if (= i (string-length text)) (mail-decode-header (string-trim (get-output-string out)))
              (let ((c (string-ref text i)))
                (cond (escaped? (write-char c out) (loop (+ i 1) quoted? #f))
                      ((and quoted? (char=? c #\\)) (loop (+ i 1) quoted? #t))
                      ((char=? c #\") (loop (+ i 1) (not quoted?) #f))
                      (else (write-char c out) (loop (+ i 1) quoted? #f))))))))
    (define (parse-one part)
      (let scan ((i 0) (quoted? #f) (escaped? #f) (left #f) (right #f))
        (if (= i (string-length part))
            (let* ((address (normalize-address (string-trim (if left (substring part (+ left 1) right) part))))
                   (name (if left (unquote-name (substring part 0 left)) ""))
                   (name (list->string (map (lambda (c) (if (char=? c #\tab) #\space c)) (string->list name)))))
              (unless (every (lambda (c) (let ((n (char->integer c))) (and (>= n 32) (not (<= 127 n 159))))) (string->list name)) (bad))
              (when (or (and right (not (string=? (string-trim (substring part (+ right 1) (string-length part))) "")))
                        (> (string-length name) 4096) (not (valid-address? address))) (bad))
              (list (cons 'address address) (cons 'name name)))
            (let ((c (string-ref part i)))
              (cond (escaped? (scan (+ i 1) quoted? #f left right))
                    ((and quoted? (char=? c #\\)) (scan (+ i 1) #t #t left right))
                    ((char=? c #\") (scan (+ i 1) (not quoted?) #f left right))
                    ((and (not quoted?) (char=? c #\<)) (when left (bad)) (scan (+ i 1) #f #f i right))
                    ((and (not quoted?) (char=? c #\>)) (when (or (not left) right) (bad)) (scan (+ i 1) #f #f left i))
                    (else (scan (+ i 1) quoted? #f left right)))))))
    (define (mail-parse-addresses text)
      "Parse mailbox list TEXT into alists with address and name entries.
Quoted display names, escaped quotes, nested comments, angle mailboxes and
quoted ASCII local parts are supported. RFC 2047 display words are decoded.
Envelope addresses must be ASCII; groups and SMTPUTF8 are not supported.
Refuse control injection, unbalanced syntax and more than 1000 mailboxes."
      (map parse-one (parts text)))
    (define (quote-name name)
      (string-append "\"" (apply string-append (map (lambda (c) (if (memv c '(#\\ #\")) (string #\\ c) (string c))) (string->list name))) "\""))
    (define (mail-display-addresses text)
      "Return canonical, human-readable mailbox list TEXT for editing.
Names are decoded and quoted safely; envelope addresses remain unchanged.
This is not MIME header encoding; the SMTP formatter encodes names later."
      (string-join
       (map (lambda (mailbox)
              (let ((address (cdr (assq 'address mailbox))) (name (cdr (assq 'name mailbox))))
                (if (string=? name "") address (string-append (quote-name name) " <" address ">"))))
            (mail-parse-addresses text)) ", "))))
