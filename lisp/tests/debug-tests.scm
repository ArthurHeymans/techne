(require "../test.scm")
(import (techne debug))

(define (failure thunk)
  (guard (e (#t #t)) (thunk) #f))
(define (phases log) (map (lambda (e) (dict-ref e 'phase)) (trace-log-events log)))
(define (details log) (map (lambda (e) (dict-ref e 'detail)) (trace-log-events log)))

;; Runtime mechanisms: identity CAS, old-to-young barriers, bounded printing
;; without walking a cyclic graph first or copying a large collection.
(define b (box (list 1)))
(define first (unbox b))
(check "CAS compares identity" #f (box-cas! b (list 1) 'wrong))
(check "CAS mismatch preserves value" first (unbox b))
(check "CAS success" #t (box-cas! b first (list 2)))
(check "CAS writes" '(2) (unbox b))
(check-true "CAS validates box" (failure (lambda () (box-cas! 1 2 3))))
(check "repr unchanged" "#0=(1 . #0#)" (let ((v (list 1))) (set-cdr! v v) (repr v)))
(check "repr fits exactly" "12345" (repr 12345 5))
(check "repr clipped" "12..." (repr 123456 5))
(check "repr minimal" "..." (repr '(1 2) 3))
(check "repr empty atom" "()" (repr '() 3))
(check-true "repr lower bound" (failure (lambda () (repr 1 2))))
(check-true "repr upper bound" (failure (lambda () (repr 1 4097))))
(check-true "repr integer bound" (failure (lambda () (repr 1 4.0))))
(check-true "repr cyclic pair ends"
  (let ((v (list 1))) (set-cdr! v v) (string-suffix? "..." (repr v 64))))
(check-true "repr cyclic vector ends"
  (let ((v (vector #f))) (vector-set! v 0 v) (<= (bytevector-length (string->utf8 (repr v 64))) 64)))
(for-each
  (lambda (v)
    (let ((text (repr v 64)))
      (check-true "repr stays within bytes" (<= (bytevector-length (string->utf8 text)) 64))
      (check-true "repr says clipped" (string-suffix? "..." text))))
  (list (make-string 10000 #\newline)
        (make-string 10000 #\λ)
        (string->symbol (make-string 10000 #\λ))
        (string->keyword (make-string 10000 #\a))
        (make-bytevector 10000 255)
        (expt 2 10000)
        (/ (expt 3 10000) (expt 2 10000))
        (let loop ((i 0) (d (dict)))
          (if (= i 1000) d (loop (+ i 1) (dict-set d i i))))))

(define log (current-trace-log))
(define (add x [y 1] #:scale [scale 1]) (* scale (+ x y)))
(define original add)
(define alias add)
(trace add)
(check "trace installs a wrapper" #f (eq? original add))
(define wrapped add)
(trace add)
(check "trace is idempotent" #t (eq? wrapped add))
(check "arguments and keywords preserved" 20 (add 3 7 #:scale 2))
(check "call and return" '(call return) (phases log))
(check "argument and result snapshots" '("(3 7 #:scale 2)" "(20)") (details log))
(check "call identity pairs events" 1 (length (delete-duplicates (map (lambda (e) (dict-ref e 'call)) (trace-log-events log)))))
(clear-trace-log! log)
(check "original alias works" 6 (alias 5))
(check "old alias is not intercepted" '() (trace-log-events log))
(check "trace lists module and name" (list (list (current-module) 'add)) (trace))
(untrace add)
(check "untrace restores original" #t (eq? add original))
(check "untrace lists none" '() (trace))
(check "saved wrapper works" 4 (wrapped 3))
(check "saved wrapper is retired" '() (trace-log-events log))

;; Zero and multiple values are preserved through return recording.
(define (many) (values 1 2 3))
(define (none) (values))
(trace many none)
(check "multiple values" '(1 2 3) (call-with-values many list))
(check "zero values" '() (call-with-values none list))
(check "values summarized" '("()" "(1 2 3)" "()" "()") (details log))
(untrace)
(clear-trace-log! log)

;; Conditions are observed at the raise point without consuming a restart
;; or turning a continuable raise into a non-continuable one.
(define boom (list 'boom))
(define (raise-boom) (raise boom))
(trace raise-boom)
(check "same condition escapes" #t (guard (e (#t (eq? e boom))) (raise-boom) #f))
(check "condition and unwind recorded" '(call condition unwind) (phases log))
(clear-trace-log! log)
(define (continuable) (+ 1 (raise-continuable boom)))
(trace continuable)
(check "continuable handler returns"
       42 (with-exception-handler (lambda (c) 41) continuable))
(check "continuable returns, not unwinds" '(call condition return) (phases log))
(clear-trace-log! log)
(define (risky)
  (restart-case (+ 1 (error "broken")) (use-value (v) v)))
(trace risky)
(check "live restart survives tracing" 17
       (with-exception-handler (lambda (c) (invoke-restart 'use-value 17)) risky))
(check "restart exits inner expression, returns from procedure" '(call condition return) (phases log))
(untrace)
(clear-trace-log! log)

;; Redefining a traced binding is explicit. Untrace never reinstalls its
;; old definition, and retracing retires any saved old wrapper.
(define (fresh) 'old)
(trace fresh)
(define stale fresh)
(set! fresh (lambda () 'new))
(untrace fresh)
(check "untrace preserves redefinition" 'new (fresh))
(check "old wrapper still calls its old code" 'old (stale))
(check "old wrapper no longer records" '() (trace-log-events log))
(trace fresh)
(define stale-again fresh)
(set! fresh (lambda () 'newer))
(trace fresh)
(check "retrace new code" 'newer (fresh))
(clear-trace-log! log)
(stale-again)
(check "retrace retires prior wrapper" '() (trace-log-events log))
(untrace)

;; No live argument or result is held in the event log.
(define (echo x) x)
(trace echo)
(define mutable (list 'before))
(echo mutable)
(set-car! mutable 'after)
(check "snapshots do not change with arguments" '("((before))" "((before))") (details log))
(clear-trace-log! log)
(check "log can be disabled" 7 (parameterize ((current-trace-log #f)) (echo 7)))
(check "disabled log records nothing" '() (trace-log-events log))
(untrace)

;; Entry/exit budget, including streamed output, stays bounded. A broken
;; output port cannot replace the result or condition.
(define output (open-output-string))
(define small (make-trace-log #:limit 3 #:port output))
(parameterize ((current-trace-log small))
  (trace echo)
  (echo 1) (echo 2) (echo 3)
  (check "limited log size" 3 (length (trace-log-events small)))
  (check "limit is explicit" #t (trace-log-truncated? small))
  (check "one limit notice" 1 (- (length (string-split (get-output-string output) "trace limit reached")) 1))
  (let ((before (get-output-string output)))
    (do ((i 0 (+ i 1))) ((= i 100)) (echo i))
    (check "no further output" before (get-output-string output)))
  (clear-trace-log! small)
  (check "clear resets truncation" #f (trace-log-truncated? small))
  (echo 4)
  (check "clear rearms recording" '(call return) (phases small))
  (let* ((closed (open-output-string)) (capture (make-trace-log #:port closed)))
    (close-port closed)
    (parameterize ((current-trace-log capture))
      (check "closed stream preserves result" 5 (echo 5)))
    (check "closed stream still records exits" '(call return) (phases capture)))
  (untrace))

;; A deep tail recursion does not accumulate an unbounded stack of trace
;; wrappers: at depth 32 it runs through without instrumentation.
(define (down n) (if (= n 0) 'done (down (- n 1))))
(define deep (make-trace-log #:limit 1000 #:port #f))
(parameterize ((current-trace-log deep))
  (trace down)
  (check "deep tail recursion" 'done (down 20000))
  (check "depth is bounded" 31 (apply max (map (lambda (e) (dict-ref e 'depth)) (trace-log-events deep))))
  (check "only bounded nesting traced" 64 (length (trace-log-events deep)))
  (untrace))

;; Shared logs are published with CAS, not a Scheme lock a killed task
;; could leave held. Task ids and depth distinguish interleaved calls.
(define ready (make-channel 4))
(define resume (make-channel 4))
(define (wait-for n) (channel-send ready n) (channel-recv resume) n)
(trace wait-for)
(clear-trace-log! log)
(define a (spawn (lambda () (wait-for 1))))
(define c (spawn (lambda () (wait-for 2))))
(channel-recv ready) (channel-recv ready)
(check "two paused calls" '(call call) (phases log))
(check "distinct task ids" 2 (length (delete-duplicates (map (lambda (e) (dict-ref e 'task)) (trace-log-events log)))))
(channel-send resume #t) (channel-send resume #t)
(check "interleaved task results" '(1 2) (list (task-join a) (task-join c)))
(check "matching exits recorded" 4 (length (trace-log-events log)))
(clear-trace-log! log)
(define cancelled (spawn (lambda () (wait-for 3))))
(channel-recv ready)
(task-cancel cancelled)
(check-true "cancelled task fails" (failure (lambda () (task-join cancelled))))
(check "cancel unwinds trace" '(call condition unwind) (phases log))
(clear-trace-log! log)
(define killed (spawn (lambda () (wait-for 4))))
(channel-recv ready)
(task-kill killed)
(check-true "killed task fails" (failure (lambda () (task-join killed))))
(check "kill promises no cleanup event" '(call) (phases log))
(check "subsequent task still runs" 9 (task-join (spawn (lambda () 9))))
(untrace)

;; Atomic publication under sustained preemption: no missing or duplicate
;; events, and no limit overshoot when many tasks share a small log.
(define (work x) (yield) x)
(trace work)
(define shared (make-trace-log #:limit 1000 #:port #f))
(parameterize ((current-trace-log shared))
  (let ((tasks (map (lambda (n) (spawn (lambda () (do ((i 0 (+ i 1))) ((= i 20)) (work n))))) (iota 10))))
    (for-each task-join tasks)))
(check "all shared events kept" 400 (length (trace-log-events shared)))
(check "shared log not truncated" #f (trace-log-truncated? shared))
(define crowded (make-trace-log #:limit 7 #:port #f))
(parameterize ((current-trace-log crowded))
  (let ((tasks (map (lambda (n) (spawn (lambda () (work n)))) (iota 20)))) (for-each task-join tasks)))
(check "shared limit never overshoots" 7 (length (trace-log-events crowded)))
(check "shared truncation reported" #t (trace-log-truncated? crowded))
(untrace)

;; Inject cancellation at the instrumentation boundary itself, rather
;; than only in the original procedure. Private helpers are replaced just
;; for these regressions, through the trusted live module API.
(define debug-module "(techne debug)")
(define real-stream (eval '%stream debug-module))
(define set-stream! (eval '(lambda (p) (set! %stream p)) debug-module))
(define real-retire (eval '%retire! debug-module))
(define set-retire! (eval '(lambda (p) (set! %retire! p)) debug-module))
(define (cancelled? thunk)
  (guard (e (#t (and (error-object? e) (string=? (error-object-message e) "task cancelled"))))
    (thunk) #f))
(define instrument-body-ran 0)
(define (instrumented) (set! instrument-body-ran (+ instrument-body-ran 1)) 'ok)
(trace instrumented)
(clear-trace-log! log)
(set-stream! (lambda (log text) (task-cancel (current-task))))
(check "cancel during entry logging propagates" #t
       (cancelled? (lambda () (task-join (spawn instrumented)))))
(check "cancelled entry does not run original" 0 instrument-body-ran)
(check "entry logging cancellation records unwind" '(call unwind) (phases log))
(clear-trace-log! log)
(define stream-calls 0)
(set-stream! (lambda (log text)
               (set! stream-calls (+ stream-calls 1))
               (when (= stream-calls 2) (task-cancel (current-task)))))
(check "cancel during return logging propagates" #t
       (cancelled? (lambda () (task-join (spawn instrumented)))))
(check "return cancellation happens after original" 1 instrument-body-ran)
(check "return logging cancellation records unwind" '(call return unwind) (phases log))
(set-stream! (lambda (log text) (error "interrupted")))
(check "interrupt during logging propagates" "interrupted"
       (guard (e (#t (error-object-message e))) (task-join (spawn instrumented)) #f))
(set-stream! real-stream)
(untrace)

;; Cancel immediately before retirement. The registry must still retain
;; every live wrapper so a later untrace can finish the interrupted work.
(define (retire-target) 'original)
(define retire-original retire-target)
(trace retire-target)
(set-retire! (lambda (entry) (task-cancel (current-task))))
(check "cancel interrupted untrace" #t
       (cancelled? (lambda () (task-join (spawn (lambda () (untrace retire-target)))))))
(set-retire! real-retire)
(check "interrupted untrace remains discoverable" 1 (length (trace)))
(untrace retire-target)
(check "untrace can finish interrupted retirement" #t (eq? retire-target retire-original))
(trace retire-target)
(set-retire! (lambda (entry) (task-cancel (current-task))))
(check "cancel interrupted untrace all" #t
       (cancelled? (lambda () (task-join (spawn (lambda () (untrace)))))))
(set-retire! real-retire)
(check "untrace all keeps pending entries" 1 (length (trace)))
(untrace)
(check "untrace all can finish retirement" #t (eq? retire-target retire-original))
(trace retire-target)
(define predecessor retire-target)
(set! retire-target (lambda () 'new-definition))
(set-retire! (lambda (entry) (task-cancel (current-task))))
(check "cancel interrupted replacement" #t
       (cancelled? (lambda () (task-join (spawn (lambda () (trace retire-target)))))))
(set-retire! real-retire)
(untrace)
(check "interrupted replacement keeps new definition" 'new-definition (retire-target))
(clear-trace-log! log)
(predecessor)
(check "replacement predecessor can still be retired" '() (trace-log-events log))

(define before-kill retire-target)
(trace retire-target)
(set-retire! (lambda (entry) (task-kill (current-task))))
(check-true "kill interrupted untrace"
       (failure (lambda () (task-join (spawn (lambda () (untrace retire-target)))))))
(set-retire! real-retire)
(check "killed untrace keeps live wrapper discoverable" 1 (length (trace)))
(untrace)
(check "untrace can finish after hard kill" #t (eq? retire-target before-kill))

;; Warm the global call before installing a wrapper. The JIT's guard must
;; notice the changed binding rather than silently keep its inline path.
(define (hot-callee n) (+ n 1))
(define (hot-caller n) (hot-callee n))
(do ((i 0 (+ i 1))) ((= i 1000)) (hot-caller i))
(clear-trace-log! log)
(trace hot-callee)
(check "previously compiled caller sees wrapper" 42 (hot-caller 41))
(check "compiled caller records callee" '(call return) (phases log))
(untrace)

(define (child-call) 'child)
(define (parent-call) (task-join (spawn child-call)))
(clear-trace-log! log)
(trace parent-call child-call)
(check "spawned child returns" 'child (parent-call))
(check "child does not inherit parent depth" '(0 0 0 0)
       (map (lambda (e) (dict-ref e 'depth)) (trace-log-events log)))
(untrace)

;; A full collection proves that snapshots, not only their textual
;; appearance, release the original argument/result graph.
(define weak-values (make-weak-hash-table))
(clear-trace-log! log)
(trace echo)
(let ((v (list (make-string 10000 #\x))))
  (hash-table-set! weak-values v #t)
  (echo v)
  #t)
(collect-garbage 'full)
(check "trace does not retain argument graph" 0 (hash-table-size weak-values))
(untrace)

;; Binding identity is lexical, not the module of the evaluation calling
;; an enable/disable procedure. Import renames resolve to the same slot;
;; an unrelated same-named user binding must remain independent.
(define-library (trace-cross-module)
  (export f enable disable)
  (import (scheme base) (techne debug))
  (begin
    (define (f x) (+ x 1))
    (define (enable) (trace f))
    (define (disable) (untrace f))))
(import (only (trace-cross-module) enable disable)
        (rename (only (trace-cross-module) f) (f imported-f)))
(define (f x) (* x 2))
(define library-original imported-f)
(enable)
(check "enable uses binding owner, not caller module"
       '(("(trace-cross-module)" f)) (trace))
(trace f)
(check "same-named bindings have separate entries" 2 (length (trace)))
(clear-trace-log! log)
(check "library binding still traced independently" 4 (imported-f 3))
(check "user binding still traced independently" 6 (f 3))
(check "both bindings record" '(call return call return) (phases log))
(untrace f)
(check "untrace user leaves library wrapper" #f (eq? imported-f library-original))
(eval '(untrace f) "(trace-cross-module)")
(check "owner module can untrace enabled-from-user binding" #t (eq? imported-f library-original))
(check "cross-module retire leaves no entries" '() (trace))
(enable)
(untrace imported-f)
(check "renamed import identifies original binding" #t (eq? imported-f library-original))
(enable)
(disable)
(check "retained disable uses lexical binding" '() (trace))
(check-true "trace refuses lexical locals instead of sharing a global key"
            (failure (lambda () (eval '(let ((f (lambda () #t))) (trace f))))))
(check-true "binding metadata rejects nonidentifiers"
            (failure (lambda () (eval '(%binding-identity 1)))))
(check-true "binding metadata rejects unbound names"
            (failure (lambda () (eval '(%binding-identity trace-unbound-name)))))

(check-true "invalid trace limit" (failure (lambda () (make-trace-log #:limit 0))))
(check-true "invalid trace port" (failure (lambda () (make-trace-log #:port 1))))
(define not-procedure 1)
(check-true "nonprocedure refused" (failure (lambda () (trace not-procedure))))
(check "failed trace not registered" '() (trace))
(test-summary)
