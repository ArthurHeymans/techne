;;; Package directories: manifests read as data, the libraries a package
;;; provides and those of the packages it depends on, without the editor.
(import (techne) (techne crypto) (techne package) (techne path) (techne uuid))
(require "../test.scm")

(define root (string-append (or (get-environment-variable "TMPDIR") "/tmp") "/techne-package-" (uuid-v4)))
(define (at . parts) (apply path-join root parts))
(define (write-file! file . forms)
  (make-directory (path-directory file))
  (call-with-output-file file (lambda (port) (for-each (lambda (f) (write f port) (newline port)) forms))))
(define (pkg-dir name) (symbol->string (cadr name)))
(define (package! name . clauses)
  (write-file! (at (pkg-dir name) "techne-package.scm") `(package ,name ,@clauses)))
(define (library! package name . body)
  (write-file! (at (pkg-dir package) "lib" (symbol->string (car package)) (symbol->string (cadr package))
                   (string-append (symbol->string name) ".sld"))
               `(define-library (,@package ,name) ,@body)))
(define (root-library! package . body)
  (write-file! (at (pkg-dir package) "lib" (symbol->string (car package))
                   (string-append (symbol->string (cadr package)) ".sld"))
               `(define-library ,package ,@body)))
(define (why thunk) (guard (e (#t (condition/report-string e))) (thunk) #f))
(define (failed? thunk) (and (why thunk) #t))

;; package-name? accepts canonical lowercase 2-symbol (owner pkg) names only.
(check "valid package name" #t (package-name? '(alice router)))
(check "valid techne package name" #t (package-name? '(techne mail)))
(check "valid with punctuation" #t (package-name? '(my-org pkg_2.0)))
(for-each (lambda (bad) (check "invalid package name" #f (package-name? bad)))
          (append '(alpha (alpha) (a b c) (Alice pkg) (alice Pkg) ("alice" pkg) (alice "pkg") (.. pkg))
                  (list (list 'alice (string->symbol ".")))))

;; A manifest is data: v2 clauses, and the shorthand editor form.
(write-file! (at "editing" "entry.scm") '(define loaded #t))
(write-file! (at "editing" "app.scm") '(define handler #t))
(package! '(acme editing)
          '(version "0.1.0")
          '(techne "0.4")
          '(description "Editing helper and cloud worker.")
          '(depends ((acme alpha) (path "../alpha")))
          '(editor "entry.scm" (commands (edit "Edit it.")) (options (edit-count 2 integer "How often.")))
          '(cloud "app.scm" (bindings (cache kv) (api-key secret) (greeting text))))
(let ((m (read-package-manifest (at "editing"))))
  (check "name" '(acme editing) (manifest-name m))
  (check "directory" (file-truename (at "editing")) (manifest-directory m))
  (check "version" "0.1.0" (manifest-version m))
  (check "techne" "0.4" (manifest-techne m))
  (check "description" "Editing helper and cloud worker." (manifest-description m))
  (check "dependencies, by directory" (list (cons '(acme alpha) (path-join (file-truename (at "editing")) "../alpha")))
         (manifest-dependencies m))
  (check "editor entry, commands and options"
         (list (file-truename (at "editing" "entry.scm")) '((edit "Edit it.")) '((edit-count 2 integer "How often.")))
         (manifest-editor m))
  (check "cloud entry and bindings"
         (list (file-truename (at "editing" "app.scm")) '((cache kv) (api-key secret) (greeting text)))
         (manifest-cloud m)))

(write-file! (at "first" "entry.scm") '(define loaded #t))
(write-file! (at "first" "techne-package.scm")
             '(package (acme first) "entry.scm" ((go "Go.")) ((speed 3 integer "How fast."))))
(let ((m (read-package-manifest (at "first"))))
  (check "the shorthand form is an editor clause"
         (list (file-truename (at "first" "entry.scm")) '((go "Go.")) '((speed 3 integer "How fast.")))
         (manifest-editor m))
  (check "and depends on nothing" '() (manifest-dependencies m))
  (check "optional v2 fields default to #f" '(#f #f #f #f)
         (list (manifest-version m) (manifest-techne m) (manifest-description m) (manifest-cloud m))))

(write-file! (at "worker" "app.scm") '(define handler #t))
(package! '(acme worker) '(cloud "app.scm"))
(check "cloud without bindings" (list (file-truename (at "worker" "app.scm")) '())
       (manifest-cloud (read-package-manifest (at "worker"))))

(package! '(acme plain))
(check "a package of libraries only" #f (manifest-editor (read-package-manifest (at "plain"))))
(check "no cloud entry" #f (manifest-cloud (read-package-manifest (at "plain"))))

(write-file! (at "broken" "entry.scm") '(define ok #t))
(write-file! (at "broken" "app.scm") '(define ok #t))
(for-each
 (lambda (case)
   (write-file! (at "broken" "techne-package.scm") (cdr case))
   (check (car case) #t (failed? (lambda () (read-package-manifest (at "broken"))))))
 '(("a 1-part package name" . (package broken))
   ("a 3-part package name" . (package (a b c)))
   ("an uppercase package name" . (package (Acme broken)))
   ("reserved scheme namespace" . (package (scheme broken)))
   ("reserved srfi namespace" . (package (srfi 999)))
   ("an unknown clause" . (package (acme broken) (license "MIT")))
   ("a clause twice" . (package (acme broken) (depends) (depends)))
   ("version given twice" . (package (acme broken) (version "0.1.0") (version "0.2.0")))
   ("empty version" . (package (acme broken) (version "")))
   ("non-numeric version" . (package (acme broken) (version "latest")))
   ("empty techne version" . (package (acme broken) (techne "")))
   ("non-string description" . (package (acme broken) (description 42)))
   ("empty description" . (package (acme broken) (description "")))
   ("an entry outside the package" . (package (acme broken) (editor "../editing/entry.scm" (commands (x "X.")))))
   ("an entry that is missing" . (package (acme broken) (editor "absent.scm" (commands (x "X.")))))
   ("no commands" . (package (acme broken) (editor "entry.scm" (commands))))
   ("a default its schema refuses" . (package (acme broken) (editor "entry.scm" (commands (x "X.")) (options (n "two" integer "N.")))))
   ("cloud entry missing" . (package (acme broken) (cloud "absent.scm")))
   ("cloud entry outside package" . (package (acme broken) (cloud "../editing/app.scm")))
   ("cloud unknown sub-clause" . (package (acme broken) (cloud "app.scm" (routes))))
   ("cloud duplicate bindings clause" . (package (acme broken) (cloud "app.scm" (bindings) (bindings))))
   ("cloud unknown binding kind" . (package (acme broken) (cloud "app.scm" (bindings (db postgres)))))
   ("cloud binding with value" . (package (acme broken) (cloud "app.scm" (bindings (api-key secret "hunter2")))))
   ("cloud duplicate binding name" . (package (acme broken) (cloud "app.scm" (bindings (x kv) (x text)))))
   ("a 1-part dependency" . (package (acme broken) (depends (alpha (path "../alpha")))))
   ("a reserved dependency" . (package (acme broken) (depends ((scheme base) (path "../alpha")))))
   ("an absolute dependency" . (package (acme broken) (depends ((acme alpha) (path "/alpha")))))
   ("itself as a dependency" . (package (acme broken) (depends ((acme broken) (path "../broken")))))
   ("a dependency twice" . (package (acme broken) (depends ((acme alpha) (path "../alpha")) ((acme alpha) (path "../other")))))))
(check "no manifest" #t (failed? (lambda () (read-package-manifest root))))

;; Using a package finds its libraries (both `(owner pkg)` and `(owner pkg sub)`)
;; and those of what it depends on, under their `lib` directories, and loads nothing.
(package! '(acme alpha))
(root-library! '(acme alpha) '(export alpha-root) '(import (scheme base))
               '(begin (define alpha-root 'from-root)))
(library! '(acme alpha) 'greet '(export greet loads) '(import (scheme base))
          '(begin (define loads (list 'loaded)) (define (greet who) (string-append "hello, " who))))
(package! '(acme beta) '(depends ((acme alpha) (path "../alpha"))))
(library! '(acme beta) 'twice '(export twice) '(import (scheme base) (acme alpha greet))
          '(begin (define (twice who) (string-append (greet who) " and " (greet who)))))
(package! '(acme gamma) '(depends ((acme beta) (path "../beta"))))
(check "before, nothing is found" #t (failed? (lambda () (eval '(import (acme beta twice))))))
(check "use returns the manifest" '(acme gamma) (manifest-name (use-package-directory! (at "gamma"))))
(check "the same one again" #t (eq? (use-package-directory! (at "gamma")) (use-package-directory! (at "gamma"))))
(check "its dependency's libraries" (file-truename (at "beta" "lib")) (%library-provider '(acme beta)))
(check "and that one's" (file-truename (at "alpha" "lib")) (%library-provider '(acme alpha)))
(check "a package without libraries owns its prefix too" (path-join (file-truename (at "gamma")) "lib")
       (%library-provider '(acme gamma)))
(define (loaded? name) (and (member name (loaded-modules)) #t))
(check "nothing was loaded" #f (loaded? "(acme alpha greet)"))
(import (acme alpha) (acme beta twice) (acme alpha greet))
(check "root library loaded" 'from-root alpha-root)
(check "an import loads it" #t (loaded? "(acme alpha greet)"))
(check "a library importing its dependency's" "hello, you and hello, you" (twice "you"))
;; One instance, whoever imports it.
(check "shared" #t (eq? loads (eval 'loads (environment '(acme alpha greet)))))

;; First-party `(techne pkg)` coexists beside Techne's stdlib `(techne ...)`,
;; while stdlib prefixes (loaded or unloaded) cannot be claimed.
(package! '(techne demo))
(library! '(techne demo) 'hi '(export hi) '(import (scheme base) (techne path))
          '(begin (define hi (path-join "a" "b"))))
(check "first-party techne package allowed" '(techne demo) (manifest-name (use-package-directory! (at "demo"))))
(check "first-party techne library works beside stdlib" "a/b" (eval 'hi (environment '(techne demo hi))))
(package! '(techne http))
(check "cannot claim unloaded stdlib (techne http)" #t (failed? (lambda () (use-package-directory! (at "http")))))
(package! '(techne package))
(check "cannot claim loaded stdlib (techne package)" #t (failed? (lambda () (use-package-directory! (at "package")))))

;; What a package provides is the world's, not a generation's: the package
;; reloaded or unloaded, the others keep the same library, and so does it.
(package! '(acme delta))
(library! '(acme delta) 'state '(export token) '(import (scheme base)) '(begin (define token (list 'instance))))
(write-file! (at "delta" "entry.scm") '(import (acme delta state)) '(define (mine) token))
(use-package-directory! (at "delta"))
(define (delta-token) ((eval 'mine (package-module (find-package '(acme delta))))))
(load-package '(acme delta) (at "delta" "entry.scm"))
(define first-token (delta-token))
(check "another importer shares it" #t (eq? first-token (eval 'token (environment '(acme delta state)))))
(load-package '(acme delta) (at "delta" "entry.scm"))
(check "the next generation keeps it" #t (eq? first-token (delta-token)))
(unload-package '(acme delta))
(check "unloaded, it is there still" #t (eq? first-token (eval 'token (environment '(acme delta state)))))

;; A 2-part prefix belongs to one directory: its libraries are found there only.
(write-file! (at "elsewhere" "acme" "alpha" "other.sld")
             '(define-library (acme alpha other) (export x) (import (scheme base)) (begin (define x 1))))
(write-file! (at "elsewhere" "main.scm") '(import (acme alpha other)))
(check "not beside the importer" "import: no library (acme alpha other)"
       (why (lambda () (load-package 'elsewhere (at "elsewhere" "main.scm")))))
(write-file! (at "copy" "alpha" "techne-package.scm") '(package (acme alpha)))
(check "not in another directory" #t (failed? (lambda () (use-package-directory! (at "copy" "alpha")))))

;; A set of packages that cannot be used leaves nothing of itself.
(package! '(acme lost) '(depends ((acme nowhere) (path "../nowhere"))))
(check "a dependency that is missing" #t (failed? (lambda () (use-package-directory! (at "lost")))))
(package! '(acme misnamed) '(depends ((acme delta) (path "../plain"))))
(check "a dependency of another name" #t (failed? (lambda () (use-package-directory! (at "misnamed")))))
(package! '(acme ring-a) '(depends ((acme ring-b) (path "../ring-b"))))
(package! '(acme ring-b) '(depends ((acme ring-a) (path "../ring-a"))))
(library! '(acme ring-a) 'x '(export x) '(import (scheme base)) '(begin (define x 1)))
(check "a circle" #t (failed? (lambda () (use-package-directory! (at "ring-a")))))
(check "provides nothing" #f (%library-provider '(acme ring-a)))
(package! '(acme ring-b))
(check "mended, it is used" '(acme ring-a) (manifest-name (use-package-directory! (at "ring-a"))))
(check "and provides" (file-truename (at "ring-a" "lib")) (%library-provider '(acme ring-a)))

;; Packages of one name in two directories, one depending on the other
;; through a third: the first is not made known yet when the second is met.
(package! '(acme twin) '(depends ((acme between) (path "../between"))))
(package! '(acme between) '(depends ((acme twin) (path "../far/twin"))))
(write-file! (at "far" "twin" "techne-package.scm") '(package (acme twin)))
(library! '(acme between) 'x '(export x) '(import (scheme base)) '(begin (define x 1)))
(check "a name met again below itself" #t
       (and (string-contains (or (why (lambda () (use-package-directory! (at "twin")))) "") "Another directory holds") #t))
(check "leaves nothing" #f (%library-provider '(acme between)))

;; What cannot be provided is found before anything changes: libraries
;; provided from elsewhere, loaded from elsewhere already, or a `lib` that
;; is no directory, each in the package another one depends on.
(define (left-whole? name dependency reason)
  (package! name `(depends (,dependency (path ,(string-append "../" (pkg-dir dependency))))))
  (library! name 'x '(export x) '(import (scheme base)) '(begin (define x 1)))
  (list (and (string-contains (or (why (lambda () (use-package-directory! (at (pkg-dir name))))) "") reason) #t)
        (%library-provider name)))
(make-directory (at "taken"))
(%provide-libraries! '(acme omega) (at "taken"))
(package! '(acme omega))
(library! '(acme omega) 'x '(export x) '(import (scheme base)) '(begin (define x 1)))
(check "libraries provided from elsewhere" '(#t #f) (left-whole? '(acme zeta) '(acme omega) "are provided from"))
(write-file! (at "loose" "acme" "early" "x.sld")
             '(define-library (acme early x) (export x) (import (scheme base)) (begin (define x 1))))
(write-file! (at "loose" "main.scm") '(import (acme early x)))
(load-package 'loose (at "loose" "main.scm"))
(package! '(acme early))
(library! '(acme early) 'x '(export x) '(import (scheme base)) '(begin (define x 2)))
(check "a library loaded from elsewhere" '(#t #f)
       (left-whole? '(acme eta) '(acme early) "library (acme early x) is loaded from elsewhere"))
(package! '(acme flat))
(write-file! (at "flat" "lib") 'not-a-directory)
(check "a lib that is no directory" '(#t #f) (left-whole? '(acme theta) '(acme flat) "is not a directory"))

;; A package's files import, of what packages provide, its own libraries
;; and those of the packages it depends on itself: not those further on
;; (even under the same owner!), loaded already or not, which are not run
;; for the attempt either.
(define (refused? thunk) (and (string-contains (or (why thunk) "") "does not depend on (acme alpha)") #t))
(library! '(acme alpha) 'fresh '(export fresh) '(import (scheme base)) '(begin (define fresh 1)))
(library! '(acme gamma) 'own '(export own) '(import (scheme base) (acme beta twice)) '(begin (define own (twice "me"))))
(write-file! (at "gamma" "direct.scm") '(import (acme beta twice) (acme gamma own)) '(define direct (list own (twice "a"))))
(write-file! (at "gamma" "beyond.scm") '(import (acme alpha greet)))
(write-file! (at "gamma" "unloaded.scm") '(import (only (acme alpha fresh) fresh)))
(check "what it depends on, and its own" 1 (load-package 'gamma-direct (at "gamma" "direct.scm")))
(check "not what that one depends on" #t (refused? (lambda () (load-package 'gamma-beyond (at "gamma" "beyond.scm")))))
(check "nor one not loaded yet" #t (refused? (lambda () (load-package 'gamma-unloaded (at "gamma" "unloaded.scm")))))
(check "which stays unloaded" #f (loaded? "(acme alpha fresh)"))
(check "a file in no package imports any" 1 (eval 'fresh (environment '(acme alpha fresh))))
(unload-package 'gamma-direct)

;; `package-closure` makes the checks of `use-package-directory!` without
;; making anything known; neither goes outside the directory it is given.
(package! '(acme inside) '(depends ((acme alpha) (path "../alpha"))))
(check "the packages to make known" '((acme inside)) (map manifest-name (package-closure (at "inside"))))
(check "not outside a repository" #t (failed? (lambda () (package-closure (at "inside") #:within (at "inside")))))
(check "nor used from there" #t (failed? (lambda () (use-package-directory! (at "inside") #:within (at "inside")))))
(check "within it" '(acme inside) (manifest-name (use-package-directory! (at "inside") #:within root)))
(check "known, there is nothing to make known" '() (package-closure (at "inside")))
;; One known already, and what it depends on, are held to it too.
(check "known, and outside" #t (failed? (lambda () (use-package-directory! (at "inside") #:within (at "inside")))))
(make-directory (at "repo"))
(write-file! (at "repo" "upper" "techne-package.scm") '(package (acme upper) (depends ((acme inside) (path "../../inside")))))
(write-file! (at "repo" "top" "techne-package.scm") '(package (acme top) (depends ((acme upper) (path "../upper")))))
(use-package-directory! (at "repo" "upper"))
(check "through a package known already" #t
       (and (string-contains (or (why (lambda () (use-package-directory! (at "repo" "top") #:within (at "repo")))) "")
                             "outside its repository")
            #t))
(check "which is not made known" #f (%library-provider '(acme top)))

;; The packages of a repository, side by side or deeper, by directory.
(check "a package's directory is its own" '("") (package-directories (at "alpha")))
(let ((found (package-directories root)))
  (check "side by side" #t (and (member "alpha" found) (member "beta" found) #t))
  (check "below a directory that is none" #t (and (member "copy/alpha" found) #t))
  (check "not a package's own files" #f (and (member "alpha/lib" found) #t)))

;; Cross-repo git dependencies (`github`, `git`, `local`) and root `override`.
(let ((oid "0123456789abcdef0123456789abcdef01234567"))
  (package! '(acme remote-app)
            '(version "0.2.0")
            `(depends
               ((acme alpha) (path "../alpha"))
               ((bob util) (github "bob/util" (tag "v1.0")))
               ((carol mono) (github "carol/mono" (package (carol mono)) (branch "main")))
               ((dave lib) (git "https://example.org/dave/lib.git" (commit ,oid)))
               ((erin local-lib) (local "/tmp/erin-repo" (tag "release/v2") (package (erin local-lib)))))
            '(override
               ((bob util) (path "../alpha"))
               ((dave lib) (local "/tmp/dave-fork" (branch "fix")))))
  (let ((m (read-package-manifest (at "remote-app"))))
    (check "manifest-dependency-sources preserves all sources"
           `(((acme alpha) . (path "../alpha"))
             ((bob util) . (github "bob/util" (tag "v1.0")))
             ((carol mono) . (github "carol/mono" (package (carol mono)) (branch "main")))
             ((dave lib) . (git "https://example.org/dave/lib.git" (commit ,oid)))
             ((erin local-lib) . (local "/tmp/erin-repo" (tag "release/v2") (package (erin local-lib)))))
           (manifest-dependency-sources m))
    (check "manifest-overrides returns override alist"
           '(((bob util) . (path "../alpha"))
             ((dave lib) . (local "/tmp/dave-fork" (branch "fix"))))
           (manifest-overrides m))
    (check "use-package-directory! refuses unlocked git dep cleanly" #t
           (and (string-contains (or (why (lambda () (use-package-directory! (at "remote-app")))) "") "techne.lock") #t))))

(for-each
 (lambda (case)
   (write-file! (at "broken" "techne-package.scm") (cdr case))
   (check (car case) #t (failed? (lambda () (read-package-manifest (at "broken"))))))
 '(("unknown dependency source" . (package (acme broken) (depends ((bob x) (http "https://example.org/x")))))
   ("github bad owner/repo" . (package (acme broken) (depends ((bob x) (github "only-one")))))
   ("github traversal" . (package (acme broken) (depends ((bob x) (github "../x")))))
   ("git non-https" . (package (acme broken) (depends ((bob x) (git "http://example.org/x.git")))))
   ("local relative path" . (package (acme broken) (depends ((bob x) (local "../repo")))))
   ("path extra clause" . (package (acme broken) (depends ((bob x) (path "../x" (tag "v1"))))))
   ("two ref selectors" . (package (acme broken) (depends ((bob x) (github "bob/x" (tag "v1") (branch "main"))))))
   ("empty tag selector" . (package (acme broken) (depends ((bob x) (github "bob/x" (tag ""))))))
   ("short commit sha" . (package (acme broken) (depends ((bob x) (github "bob/x" (commit "deadbeef"))))))
   ("unknown ref clause" . (package (acme broken) (depends ((bob x) (github "bob/x" (rev "v1"))))))
   ("mismatched package selector" . (package (acme broken) (depends ((bob x) (github "bob/mono" (package (bob y)))))))
   ("two package selectors" . (package (acme broken) (depends ((bob x) (github "bob/mono" (package (bob x)) (package (bob x)))))))
   ("override twice" . (package (acme broken) (override) (override)))
   ("override self" . (package (acme broken) (override ((acme broken) (path "../other")))))
   ("duplicate override" . (package (acme broken) (override ((bob x) (path "../a")) ((bob x) (path "../b")))))
   ("invalid override source" . (package (acme broken) (override ((bob x) (git "file:///tmp/repo")))))))

;; Canonical `directory-tree-sha256` / `package-tree-sha256`.
(make-directory (at "hash-empty"))
(check "empty tree hash is sha-256 of empty stream"
       (hex-encode (sha-256 ""))
       (package-tree-sha256 (at "hash-empty")))

(make-directory (at "hash-tree" "sub"))
(make-directory (at "hash-tree" ".git"))
(make-directory (at "hash-tree" ".jj"))
(call-with-output-file (at "hash-tree" "a.txt") (lambda (p) (display "abc" p)))
(let ((p (open-binary-output-file (at "hash-tree" "sub" "b.bin"))))
  (write-bytevector #u8(0 1 255 2) p)
  (close-output-port p))
;; Hidden files and directories are excluded.
(call-with-output-file (at "hash-tree" ".DS_Store") (lambda (p) (display "junk" p)))
(call-with-output-file (at "hash-tree" ".secrets.scm") (lambda (p) (display "secret" p)))
(call-with-output-file (at "hash-tree" ".git" "HEAD") (lambda (p) (display "ref: refs/heads/main\n" p)))
(call-with-output-file (at "hash-tree" ".jj" "repo") (lambda (p) (display "jj" p)))
(call-with-output-file (at "hash-tree" "sub" ".hidden") (lambda (p) (display "hidden" p)))
(let ((expected-stream (open-output-bytevector)))
  (write-bytevector (string->utf8 "F a.txt") expected-stream)
  (write-u8 0 expected-stream)
  (write-bytevector (string->utf8 "3") expected-stream)
  (write-u8 0 expected-stream)
  (write-bytevector (string->utf8 "abc") expected-stream)
  (write-u8 10 expected-stream)
  (write-bytevector (string->utf8 "F sub/b.bin") expected-stream)
  (write-u8 0 expected-stream)
  (write-bytevector (string->utf8 "4") expected-stream)
  (write-u8 0 expected-stream)
  (write-bytevector #u8(0 1 255 2) expected-stream)
  (write-u8 10 expected-stream)
  (let ((expected (hex-encode (sha-256 (get-output-bytevector expected-stream))))
        (got (package-tree-sha256 (at "hash-tree"))))
    (check "canonical tree-sha256 exact match" expected got)
    (check "64 lowercase hex chars" 64 (string-length got))
    (check "directory-tree-sha256 agrees" got (directory-tree-sha256 (at "hash-tree")))))
(check "non-directory rejected" #t (failed? (lambda () (package-tree-sha256 (at "hash-tree" "a.txt")))))

(delete-path root #t)
(test-summary)
