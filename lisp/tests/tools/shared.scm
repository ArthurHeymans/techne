;;; Mutable replies, shared parser declarations and explicit snapshot origin.
(require "support.scm")
(import (techne tools) (techne source) (techne languages))

(with-tool-project "replies do not expose mutable cache or project state" '(("source" "abc\n"))
  (lambda (root p)
    (define original-root (tool-root p))
    (define root-copy (tool-root p))
    (string-set! root-copy 0 #\X)
    (expect original-root (tool-root p))
    (define files (tool-files p))
    (string-set! (car (tool-ref files 'items)) 0 #\X)
    (expect '("source") (tool-ref (tool-files p) 'items))
    (define r (tool-read p "source"))
    (define revision (string-copy (tool-ref r 'revision)))
    (string-set! (tool-ref r 'path) 0 #\X)
    (string-set! (tool-ref r 'revision) 0 #\X)
    (string-set! (tool-ref r 'text) 0 #\X)
    (expect revision (tool-ref (tool-read p "source") 'revision))
    (expect "abc\n" (tool-ref (tool-expand p (tool-ref r 'handle)) 'text))))

(with-tool-project "headless queries share language declarations and Unicode coordinates"
  '(("source.py" "class Thing:\n    def method(self): pass\ndef outside(): pass\n")
    ("unicode.rs" "// λ\nfn café() {}\n"))
  (lambda (root p)
    (expect 'python (language-value (source-language "source.py") 'grammar))
    (expect 3 (tool-ref (tool-symbols p "source.py") 'total))
    (expect "member" (tool-ref (car (tool-ref (tool-symbols p "source.py" #:name "method") 'items)) 'scope))
    (expect "fn café() {}" (tool-ref (tool-read-symbol p "unicode.rs" "café") 'text))
    (define tree (source-parse "rust" "// λ\nfn café() {}\n"))
    (expect #t (source-complete? tree))
    (define cs (tool-ref (source-query tree "(function_item) @definition") 'items))
    (expect '("definition" 5 17) (car cs))
    (expect "fn café() {}" (source-text tree 5 17))
    (expect "source_file" (car (source-parent tree (source-node tree 5 17))))
    (expect #t (fails (lambda () (source-node tree 4 1))))
    (expect #t (fails (lambda () (source-text tree 0 100))))))

(with-tool-project "expansion EOF, library names, coordinates and source origin"
  '(("line" "needle\n") ("pages" "é one\n\nthree\nlast") ("empty" "") ("blank" "\n")
    ("inline.rs" "fn one() {} fn two() {}\n") ("library.sld" "(define-library (example\n  names) (export))"))
  (lambda (root p)
    (define (source-head r)
      (string-append "[snapshot file-lines: " (number->string (tool-ref r 'file-lines))
        "; " (call-with-output-string (lambda (port) (write (tool-ref r 'path) port)))
        "; revision " (tool-ref r 'revision) "]"))
    (define r (tool-read p "line"))
    (expect 2 (tool-ref (tool-expand p (tool-ref r 'handle) #:offset 7) 'line))
    (expect "" (tool-ref (tool-expand p (tool-ref r 'handle) #:offset 7) 'text))
    (expect "(example names)" (tool-ref (car (tool-ref (tool-symbols p "library.sld") 'items)) 'name))
    (define first (tool-read p "pages" #:lines 1))
    (expect '(#t #f 4 2 6)
      (map (lambda (key) (tool-ref first key)) '(region-complete file-eof file-lines next-line characters)))
    (expect "é one\n" (tool-ref (tool-expand p (tool-ref first 'handle)) 'text))
    (expect (string-append (source-head first) "\n1: é one\n[region complete; more file lines: (tool-read project \"pages\" #:from 2)]")
      (tool-show first #:numbered #t))
    (define clipped (tool-read p "pages" #:lines 1 #:chars 1))
    (expect '(#f #f #f 1)
      (map (lambda (key) (tool-ref clipped key)) '(region-complete file-eof next-line next)))
    (define rest (tool-expand p (tool-ref clipped 'handle) #:offset (tool-ref clipped 'next)))
    (expect " one\n" (tool-ref rest 'text))
    (expect '(#t #f 2) (map (lambda (key) (tool-ref rest key)) '(region-complete file-eof next-line)))
    (expect #t (string-prefix? (string-append (source-head clipped) "\n1: é\n[truncated region:") (tool-show clipped #:numbered #t)))
    (define middle (tool-read p "pages" #:from (tool-ref rest 'next-line) #:lines 2))
    (expect "\nthree\n" (tool-ref middle 'text))
    (expect 4 (tool-ref middle 'next-line))
    (expect #t (string-prefix? (string-append (source-head middle) "\n2: \n3: three\n") (tool-show middle #:numbered #t)))
    (define last (tool-read p "pages" #:from (tool-ref middle 'next-line)))
    (expect '(#t #t #f) (map (lambda (key) (tool-ref last key)) '(region-complete file-eof next-line)))
    (expect (string-append (source-head last) "\n4: last") (tool-show last))
    (expect "last" (tool-show last #:numbered #f))
    (expect (string-append (source-head last) "\n4: last") (tool-show (tool-batch (list (lambda () last)))))
    (expect '(1 #t #t #f)
      (map (lambda (key) (tool-ref (tool-read p "empty") key)) '(file-lines region-complete file-eof next-line)))
    (define blank (tool-read p "blank"))
    (expect (string-append (source-head blank) "\n1: ") (tool-show blank))
    (expect (source-head r) (tool-show (tool-expand p (tool-ref r 'handle) #:offset 7)))
    (define empty (tool-read p "empty"))
    (expect (source-head empty) (tool-show empty))
    (define definition (tool-read-symbol p "inline.rs" "one"))
    (expect '(#t #f #f) (map (lambda (key) (tool-ref definition key)) '(region-complete file-eof next-line)))
    (define range-error (guard (e (#t (condition/report-string e))) (tool-files p #:limit 100)))
    (expect #t (and (string-contains range-error "expected 1 to 50") #t))
    ;; A window wider than its bound is the bound, with its continuation.
    (fixture-write root "tall" (apply string-append (map (lambda (i) "x\n") (iota 250))))
    (define tall (tool-read p "tall" #:lines 1000))
    (expect '(#t #f 201) (map (lambda (key) (tool-ref tall key)) '(region-complete file-eof next-line)))
    (expect 201 (tool-ref (tool-lines p (tool-ref tall 'handle) #:from 1 #:lines 1000) 'next-line))
    (expect #t (fails (lambda () (tool-read p "tall" #:lines 0))))
    (fixture-write root "pages" "changed")
    (define old (tool-expand p (tool-ref first 'handle)))
    (expect '(4 #f 2) (map (lambda (key) (tool-ref old key)) '(file-lines file-eof next-line)))
    (expect (source-head first) (source-head old))
    (expect #t (and (string-contains (tool-show old) (tool-ref first 'revision)) #t))
    (expect '(1 #t #f)
      (map (lambda (key) (tool-ref (tool-read p "pages") key)) '(file-lines file-eof next-line)))
    ;; Deliberately use sh: its output label must collide with a REAL filename.
    (fixture-write root "<stdout of sh>" "actual\nfile\n")
    (define job (tool-run p "sh" '("-c" "printf 'a\\nb\\n'") #:keep 100))
    (define output (tool-process-result job))
    (define h (tool-ref (tool-ref output 'stdout) 'handle))
    (define output-line (tool-lines p h #:from 1 #:lines 1))
    (expect '(#t #f #f #f)
      (map (lambda (key) (tool-ref output-line key)) '(region-complete file-lines file-eof next-line)))
    (expect "<stdout of sh>:1: a" (tool-show output-line #:numbered #t))
    (expect '(2 2 #f)
      (map (lambda (key) (tool-ref (tool-read p "<stdout of sh>" #:lines 1) key)) '(file-lines next-line file-eof)))))
