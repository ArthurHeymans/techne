;;; Exercise the public process tools with real children and fresh project directories.
(require "support.scm")
(import (techne tools))

(with-tool-project "retained output handles" (quote ())
  (lambda (root p)
    (define job (tool-run p "sh" '("-c" "seq 1 3000; echo oops >&2") #:retain 5 #:keep 100000))
    (define r (tool-process-result job))
    (define out (tool-ref r 'stdout))
    (expect (tool-ref out 'characters) (tool-ref out 'kept))
    (define hits (tool-find p (tool-ref out 'handle) "2999"))
    (expect 2999 (tool-ref (car (tool-ref hits 'items)) 'line))
    (expect "2998\n2999\n3000\n" (tool-ref (tool-lines p (tool-ref out 'handle) #:from 2998 #:lines 5) 'text))
    (expect #t (fails (lambda () (tool-lines p (tool-ref out 'handle) #:from 3002))))
    (define hit (tool-ref (car (tool-ref hits 'items)) 'handle))
    (expect "2999\n" (tool-ref (tool-lines p hit #:from 2990 #:lines 20) 'text))
    (expect "3000" (substring (tool-ref (tool-expand p (tool-ref out 'handle) #:offset (- (tool-ref out 'kept) 5)) 'text) 0 4))
    ;; The report is made once: the same handles each time.
    (expect (tool-ref out 'handle) (tool-ref (tool-ref (tool-process-result job) 'stdout) 'handle))
    (expect "oops\n" (tool-ref (tool-expand p (tool-ref (tool-ref r 'stderr) 'handle)) 'text))
    (define again (tool-process-result (tool-run p "sh" '("-c" "printf abcdef") #:keep 3)))
    (expect 3 (tool-ref (tool-ref again 'stdout) 'kept))
    (expect "abc" (tool-ref (tool-expand p (tool-ref (tool-ref again 'stdout) 'handle)) 'text))
    (expect #f (tool-ref (tool-ref (tool-process-result (tool-run p "true" '())) 'stdout) 'handle))
    (expect #t (fails (lambda () (tool-run p "true" '() #:keep 0))))
    (expect #t (fails (lambda () (tool-run p "true" '() #:keep 1048577))))
    ;; Both streams at their limit of four-byte characters keep both handles.
    (define wide (tool-process-result
                   (tool-run p "sh" '("-c" "s=😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀; s=$s$s$s$s$s$s$s$s; s=$s$s$s$s$s$s$s$s; s=$s$s$s$s$s$s$s$s; s=$s$s$s$s$s$s$s$s; s=$s$s$s$s$s$s$s$s; s=$s$s; printf %s $s; printf %s $s >&2")
                             #:keep 1048576)))
    (expect 1048576 (tool-ref (tool-ref wide 'stdout) 'kept))
    (expect "😀" (tool-ref (tool-expand p (tool-ref (tool-ref wide 'stdout) 'handle) #:chars 1) 'text))
    (expect "😀" (tool-ref (tool-expand p (tool-ref (tool-ref wide 'stderr) 'handle) #:chars 1) 'text))
    (expect #t (string-prefix? "status 0\n--- stdout (6 characters, last 3 shown; all 3 kept: \""
                              (tool-show (tool-process-result (tool-run p "printf" '("abcdef") #:retain 3 #:keep 3)))))
    (expect "a\nb" (tool-show (list "a" 'b)))
    (expect "x" (tool-show (tool-batch (list (lambda () "x")))))))

(with-tool-project "timeout, wait and check" (quote ())
  (lambda (root p)
    (define slow (tool-process-result (tool-run p "sh" '("-c" "echo start; sleep 30; echo never") #:timeout 0.5)))
    (expect #t (tool-ref slow 'timed-out))
    (expect #f (tool-ref slow 'running))
    (expect "start\n" (tool-ref (tool-ref slow 'stdout) 'text))
    (expect #t (string-prefix? "timed out, killed" (tool-show slow)))
    (define job (tool-run p "sh" '("-c" "echo one; sleep 2; echo two")))
    (define early (tool-process-result job #:wait 0.5))
    (expect #t (tool-ref early 'running))
    (expect #f (tool-ref early 'status))
    (expect "one\n" (tool-ref (tool-ref early 'stdout) 'text))
    (expect #t (string-prefix? "running" (tool-show early)))
    (define late (tool-process-result job))
    (expect '(#f 0 #f) (list (tool-ref late 'running) (tool-ref late 'status) (tool-ref late 'timed-out)))
    (expect "one\ntwo\n" (tool-ref (tool-ref late 'stdout) 'text))
    (expect #t (fails (lambda () (tool-run p "true" '() #:timeout 0))))
    (expect #t (fails (lambda () (tool-run p "true" '() #:timeout 86401))))
    (expect #t (fails (lambda () (tool-process-result job #:wait -1))))

    (define c (tool-check p "sh" '("-c" "echo ok; echo error: bad; echo after; echo error: bad >&2; exit 2") #:context 1))
    (expect 2 (tool-ref c 'status))
    (expect 2 (tool-ref (tool-ref c 'hits) 'total))
    (define first (car (tool-ref (tool-ref c 'hits) 'items)))
    (expect '(2 "error: bad\nafter\n") (list (tool-ref first 'line) (tool-ref first 'text)))
    (expect "<stderr of sh>" (tool-ref (cadr (tool-ref (tool-ref c 'hits) 'items)) 'path))
    (expect "after\n" (tool-ref (tool-lines p (tool-ref (tool-ref c 'stdout) 'handle) #:from 3) 'text))
    (define quiet (tool-check p "sh" '("-c" "echo nothing; exit 1")))
    (expect '(1 0 "nothing\n") (list (tool-ref quiet 'status) (tool-ref (tool-ref quiet 'hits) 'total) (tool-ref (tool-ref quiet 'stdout) 'tail)))
    (expect #t (and (string-contains (tool-show quiet) "nothing matched") #t))
    (define one (tool-ref (tool-check p "sh" '("-c" "echo a; echo ab; echo b") #:find '("a" "b") #:limit 2) 'hits))
    (expect '(3 2 #t #f) (list (tool-ref one 'total) (length (tool-ref one 'items)) (tool-ref one 'truncated) (tool-ref one 'next)))
    (expect #t (tool-ref (tool-check p "sleep" '("30") #:timeout 0.3) 'timed-out))
    (expect #t (fails (lambda () (tool-check p "true" '() #:context 41))))
    (expect #t (fails (lambda () (tool-check p "true" '() #:find '("")))))
    (expect #t (string? (tool-stamp)))
    (expect (tool-stamp) (tool-stamp #:now #t))
    ;; Its leader gone, what it started still holds its streams: killed at the deadline.
    (define start (current-milliseconds))
    (define orphaned (tool-process-result (tool-run p "sh" '("-c" "sleep 20 & exit 0") #:timeout 0.3)))
    (expect #t (tool-ref orphaned 'timed-out))
    (expect #t (< (- (current-milliseconds) start) 10000))
    ;; Every matching line counted, past a page of fifty.
    (define many (tool-check p "sh" '("-c" "i=0; while [ $i -lt 60 ]; do echo error: $i; i=$((i+1)); done") #:limit 5))
    (expect '(60 5 #t #t) (list (tool-ref (tool-ref many 'hits) 'total) (length (tool-ref (tool-ref many 'hits) 'items))
                               (tool-ref (tool-ref many 'hits) 'truncated) (tool-ref (tool-ref many 'hits) 'complete)))
    ;; Output past what is kept: searched no further, and said.
    (define long (tool-check p "sh" '("-c" "head -c 1100000 /dev/zero | tr '\\0' x; echo; echo error: late")))
    (expect '(#t #f 0) (list (tool-ref long 'lost) (tool-ref (tool-ref long 'hits) 'complete) (tool-ref (tool-ref long 'hits) 'total)))
    (expect #t (and (string-contains (tool-ref (tool-ref long 'stdout) 'tail) "error: late") #t))
    ;; A hit past context clipped short is an item of its own.
    (define wide (tool-check p "sh" '("-c" "echo error: one; head -c 17000 /dev/zero | tr '\\0' x; echo; echo error: two") #:context 3))
    (expect 2 (length (tool-ref (tool-ref wide 'hits) 'items)))
    (expect #t (tool-ref (car (tool-ref (tool-ref wide 'hits) 'items)) 'context-truncated))
    (expect "error: two\n" (tool-ref (cadr (tool-ref (tool-ref wide 'hits) 'items)) 'text))
    ;; The second error in no item: truncated, though context was asked.
    (define first-only (tool-check p "sh" '("-c" "echo error: one; head -c 17000 /dev/zero | tr '\\0' x; echo; echo error: two") #:context 3 #:limit 1))
    (expect '(1 2 #t) (list (length (tool-ref (tool-ref first-only 'hits) 'items)) (tool-ref (tool-ref first-only 'hits) 'total)
                           (tool-ref (tool-ref first-only 'hits) 'truncated)))
    ;; Many matching lines, many patterns: one pass, each line once.
    (define dense (tool-check p "sh" '("-c" "i=0; while [ $i -lt 3000 ]; do echo error: warning: FAILED $i; i=$((i+1)); done") #:limit 3))
    (expect '(3000 3 #t) (list (tool-ref (tool-ref dense 'hits) 'total) (length (tool-ref (tool-ref dense 'hits) 'items))
                              (tool-ref (tool-ref dense 'hits) 'truncated)))))

(with-tool-project "concurrent drains and cancellation" (quote ())
  (lambda (root p)
    (define job (tool-run p "sh" '("-c" "i=0; while [ $i -lt 12000 ]; do printf abcdefghijklmnopqrstuvwxyz; printf ABCDEFGHIJKLMNOPQRSTUVWXYZ >&2; i=$((i+1)); done; exit 7") #:retain 100))
    (define result (tool-process-result job #:chars 20))
    (expect 7 (tool-ref result 'status))
    (expect #t (tool-process-done? job))
    (expect #t (tool-ref (tool-ref result 'stdout) 'truncated))
    (expect #t (tool-ref (tool-ref result 'stderr) 'truncated))
    (expect 312000 (tool-ref (tool-ref result 'stdout) 'characters))
    (expect 312000 (tool-ref (tool-ref result 'stderr) 'characters))
    (expect 20 (string-length (tool-ref (tool-ref result 'stdout) 'text)))
    (expect result (tool-process-result job #:chars 20))
    (expect #t (fails (lambda () (tool-run p "sh" '() #:retain 0))))
    (define small (tool-process-result (tool-run p "sh" (quote ("-c" "printf abcdef")) #:retain 3) #:chars 20))
    (expect "def" (tool-ref (tool-ref small (quote stdout)) (quote text)))
    (expect #t (tool-ref (tool-ref small (quote stdout)) (quote truncated)))
    (define sleeper (tool-run p "sh" '("-c" "sleep 300")))
    (define cancelled (tool-process-cancel! sleeper))
    (expect #t (tool-process-done? sleeper))
    (expect #t (pair? (tool-ref cancelled 'status)))))

(with-tool-project "retention versus report clipping" (quote ())
  (lambda (root p)
    (define (run retain chars)
      (tool-ref (tool-process-result (tool-run p "printf" '("abcdef") #:retain retain) #:chars chars) 'stdout))
    (define a (run 3 20))
    (expect '(6 3 #t #f #t) (map (lambda (key) (tool-ref a key)) '(characters retained dropped clipped truncated)))
    (expect "def" (tool-ref a 'text))
    (define b (run 20 3))
    (expect '(6 6 #f #t #t) (map (lambda (key) (tool-ref b key)) '(characters retained dropped clipped truncated)))
    (define c (run 6 6))
    (expect '(6 6 #f #f #f) (map (lambda (key) (tool-ref c key)) '(characters retained dropped clipped truncated)))
    (define d (run 3 2))
    (expect '(6 3 #t #t #t) (map (lambda (key) (tool-ref d key)) '(characters retained dropped clipped truncated)))))

(with-tool-project "process environments" (quote ())
  (lambda (root p)
    (for-each
      (lambda (environment)
        (let ((message (guard (e (#t (error-object-message e)))
                         (tool-run p "true" '() #:environment environment) "missing error")))
          (expect #t (string-prefix? "tool-run: environment must be" message))
          (expect #f (and (string-contains message "sensitive-value") #t))))
      (list '(("BAD")) '(("NAME" "sensitive-value")) '(("" . "sensitive-value"))
            '(("A=B" . "sensitive-value")) (list (cons "NAME" (string (integer->char 0)))) 'not-a-list))
    (expect 0 (tool-ref (tool-process-result
      (tool-run p "true" '() #:environment '(("TECHNE_AGENT_ROUND2" . "yes")))) 'status))))
