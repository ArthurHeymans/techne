;;; Citation bounds are not semantic support; revisions belong to the read.
(require "support.scm")
(import (techne tools))

(with-tool-project "citation bounds and invalid arguments"
  '(("doc" "one\né two\n") ("empty" "") ("binary" #u8(255)))
  (lambda (root p)
    (define c (tool-cite p "doc" #:from 1 #:to 2))
    (expect '(citation #t #f 2 "doc:1-2")
      (map (lambda (k) (tool-ref c k)) '(kind valid reason file-lines citation)))
    (expect "doc:2" (tool-ref (tool-cite p "doc" #:from 2) 'citation))
    (expect #t (and (string-contains (tool-show c) "claim support not checked") #t))
    (define bad (tool-cite p "doc" #:from 110 #:to 118))
    (expect '(#f past-end 2 #f)
      (map (lambda (k) (tool-ref bad k)) '(valid reason file-lines citation)))
    (expect #t (and (string-contains (tool-show bad) "snapshot file-lines 2") #t))
    (expect #t (tool-ref (tool-cite p "empty") 'valid))
    (expect #t (fails (lambda () (tool-cite p "doc" #:from 0))))
    (expect #t (fails (lambda () (tool-cite p "doc" #:from 2 #:to 1))))
    (expect #t (fails (lambda () (tool-cite p "doc" #:from 1.5))))
    (expect #t (fails (lambda () (tool-cite p "doc" #:to 2147483648))))
    (expect #t (fails (lambda () (tool-cite p "doc" #:revision 'bad))))
    (expect #t (fails (lambda () (tool-cite p "binary"))))
    (expect #t (fails (lambda () (tool-cite p "absent"))))
    (expect #t (fails (lambda () (tool-cite p "../outside"))))))

(with-tool-project "current citation versus immutable old view" '(("doc" "one\ntwo\n"))
  (lambda (root p)
    (define old (tool-read p "doc"))
    (define rev (tool-ref old 'revision))
    (expect #t (tool-ref (tool-cite p "doc" #:to 2 #:revision rev) 'valid))
    (expect (string-append "[snapshot file-lines: 2; \"doc\"; revision " rev "]\n1: one\n2: two") (tool-show old))
    (expect "one\ntwo" (tool-show old #:numbered #f))
    (fixture-write root "doc" "changed")
    (define stale (tool-cite p "doc" #:to 2 #:revision rev))
    (expect '(#f stale-revision 1)
      (map (lambda (k) (tool-ref stale k)) '(valid reason file-lines)))
    (expect #f (tool-ref (tool-cite p "doc" #:from 2) 'valid))
    (expect #t (tool-ref (tool-cite p "doc") 'valid))
    (expect #t (string-prefix? "[snapshot file-lines: 2;" (tool-show old)))
    (expect #t (and (string-contains (tool-show (tool-expand p (tool-ref old 'handle))) rev) #t))
    (expect #t (string-prefix? "[snapshot file-lines: 1;" (tool-show (tool-read p "doc"))))))

(with-tool-project "citation checks do not evict or expose cached strings" '(("doc" "original"))
  (lambda (root p)
    (do ((i 0 (+ i 1))) ((= i 130))
      (fixture-write root (string-append "c" (number->string i)) "note\n"))
    (define r (tool-read p "doc"))
    (do ((i 0 (+ i 1))) ((= i 130))
      (expect #t (tool-ref (tool-cite p (string-append "c" (number->string i))) 'valid)))
    (expect "original" (tool-ref (tool-expand p (tool-ref r 'handle)) 'text))
    (define path "doc")
    (define c (tool-cite p path))
    (string-set! (tool-ref c 'path) 0 #\X)
    (string-set! (tool-ref c 'revision) 0 #\X)
    (expect "doc" path)
    (expect "doc:1" (tool-ref (tool-cite p "doc") 'citation))
    (expect (tool-ref r 'revision) (tool-ref (tool-cite p "doc") 'revision))))
