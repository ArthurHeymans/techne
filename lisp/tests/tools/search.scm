;;; Bounded contexts, matching-line counts and literal query diagnostics.
(require "support.scm")
(import (techne tools))

(with-tool-project "grouped counts page files, not matching lines"
  '(("a" "top\né needle\n\nneedle tail\nlast\n") ("b" "needle needle\nend\n")
    ("empty" "") ("binary" #u8(255 110 101 101 100 108 101 10)))
  (lambda (root p)
    (define counts (tool-search p "needle" #:group-by 'path #:limit 1))
    (expect '(3 2 matching-lines #t #t 1 1)
      (map (lambda (k) (tool-ref counts k)) '(total files unit complete truncated next binary)))
    (expect '(("a" 2))
      (map (lambda (i) (list (tool-ref i 'path) (tool-ref i 'count))) (tool-ref counts 'items)))
    (expect #f (tool-ref (car (tool-ref counts 'items)) 'handle))
    (expect #t (and (string-contains (tool-show counts) "1 of 2; more with #:offset 1") #t))
    (expect #t (and (string-contains (tool-show counts) "3 matching lines in 2 files") #t))
    (define second (tool-search p "needle" #:group-by 'path #:offset (tool-ref counts 'next)))
    (expect '(3 2 #f #f) (map (lambda (k) (tool-ref second k)) '(total files next truncated)))
    (expect "b: 1 matching line\n[3 matching lines in 2 files]" (tool-show second))
    (expect '() (tool-ref (tool-search p "needle" #:group-by 'path #:offset 100) 'items))
    (define none (tool-search p "absent" #:group-by 'path))
    (expect '(0 0 #t #f) (map (lambda (k) (tool-ref none k)) '(total files complete next)))
    (string-set! (tool-ref (car (tool-ref counts 'items)) 'path) 0 #\X)
    (expect "a" (tool-ref (car (tool-ref (tool-search p "needle" #:group-by 'path) 'items)) 'path))))

(with-tool-project "Unicode contexts preserve immutable hit handles"
  (list (list "a" "top\né needle\n\nneedle tail\nlast\n") (list "b" "needle needle\nend\n")
        (list "long" (string-append (make-string 300 #\é) "needle\n")))
  (lambda (root p)
    (define plain (tool-search p "needle" #:prefix "a"))
    (expect #f (tool-ref (car (tool-ref plain 'items)) 'context-handle))
    (define found (tool-search p "needle" #:prefix "a" #:before 1 #:after 1))
    (define hit (car (tool-ref found 'items)))
    (define context (tool-ref hit 'context))
    (define h (tool-ref hit 'context-handle))
    (expect '(2 3 9)
      (list (tool-ref hit 'line) (tool-ref hit 'column) (tool-ref (tool-expand p (tool-ref hit 'handle)) 'characters)))
    (expect "é needle\n" (tool-ref (tool-expand p (tool-ref hit 'handle)) 'text))
    (expect "top\né needle\n\n" (tool-ref context 'text))
    (expect (tool-ref hit 'revision) (tool-ref context 'revision))
    ;; More context than the bound is the bound's, not an error.
    (expect "top\né needle\n\nneedle tail\nlast\n"
      (tool-ref (tool-ref (car (tool-ref (tool-search p "needle" #:prefix "a" #:before 99 #:after 99) 'items)) 'context) 'text))
    (expect #f (tool-ref found 'context-truncated))
    (expect #t (and (string-contains (tool-show found) "]\n1: top\n2: é needle\n3: ") #t))
    (expect #t (and (string-contains (tool-show found) (tool-ref context 'revision)) #t))
    (expect #t (and (string-contains (tool-show found) "; \"a\"; revision ") #t))
    (expect #f (and (string-contains (tool-show found) "more file lines") #t))
    (expect "" (tool-ref (tool-expand p h #:offset 14) 'text))
    (expect #t (fails (lambda () (tool-expand p h #:offset 15))))
    (define clipped (tool-search p "needle" #:before 1 #:after 1 #:chars 2))
    (expect 2 (tool-ref clipped 'context-characters))
    (expect #t (tool-ref clipped 'context-truncated))
    (expect "to" (tool-ref (tool-ref (car (tool-ref clipped 'items)) 'context) 'text))
    (expect #f (tool-ref (cadr (tool-ref clipped 'items)) 'context))
    (expect #t (and (string-contains (tool-show clipped) "context omitted") #t))
    (expect #t (and (string-contains (tool-show clipped) "context clipped") #t))
    (define wide (tool-search p "needle" #:prefix "long" #:before 1 #:chars 1))
    (define wide-hit (car (tool-ref wide 'items)))
    (expect 301 (tool-ref wide-hit 'column))
    (expect "é" (tool-ref (tool-ref wide-hit 'context) 'text))
    (expect 307 (tool-ref (tool-ref wide-hit 'context) 'characters))
    (string-set! (tool-ref context 'text) 0 #\X)
    (expect "top\né needle\n\n" (tool-ref (tool-expand p h) 'text))
    (fixture-write root "a" "changed")
    (expect "top\né needle\n\n" (tool-ref (tool-expand p h) 'text))))

(with-tool-project "invalid search options are actionable" '()
  (lambda (root p)
    (for-each (lambda (query) (expect #t (fails query)))
      (list (lambda () (tool-search p "x" #:before -1))
            (lambda () (tool-search p "x" #:after 1.5))
            (lambda () (tool-search p "x" #:chars 0))
            (lambda () (tool-search p "x" #:group-by 'unknown))
            (lambda () (tool-search p "x" #:group-by 'path #:after 1))))))

(with-tool-project "incomplete counts are not full-repository totals"
  (list (list "a" "needle\n") (list "huge" (make-bytevector 1048577 120)))
  (lambda (root p)
    (define partial (tool-search p "needle" #:group-by 'path))
    (expect '(1 1 #f #t 1) (map (lambda (k) (tool-ref partial k)) '(total files complete truncated skipped)))
    (expect #t (and (string-contains (tool-show partial) "incomplete: skipped 1") #t))))

(with-tool-project "zero hits diagnose literal semantics without reinterpreting input"
  (list (list "data" "alpha\nbeta\n") (list "pipes" "alpha|beta\n") (list "huge" (make-bytevector 1048577 120)))
  (lambda (root p)
    (define query "alpha|beta")
    (define missing (tool-search p query #:prefix "data" #:after 1))
    (expect '(literal "alpha|beta" "data" 0 1 #t #f #f)
      (map (lambda (k) (tool-ref missing k)) '(match-mode query prefix total scanned complete query-truncated prefix-truncated)))
    (define shown (tool-show missing))
    (for-each (lambda (s) (expect #t (and (string-contains shown s) #t)))
      '("literal query \"alpha|beta\"" "prefix \"data\"" "scanned 1 text file"
        "Regex operators are not interpreted" "batch separate literal queries"))
    (define literal (tool-search p query #:prefix "pipes"))
    (expect 1 (tool-ref literal 'total))
    (expect #f (and (string-contains (tool-show literal) "Regex operators") #t))
    (expect #f (and (string-contains (tool-show (tool-search p "alpha" #:prefix "data" #:offset 20)) "0 matches") #t))
    (string-set! (tool-ref missing 'query) 0 #\X)
    (expect "alpha|beta" query)
    (define long (tool-search p (make-string 400 #\é) #:prefix (make-string 400 #\x)))
    (expect '(#t #t) (map (lambda (k) (tool-ref long k)) '(query-truncated prefix-truncated)))
    (expect #t (<= (string-length (tool-ref long 'query)) 240))
    (expect #t (<= (string-length (tool-ref long 'prefix)) 240))
    (expect #t (and (string-contains (tool-show long) "query clipped") #t))
    (expect #t (and (string-contains (tool-show long) "prefix clipped") #t))
    (define partial (tool-search p query #:prefix "huge"))
    (expect #f (tool-ref partial 'complete))
    (expect #t (and (string-contains (tool-show partial) "incomplete: skipped 1") #t))
    (expect #t (and (string-contains (tool-show partial) "scanned 0 text files") #t))))
