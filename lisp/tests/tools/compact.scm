;;; Budgets and original coordinates, including incomplete syntax.
(require "support.scm")
(import (techne tools))

(with-tool-project "definition character budget and item ceiling" '()
  (lambda (root p)
    (fixture-write root "defs.scm"
      (apply string-append
        (map (lambda (i) (string-append "(define (λ" (number->string i) ") " (number->string i) ")\n")) (iota 35))))
    (fixture-write root "broken.rs" "fn good() {}\nfn broken(\n")
    (define all (tool-symbols p "defs.scm"))
    (expect 35 (length (tool-ref all 'items)))
    (expect '(35 #t #f #f #f)
      (map (lambda (k) (tool-ref all k)) '(total complete truncated next budget-exceeded)))
    (define three (tool-symbols p "defs.scm" #:limit 3))
    (expect 3 (tool-ref three 'next))
    (expect 3 (length (tool-ref three 'items)))
    (expect 35 (tool-ref three 'total))
    (define tiny (tool-symbols p "defs.scm" #:chars 1))
    (expect 1 (length (tool-ref tiny 'items)))
    (expect '(1 #t #t) (map (lambda (k) (tool-ref tiny k)) '(next truncated budget-exceeded)))
    (define second (tool-symbols p "defs.scm" #:chars 1 #:offset (tool-ref tiny 'next)))
    (expect "λ1" (tool-ref (car (tool-ref second 'items)) 'name))
    (define expected (map (lambda (i) (tool-ref i 'name)) (tool-ref all 'items)))
    (define paged
      (let loop ((offset 0) (names '()))
        (define r (tool-symbols p "defs.scm" #:chars 100 #:offset offset))
        (expect #t (or (<= (tool-ref r 'characters) 100) (tool-ref r 'budget-exceeded)))
        (define more (append names (map (lambda (i) (tool-ref i 'name)) (tool-ref r 'items))))
        (if (tool-ref r 'next) (loop (tool-ref r 'next) more) more)))
    (expect expected paged)
    (define end (tool-symbols p "defs.scm" #:offset 100))
    (expect '() (tool-ref end 'items))
    (expect '(#f #f 0 #f) (map (lambda (k) (tool-ref end k)) '(next truncated characters budget-exceeded)))
    (define partial (tool-symbols p "broken.rs"))
    (expect #f (tool-ref partial 'complete))
    (expect #t (tool-ref partial 'truncated))
    (define partial-end (tool-symbols p "broken.rs" #:offset 100))
    (expect '(#f #t #f) (map (lambda (k) (tool-ref partial-end k)) '(complete truncated next)))
    (for-each (lambda (query) (expect #t (fails query)))
      (list (lambda () (tool-symbols p "defs.scm" #:chars 0))
            (lambda () (tool-symbols p "defs.scm" #:chars 16001))
            (lambda () (tool-symbols p "defs.scm" #:limit 51))))))

(with-tool-project "known-file bounded defaults and truthful EOF"
  (list (list "small" (apply string-append (make-list 150 "é\n")))
        (list "long" (apply string-append (make-list 250 "x\n")))
        (list "wide" (apply string-append (make-list 200 (string-append (make-string 100 #\λ) "\n")))))
  (lambda (root p)
    (define small (tool-read p "small"))
    (expect '(150 #t #t #f #f) (map (lambda (k) (tool-ref small k))
      '(file-lines region-complete file-eof next next-line)))
    (expect 300 (string-length (tool-ref small 'text)))
    (define long (tool-read p "long"))
    (expect '(#t #f 201) (map (lambda (k) (tool-ref long k)) '(region-complete file-eof next-line)))
    (define wide (tool-read p "wide"))
    (expect 16000 (string-length (tool-ref wide 'text)))
    (expect '(#f #f 16000 #f) (map (lambda (k) (tool-ref wide k)) '(region-complete file-eof next next-line)))
    (expect "é\n" (tool-ref (tool-read p "small" #:lines 1) 'text))))
