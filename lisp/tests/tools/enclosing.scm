;;; Ownership shares parser results and immutable snapshots with definitions.
(require "support.scm")
(import (techne tools))

(with-tool-project "Rust hit owners and immutable definition handles"
  '(("code.rs" "// needle outside\nmod tests {\n #[test]\n fn alpha() { let _ = \"é needle alpha\"; fn inner() { let _ = \"nested-mark\"; } }\n #[test]\n fn beta() { let _ = \"needle beta\"; }\n}\n"))
  (lambda (root p)
    (define r (tool-search p "needle" #:enclosing #t #:limit 50))
    (define hits (tool-ref r 'items))
    (expect '(none found found) (map (lambda (i) (tool-ref i 'enclosing-status)) hits))
    (expect #t (tool-ref r 'enclosing-complete))
    (expect '("alpha" "beta") (map (lambda (i) (tool-ref (tool-ref i 'enclosing) 'name)) (cdr hits)))
    (define owner (tool-ref (cadr hits) 'enclosing))
    (define h (tool-ref owner 'handle))
    (expect (tool-ref (cadr hits) 'revision) (tool-ref owner 'revision))
    (expect #t (string-prefix? "#[test]" (tool-ref (tool-expand p h) 'text)))
    (expect h (tool-ref (car (tool-ref (tool-symbols p "code.rs" #:name "alpha") 'items)) 'handle))
    (define inner (tool-ref (car (tool-ref (tool-search p "nested-mark" #:enclosing #t #:after 1) 'items)) 'enclosing))
    (expect '("inner" "local") (list (tool-ref inner 'name) (tool-ref inner 'scope)))
    (expect #t (and (string-contains (tool-show r) "enclosing alpha") #t))
    (expect #t (and (string-contains (tool-show r) "tool-expand project") #t))
    (string-set! (tool-ref owner 'name) 0 #\X)
    (expect #t (and (string-contains (tool-ref (tool-expand p h) 'text) "fn alpha") #t))
    (fixture-write root "code.rs" "changed")
    (expect #t (and (string-contains (tool-ref (tool-expand p h) 'text) "needle alpha") #t))))

(with-tool-project "innermost Scheme owner uses character position, not line"
  '(("code.scm" "(define (outer) (define (inner) \"needle\") (inner))\n(define (a) \"mark-a\") (define (b) \"é mark-b\")\n\"top-level\"\n"))
  (lambda (root p)
    (define (owner query) (tool-ref (car (tool-ref (tool-search p query #:enclosing #t) 'items)) 'enclosing))
    (expect '("inner" "local") (let ((x (owner "needle"))) (list (tool-ref x 'name) (tool-ref x 'scope))))
    (expect "b" (tool-ref (owner "mark-b") 'name))
    (expect #f (owner "top-level"))
    (expect "inner" (tool-ref (tool-ref (car (tool-ref (tool-search p "needle") 'items)) 'enclosing) 'name))
    (expect #f (tool-ref (car (tool-ref (tool-search p "needle" #:enclosing #f) 'items)) 'enclosing-status))))

(with-tool-project "unavailable or partial syntax does not imply no owner"
  '(("notes.txt" "needle\n") ("broken.scm" "(define (x) \"needle\"\n")
    ("broken.rs" "fn x() { let x = \"needle\";\n"))
  (lambda (root p)
    (for-each (lambda (prefix)
      (let* ((r (tool-search p "needle" #:prefix prefix #:enclosing #t)) (i (car (tool-ref r 'items))))
        (expect #t (tool-ref r 'complete))
        (expect #f (tool-ref r 'enclosing-complete))
        (expect #f (tool-ref i 'enclosing-complete)))) '("notes" "broken.scm" "broken.rs"))
    (expect 'unavailable (tool-ref (car (tool-ref (tool-search p "needle" #:prefix "notes" #:enclosing #t) 'items)) 'enclosing-status))
    (expect #f (tool-ref (car (tool-ref (tool-search p "needle" #:prefix "notes") 'items)) 'enclosing-status))
    (expect #t (fails (lambda () (tool-search p "needle" #:group-by 'path #:enclosing #t))))
    (expect #t (fails (lambda () (tool-search p "needle" #:enclosing 'bad))))))
