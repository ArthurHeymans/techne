(import (techne) (techne terminal))
(require "../test.scm")

(define esc (string #\x1b))
(define (csi tail) (string-append esc "[" tail))
(define (row-text r)
  (apply string-append (filter-map (lambda (c) (cond ((pair? c) (car c)) ((not c) " ") (else #f)))
                                   (vector->list (terminal-row-cells r)))))
(define (row t y) (row-text (terminal-row t y)))
(define (cells t y) (terminal-row-cells (terminal-row t y)))
(define (feed t . pieces) (for-each (lambda (s) (terminal-feed! t s)) pieces))

(let ((t (make-terminal 3 6)))
  (feed t "hello!" "X")
  (check "delayed wrap" '("hello!" "X     " 1 1) (list (row t 0) (row t 1) (terminal-y t) (terminal-x t)))
  (feed t (csi "1;") "3H" "!" (csi "2P"))
  (check "split cursor sequence and delete" "he!!  " (row t 0))
  (feed t (csi "2@") "Z" (csi "0K"))
  (check "insert and erase" "he!Z  " (row t 0))
  (feed t (csi "2J") (csi "H") "界e\x301;" (string #\return))
  (check "wide and combining cells" '("界" tail "e\x301;" #f #f #f)
         (map (lambda (c) (if (pair? c) (car c) c)) (vector->list (cells t 0))))
  (feed t (csi "2G") "z")
  (check "editing wide tail also erases lead" " ze\x301;   " (row t 0))
  (feed t "\r" esc "(0lqk" esc "(B!")
  (check "DEC line drawing" "┌─┐!  " (row t 0)))

(let ((t (make-terminal 2 4 #:history 2)))
  (feed t "a\r\nb\r\nc\r\nd\r\ne")
  (check "bounded history" '(1 3 "b   " "c   " "d   " "e   ")
         (list (terminal-history-start t) (terminal-history-end t)
               (row-text (terminal-history-row t 1)) (row-text (terminal-history-row t 2)) (row t 0) (row t 1)))
  (feed t (csi "?1049h") "alt\r\n123\r\n456")
  (check "no history on alternate screen" '(#t 3 3 "123 ")
         (list (terminal-alternate? t) (terminal-history-start t) (terminal-history-end t) (row t 0)))
  (feed t (csi "?1049l"))
  (check "main survives alternate" '(#f 1 "d   " "e   " 1 1)
         (list (terminal-alternate? t) (terminal-history-start t) (row t 0) (row t 1) (terminal-x t) (terminal-y t)))
  (terminal-resize! t 1 2)
  (check "resize retains the cursor row" '("e " "d   " 0 1)
         (list (row t 0) (row-text (terminal-history-row t 3)) (terminal-y t) (terminal-x t)))
  (feed t (csi "3J"))
  (check "erase saved lines" (terminal-history-end t) (terminal-history-start t)))

(let ((t (make-terminal 4 8)))
  (feed t "a\r\nb\r\nc\r\nd" (csi "2;3r") (csi "?6h") (csi "2;1H") "z\r\nx")
  (check "origin and scroll margins" '("a       " "z       " "x       " "d       " 0)
         (list (row t 0) (row t 1) (row t 2) (row t 3) (terminal-history-end t))))

(let* ((replies '()) (t (make-terminal 2 8 #:reply (lambda (s) (set! replies (cons s replies))))))
  (feed t (csi "31;48;5;231;1m") "a" (csi "38:2::10:20:30m") "b" (csi "m") "c")
  (check "SGR fg" '(fg . 1) (assq 'fg (cdr (vector-ref (cells t 0) 0))))
  (check "SGR indexed bg" '(bg . 231) (assq 'bg (cdr (vector-ref (cells t 0) 0))))
  (check "colon RGB" '(fg 10 20 30) (assq 'fg (cdr (vector-ref (cells t 0) 1))))
  (check "empty SGR resets" '() (cdr (vector-ref (cells t 0) 2)))
  (feed t (csi "6n") (csi "18t"))
  (check "cursor and geometry replies" (list (csi "1;4R") (csi "8;2;8t")) (reverse replies))
  (check "arrows" (csi "A") (terminal-key t "<up>"))
  (feed t (csi "?1;2004h"))
  (check "application arrows" (string-append esc "OA") (terminal-key t "<up>"))
  (check "modified arrows" (csi "1;6D") (terminal-key t "C-S-<left>"))
  (check "frontend backtab" (csi "Z") (terminal-key t "<backtab>"))
  (check "control key" (string #\x03) (terminal-key t "C-c"))
  (check "bracketed paste strips escape controls and normalizes newlines"
         (string-append (csi "200~") "a\rb[201~" (csi "201~"))
         (terminal-paste t (string-append "a\r\nb" (csi "201~"))))
  (feed t (csi "?25;1;2004l"))
  (check "reset private modes" '(#f #f #f) (map (lambda (m) (terminal-mode? t m)) '(cursor application-cursor bracketed-paste)))
  (feed t (csi "?25h"))
  (check "show cursor again" #t (terminal-mode? t 'cursor))
  (feed t esc "]2;A title" esc "\\" esc "]52;c;ignored\x07;" esc "Pignored" esc "\\" "!")
  (check "only OSC titles are acted on" '("A title" "abc!    ") (list (terminal-title t) (row t 0)))
  (feed t (csi (make-string 400 #\9)) "m" esc "]2;" (make-string 2048 #\x) "\x07;" "Z")
  (check "overlong CSI and OSC recover" '("A title" "abc!Z   ") (list (terminal-title t) (row t 0))))

(define (dcs body) (string-append esc "P" body esc "\\"))

(let* ((replies '()) (t (make-terminal 4 8 #:reply (lambda (s) (set! replies (cons s replies))))))
  (feed t "A" (csi "41;1;1;1;1;1*y") (csi "42;1;1;2;1;2*y"))
  (feed t (csi "1;2H") (csi "@") (csi "43;1;1;2;1;2*y"))
  (check "checksums distinguish written, untouched and inserted cells"
         (map dcs '("41!~FFBF" "42!~10000" "43!~FFE0")) (reverse replies))
  (set! replies '())
  (feed t (csi "?69h") (csi "2;6s") (csi "2;3r") (csi "?6h") (csi "?69$p")
        esc "P$q" "s" esc "\\" (dcs "$qr") (dcs "$qunknown"))
  (check "bounded DCS reports margins and unknown settings"
         (list (csi "?69;1$y") (dcs "1$r2;6s") (dcs "1$r2;3r") (dcs "0$r")) (reverse replies))
  (feed t (csi "!p"))
  (check "soft reset preserves screen and cursor but resets margins" '("A       " 1 1 #f)
         (list (row t 0) (terminal-y t) (terminal-x t) (terminal-mode? t 'origin))))

(let ((t (make-terminal 3 8)))
  (feed t (csi "65;1;1;2;4$x") (csi "1;1;2;4;1;2;3;1$v"))
  (check "overlapping rectangle copies snapshot the source" '("AAAA    " "AAAAAA  " "  AAAA  ")
         (map (lambda (y) (row t y)) '(0 1 2)))
  (feed t (csi "1;1H") (csi "1\"q") "D" (csi "0\"q") esc "V" "I" esc "W" (csi "?2K"))
  (check "selective erase preserves DEC and ISO cells" "DI      " (row t 0))
  (feed t (csi "2K"))
  (check "ordinary erase preserves only ISO cells" " I      " (row t 0))
  (feed t (csi "3;8H") esc "#6")
  (check "double-width line limits cursor to half the grid" '(#t 3)
         (list (terminal-row-double-width? (terminal-row t 2)) (terminal-x t)))
  (terminal-resize! t 3 6)
  (check "resize clamps cursor to the new double-width edge" 2 (terminal-x t))
  (feed t (csi "2;6H") (csi "S"))
  (check "scroll clamps the cursor if a double-width row moves under it" '(1 2)
         (list (terminal-y t) (terminal-x t))))

(let* ((sizes '()) (t (make-terminal 5 80 #:resize (lambda (r c) (set! sizes (cons (list r c) sizes))))))
  (feed t (csi "8;12;40t") (csi "?3h") esc "c")
  (check "child-requested dimensions propagate and RIS resets wide columns"
         '((12 40) (12 132) (12 80)) (reverse sizes)))

(let ((t (make-terminal 2 8)))
  (feed t "old" esc "]2;" (make-string 1100 #\x) esc "c" "NEW")
  (check "a new escape cancels even a discarded OSC" "NEW     " (row t 0)))

(test-summary)
