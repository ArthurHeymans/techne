(define first (find (lambda (m) (string=? (mail-ref m 'message-id) "<one>")) before))
(define id (mail-ref first 'id))
(check "thread not subject guessing" 2 (length (mail-thread-members (mail-store-query db "" #:group 'all) first)))
;; Copies: one message in two folders of an account, as Gmail keeps mail.
(let ((db (mail-store-open ":memory:"))
      (copy (lambda (id subject) (string-append "Message-ID: <" id ">\nSubject: " subject "\nDate: Thu, 5 Nov 2026 10:00:00 +0000\n\nbody"))))
  (define (subjects query group) (map (lambda (m) (list (mail-ref m 'mailbox) (mail-ref m 'subject))) (mail-store-query db query #:group group)))
  (mail-store-import! db "g" "[Gmail]/All Mail" "1" (copy "a" "Both") '())
  (mail-store-import! db "g" "Inbox" "7" (copy "a" "Both") '())
  (mail-store-import! db "g" "[Gmail]/All Mail" "2" (copy "b" "Archived only") '())
  (mail-store-import! db "other" "Inbox" "1" (copy "a" "Another account") '())
  (mail-store-import! db "g" "Inbox" "8" "Subject: No ID\n\nbody" '())
  (mail-store-import! db "g" "[Gmail]/All Mail" "3" "Subject: No ID\n\nbody" '())
  (mail-store-dedupe! db)
  (check "a message in two folders is listed once; another account's and those without an ID are their own"
         '("Another account" "Archived only" "Both" "No ID" "No ID")
         (sort (map cadr (subjects "" 'all)) string<?))
  (check "the copy of a mailbox is found by in:" '(("[Gmail]/All Mail" "Archived only") ("[Gmail]/All Mail" "Both"))
         (sort (subjects "in:All subject:h" 'all) (lambda (a b) (string<? (cadr a) (cadr b)))))
  (check "copies are counted once" '(5 5) (list (mail-ref (mail-store-counts db) 'total) (mail-ref (mail-store-counts db) 'unread)))
  (let ((shown (car (mail-store-query db "subject:Both" #:group 'all))))
    (check "the shown copy is the Inbox's" "Inbox" (mail-ref shown 'mailbox))
    (check "its mailboxes" '("Inbox" "[Gmail]/All Mail") (mail-store-copy-mailboxes db (mail-ref shown 'id)))
    (mail-store-state! db (list (mail-ref shown 'id)) 'unread #f)
    (check "reading a message reads its copies, and no other account's" '(0 0 1)
           (map (lambda (m) (mail-ref m 'unread))
                (append (mail-store-query db "subject:Both" #:group 'all) (mail-store-query db "in:All subject:Both" #:group 'all)
                        (mail-store-query db "subject:Another" #:group 'all))))
    (check "unread after reading one of two copies" 4 (mail-ref (mail-store-counts db) 'unread)))
  (check "choosing again changes nothing" 0 (mail-store-dedupe! db "g"))
  ;; A folder is what is in it, copies too; an account and the groups
  ;; count a message once.
  (check "a folder lists its own copies"
         '("Archived only" "Both" "No ID")
         (sort (map (lambda (m) (mail-ref m 'subject)) (mail-store-query db "" #:group 'all #:account "g" #:mailbox "[Gmail]/All Mail")) string<?))
  (check "an account is only its own mail, a message once" '("Archived only" "Both" "No ID" "No ID")
         (sort (map (lambda (m) (mail-ref m 'subject)) (mail-store-query db "" #:group 'all #:account "g")) string<?))
  (check "folder names are exact, not substrings" 0 (length (mail-store-query db "" #:group 'all #:account "g" #:mailbox "All Mail")))
  (check "counted as listed, without a limit" '(4 2 1)
         (list (mail-store-count db "" #:group 'all #:account "g")
               (mail-store-count db "" #:group 'all #:account "g" #:mailbox "Inbox")
               (mail-store-count db "is:unread" #:account "other")))
  (let ((folders (mail-store-folders db)))
    (define (folder account mailbox) (find (lambda (f) (and (equal? (mail-ref f 'account) account) (equal? (mail-ref f 'mailbox) mailbox))) folders))
    (check "folders, with what is in them and unread"
           '(("Inbox" 2 1) ("[Gmail]/All Mail" 3 2))
           (map (lambda (f) (list (mail-ref f 'mailbox) (mail-ref f 'messages) (mail-ref f 'unread)))
                (filter (lambda (f) (equal? (mail-ref f 'account) "g")) folders)))
    (check "summed over folders, the shown copies are the groups' counts"
           (list (mail-ref (mail-store-counts db) 'total) (mail-ref (mail-store-counts db) 'unread))
           (list (fold + 0 (map (lambda (f) (mail-ref f 'shown)) folders))
                 (fold + 0 (map (lambda (f) (mail-ref f 'shown-unread)) folders))))
    (check "a copy shown from All Mail is counted there" 2 (mail-ref (folder "g" "[Gmail]/All Mail") 'shown)))
  ;; Forgetting: a folder's copy goes, and the other is shown in its place.
  (check "a folder forgotten" 2 (mail-store-forget! db "g" #:mailbox "Inbox"))
  (check "the copy left is shown" '("[Gmail]/All Mail") (map (lambda (m) (mail-ref m 'mailbox)) (mail-store-query db "subject:Both" #:group 'all)))
  (check "keys forgotten" 1 (mail-store-forget! db "g" #:mailbox "[Gmail]/All Mail" #:keys '("2" "absent")))
  (check "an account forgotten" 1 (mail-store-forget! db "other"))
  (check "what is left" '("Both" "No ID") (sort (map (lambda (m) (mail-ref m 'subject)) (mail-store-query db "" #:group 'all)) string<?))
  (mail-store-close db))
(define (thread-fixture id account message-id refs)
  `((id . ,id) (account . ,account) (message-id . ,message-id) (reply-to . "") (refs . ,refs)))
(define (group-ids messages)
  (map (lambda (group) (map (lambda (m) (mail-ref m 'id)) group)) (mail-thread-groups messages)))
(check "conversations follow references within an account, in first-member order" '((5 3 1) (4) (2))
  (group-ids (list (thread-fixture 5 "a" "<e>" "<a> <c>") (thread-fixture 4 "a" "<d>" "") (thread-fixture 3 "a" "<c>" "")
                   (thread-fixture 2 "b" "<x>" "<a>") (thread-fixture 1 "a" "<a>" ""))))
(check "a message naming two conversations joins them" '((3 2 1))
  (group-ids (list (thread-fixture 3 "a" "<c>" "") (thread-fixture 2 "a" "<b>" "") (thread-fixture 1 "a" "<a>" "<b> <c>"))))
(define (reply id message-id parent refs subject date)
  `((id . ,id) (account . "a") (message-id . ,message-id) (reply-to . ,parent) (refs . ,refs)
    (subject . ,subject) (date . ,(string-append "Thu, 5 Nov 2026 " date ":00 +0000"))))
(define (tree-rows messages)
  (map (lambda (m) (list (mail-ref m 'id) (mail-ref m 'tree) (mail-ref m 'tree-subject?))) (mail-thread-tree messages)))
(check "a reply is drawn under its parent, oldest first, its subject once"
  '((1 "" #t) (2 "├─► " #f) (4 "│   ╰─► " #f) (3 "╰─► " #t))
  (tree-rows (list (reply 4 "<d>" "<b>" "<a> <b>" "RE: Plan" "13:00") (reply 3 "<c>" "<a>" "<a>" "Another plan" "12:00")
                   (reply 2 "<b>" "<a>" "<a>" "Re: plan" "11:00") (reply 1 "<a>" "" "" "Plan" "10:00"))))
(check "a missing parent falls back to a reference, then to a root"
  '((1 "" #t) (3 "╰─► " #f) (5 "" #t))
  (tree-rows (list (reply 5 "<e>" "<gone>" "<gone>" "Re: Plan" "13:00") (reply 3 "<c>" "<gone>" "<a> <gone>" "Re: Plan" "12:00")
                   (reply 1 "<a>" "" "" "Plan" "10:00"))))
(check "messages naming only each other are all kept" '(1 2)
  (map car (tree-rows (list (reply 2 "<b>" "<a>" "" "x" "11:00") (reply 1 "<a>" "<b>" "" "x" "10:00")))))
(check "messages without IDs stay apart" '((2) (1))
  (group-ids (list (thread-fixture 2 "a" "" "") (thread-fixture 1 "a" "" ""))))
(mail-store-state! db (list id) 'unread #f)
(mail-store-state! db (list id) 'starred #t)
(mail-store-import! db "work" "INBOX" "99:1" (raw "one" "Reading room updated" "A longer conversation about typography.") '())
(check "resync stable id" id (mail-ref (car (mail-store-query db "subject:updated" #:group 'all)) 'id))
(check "resync preserves unread" 0 (mail-ref (mail-store-message db id) 'unread))
(check "resync preserves star" 1 (mail-ref (mail-store-message db id) 'starred))
(check "FTS upsert updated" 1 (length (mail-store-query db "updated" #:group 'all)))
(mail-store-state! db (list id) 'trashed #t #:copies? #f)
(check "the Inbox is the Inbox folders, without what is trashed" 3 (length (mail-store-query db "")))
(check "trashed is in no group" 0 (length (mail-store-query db "subject:updated" #:group 'all)))
(mail-store-state! db (list id) 'trashed #f #:copies? #f)
(mail-store-draft! db "draft-1" "work" "Subject: Hello\n\nA draft")
(check "draft" 1 (length (mail-store-drafts db)))
(mail-store-close db)
(set! db (mail-store-open path))
(check "durable state" 1 (mail-ref (mail-store-message db id) 'starred))
(check "durable draft" "Subject: Hello\n\nA draft" (list-ref (car (mail-store-drafts db)) 2))
(mail-store-draft! db "draft-1" "work" "Subject: Hello\n\nA draft" #:state "uncertain")
(check "uncertain kept" "uncertain" (list-ref (car (mail-store-drafts db)) 3))
(mail-store-draft! db "draft-1" "work" "edited stale buffer")
(check "ordinary save cannot downgrade uncertain" "uncertain" (mail-store-draft-state db "draft-1"))
(check "ordinary save cannot replace ambiguous snapshot" "Subject: Hello\n\nA draft" (list-ref (car (mail-store-drafts db)) 2))
(check "uncertain cannot be claimed" #f (mail-store-claim-draft! db "draft-1" "Subject: Hello\n\nA draft" "a"))
(mail-store-resolve-draft! db "draft-1" (mail-store-ambiguous-attempt db "draft-1") "draft")
