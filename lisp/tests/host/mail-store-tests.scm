;; The bulk index is a cache of searchable text, not a second Maildir.
(define (index-raises? f) (guard (e (#t #t)) (f) #f))
(define source (string-append path ".maildir"))
(create-directory source #o700)
(create-directory (path-join source "cur") #o700)
(create-directory (path-join source "new") #o700)
(define idx (mail-store-open ":memory:"))
(for-each
 (lambda (i)
   (call-with-output-file (path-join source "new" (number->string (+ 1000 i)))
     (lambda (p) (display (raw (number->string i) (string-append "Entry " (number->string i)) "searchable body") p))))
 (iota 300))
;; Read failure first: it must not prevent the healthy siblings being indexed.
(call-with-port (open-binary-output-file (path-join source "new" "999999-big"))
  (lambda (p) (write-bytevector (make-bytevector 16777217 65) p)))
;; Metadata must classify this as oversized without attempting an unreadable open.
(set-file-mode! (path-join source "new" "999999-big") 0)
(define commits '())
(define failures 0)
(define size-preflight? #f)
(check "bulk indexes healthy messages after an oversized source" 300
 (mail-store-import-maildir! idx "local" "INBOX" source
  #:notify (lambda (n)
             (set! commits (append commits (list n)))
             (check "progress reports only committed rows" (apply + commits) (mail-ref (mail-store-counts idx) 'total)))
  #:on-error (lambda (key e) (set! failures (+ failures 1))
                (set! size-preflight? (and (error-object? e) (string-contains (error-object-message e) "exceeds 16 MiB") #t)))))
(check "oversized metadata is checked before opening" #t size-preflight?)
(check "bounded batches and final partial batch" '(256 44) commits)
(check "oversized source reported once" 1 failures)
(check "Maildir raw is not duplicated" 0 (caar (sqlite-query idx "SELECT sum(length(raw)) FROM mail_messages" '())))
(check "text is still searchable" 300 (length (mail-store-query idx "searchable")))
(define item (find (lambda (m) (string=? (mail-ref m 'source-key) "1000")) (mail-store-query idx "")))
(define item-id (mail-ref item 'id))
(define original (mail-ref (mail-store-message idx item-id) 'raw))
;; Read and star are the file's flags, as mu4e writes them: renamed into
;; cur with S and F, its content untouched.
(mail-store-state! idx (list item-id) 'unread #f)
(mail-store-state! idx (list item-id) 'starred #t)
(check "read and star are written as Maildir flags" '(#f #t)
       (list (file-exists? (path-join source "new" "1000")) (file-exists? (path-join source "cur" "1000:2,FS"))))
(check "on-demand source follows new to cur and flag renames" original (mail-ref (mail-store-message idx item-id) 'raw))
(check "repeat imports no bodies" 0 (mail-store-import-maildir! idx "local" "INBOX" source #:on-error (lambda (key e) #f)))
(check "repeat keeps the read flag" 0 (mail-ref (mail-store-message idx item-id #:raw? #f) 'unread))
(check "repeat keeps the star" 1 (mail-ref (mail-store-message idx item-id #:raw? #f) 'starred))
;; Another program (mbsync, a phone through it) changes the flags: a sync
;; takes them from the file.
(rename-file (path-join source "cur" "1000:2,FS") (path-join source "cur" "1000:2,ST"))
(mail-store-import-maildir! idx "local" "INBOX" source #:on-error (lambda (key e) #f) #:remove-missing (lambda (n) #f))
(check "a sync takes the flags the file has" '(0 0 1)
       (let ((m (mail-store-message idx item-id #:raw? #f))) (map (lambda (k) (mail-ref m k)) '(unread starred trashed))))
(check "a trashed message is in no list" #f (and (find (lambda (m) (= (mail-ref m 'id) item-id)) (mail-store-query idx "" #:group 'all)) #t))
(mail-store-state! idx (list item-id) 'trashed #f #:copies? #f)
(check "the T flag cleared" #t (file-exists? (path-join source "cur" "1000:2,S")))
;; A move, as archiving to a folder is: the file goes, flags kept; back.
(define archive-dir (string-append source "-archive"))
(create-directory archive-dir #o700)
(create-directory (path-join archive-dir "cur") #o700)
(define back (mail-store-move! idx item-id "Archive" archive-dir))
(check "moved into the folder's cur, its name kept" #t (file-exists? (path-join archive-dir "cur/1000:2,S")))
(check "the row follows" "Archive" (mail-ref (mail-store-message idx item-id #:raw? #f) 'mailbox))
(check "what moves it back" (list "INBOX" (path-join source "cur/1000:2,S")) back)
(mail-store-move! idx item-id (car back) source)
(check "moved back" '(#t "INBOX") (list (file-exists? (path-join source "cur/1000:2,S")) (mail-ref (mail-store-message idx item-id #:raw? #f) 'mailbox)))
(rename-file (path-join source "cur" "1000:2,S") (path-join source "cur" "10000:2,S"))
(check "source-key lookup cannot accept a prefix collision" #t (index-raises? (lambda () (mail-store-message idx item-id))))
(check "missing source still permits cached state lookup" item-id (mail-ref (mail-store-message idx item-id #:raw? #f) 'id))
(check "prepared batch failure writes no partial rows" #t
 (index-raises? (lambda () (mail-store-import-batch! idx "atomic" "INBOX"
   (list (list (cons 'key "first") (cons 'raw (raw "a" "Atomic" "body"))) '((key . "bad") (raw . 42)))))))
(check "failed batch is absent" 0 (hash-table-count (mail-store-source-keys idx "atomic" "INBOX")))
(sqlite-execute idx "WITH RECURSIVE n(v) AS (VALUES(1) UNION ALL SELECT v+1 FROM n WHERE v<4105) INSERT INTO mail_messages(account,mailbox,source_key,raw,subject,sender,recipients,date,message_id,reply_to,refs,body) SELECT 'paging','INBOX','key-'||v,X'','','','','','','','','' FROM n" '())
(check "bulk keys exceed SQLite reply row cap by paging" 4105 (hash-table-count (mail-store-source-keys idx "paging" "INBOX")))
(check "bulk keys remain mailbox scoped" 0 (hash-table-count (mail-store-source-keys idx "paging" "other")))
(define stopped-db (mail-store-open ":memory:"))
(check "notification failure stops import after a durable batch" #t
 (index-raises? (lambda ()
   (mail-store-import-maildir! stopped-db "stopped" "INBOX" source
     #:notify (lambda (n) (error "stop after commit")) #:on-error (lambda (key e) #f)))))
(check "completed batch survives interrupted caller" 256 (mail-ref (mail-store-counts stopped-db) 'total))
(check "resume reads only missing source keys" 44
 (mail-store-import-maildir! stopped-db "stopped" "INBOX" source #:on-error (lambda (key e) #f)))
(check "resume has no duplicate cache records" 300 (mail-ref (mail-store-counts stopped-db) 'total))
(mail-store-close stopped-db)
;; A failed JSON-table statement rolls back all records and FTS postings;
;; it is a cache failure, never a recoverable per-source parse failure.
(define atomic-db (mail-store-open ":memory:"))
(sqlite-execute atomic-db "CREATE TRIGGER fail_bulk BEFORE INSERT ON mail_messages WHEN NEW.source_key='1200' BEGIN SELECT RAISE(ABORT,'synthetic cache failure'); END" '())
(define atomic-notified 0)
(define atomic-source-errors 0)
(check "large cache failure propagates" #t
 (index-raises? (lambda () (mail-store-import-maildir! atomic-db "atomic" "INBOX" source
   #:notify (lambda (n) (set! atomic-notified (+ atomic-notified n)))
   #:on-error (lambda (key e) (set! atomic-source-errors (+ atomic-source-errors 1)))))))
(check "failed large statement leaves no partial records" 0 (mail-ref (mail-store-counts atomic-db) 'total))
(check "failed large statement leaves no FTS postings" 0 (caar (sqlite-query atomic-db "SELECT count(*) FROM mail_search WHERE mail_search MATCH 'searchable'" '())))
(check "failed large statement is not acknowledged" 0 atomic-notified)
(check "only the oversized source is classified as a source error" 1 atomic-source-errors)
(sqlite-execute atomic-db "DROP TRIGGER fail_bulk" '())
(check "failed bulk import resumes without poisoned keys" 300
 (mail-store-import-maildir! atomic-db "atomic" "INBOX" source #:on-error (lambda (key e) #f)))
(mail-store-close atomic-db)
(define committed-db (mail-store-open ":memory:"))
(define acknowledged 0)
(define after-commit (spawn (lambda ()
 (mail-store-import-maildir! committed-db "committed" "INBOX" source #:on-error (lambda (key e) #f)
  #:notify (lambda (n) (set! acknowledged (+ acknowledged n)) (task-cancel (current-task)) (yield))))))
(check "cancellation after a bulk commit propagates" #t
 (guard (e (#t (task-cancelled-condition? e))) (task-join after-commit) #f))
(check "only durable bulk records were acknowledged" 256 acknowledged)
(check "a completed bulk transaction remains durable after cancellation" 256 (mail-ref (mail-store-counts committed-db) 'total))
(check "cancelled bulk import resumes the uncommitted suffix" 44
 (mail-store-import-maildir! committed-db "committed" "INBOX" source #:on-error (lambda (key e) #f)))
(mail-store-close committed-db)
;; Explicit large source-backed upserts preserve IDs, flags and byte-exact text.
(define json-db (mail-store-open ":memory:"))
(define json-body "oldneedle quotes: \" \\ 😀\nzero:\x0;tail\tend")
(define (json-entries subject body [n 64] [locator "/virtual/Maildir/new/"])
 (map (lambda (i) (list (cons 'key (number->string i)) (cons 'path (string-append locator (number->string i)))
                        (cons 'raw (raw (number->string i) subject body)) (cons 'flags '()))) (iota n)))
(check "large explicit source-backed import" 64 (mail-store-import-batch! json-db "json" "INBOX" (json-entries "JSON 'quote' 😀" json-body)))
(define json-id (mail-ref (car (mail-store-query json-db "account:json")) 'id))
