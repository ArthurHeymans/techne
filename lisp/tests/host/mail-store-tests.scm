(call-with-mail-store-lease db
  (lambda ()
    (check "claim once" #t (mail-store-claim-draft! db "draft-1" "Subject: Hello\n\nA draft" "a"))
    (check "second claim refused" #f (mail-store-claim-draft! db2 "draft-1" "Subject: Hello\n\nA draft" "b"))
    (check "live attempt cannot be released by another connection" #t
           (guard (e (#t #t)) (mail-store-resolve-draft! db2 "draft-1" (mail-store-ambiguous-attempt db2 "draft-1") "draft") #f))
    (mail-store-draft! db2 "draft-1" "work" "stale autosave")
    (check "sending state preserved" "sending" (mail-store-draft-state db2 "draft-1"))
    (check "only the owner can finish" #f (mail-store-finish-draft! db2 "draft-1" "b" "sent"))))
(define stale-attempt (mail-store-ambiguous-attempt db2 "draft-1"))
(check "abandoned attempt can be resolved" #t (mail-store-resolve-draft! db2 "draft-1" stale-attempt "draft"))
