(check "old recovery dialog cannot release new attempt" #f (mail-store-resolve-draft! db "draft-1" stale-attempt "draft"))
(call-with-mail-store-lease db2
  (lambda () (check "matching attempt can finish" #t (mail-store-finish-draft! db2 "draft-1" "b" "sent"))))
