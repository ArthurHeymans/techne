(define dir (path-join (or (get-environment-variable "TMPDIR") "/tmp") (string-append "techne-mail-" (uuid-v4))))
(create-directory dir #o700)
(define path (path-join dir "cache.sqlite"))
(define db (mail-store-open path))
(define (raw id subject body . reply)
  (string-append "From: Ada <ada@example.org>\r\nTo: Ben <ben@example.org>\r\nSubject: " subject
                 "\r\nMessage-ID: <" id ">\r\n"
                 (if (null? reply) "" (string-append "In-Reply-To: <" (car reply) ">\r\nReferences: <" (car reply) ">\r\n"))
                 "Content-Type: text/plain; charset=UTF-8\r\n\r\n" body))
(mail-store-import! db "work" "INBOX" "99:1" (raw "one" "Reading room" "A longer conversation about typography.") '())
(mail-store-import! db "work" "INBOX" "99:2" (raw "two" "Re: Reading room" "The second response." "one") '("\\Seen"))
(mail-store-import! db "work" "INBOX" "99:3" (raw "three" "Reading room" "An unrelated message, same subject.") '())
(mail-store-import! db "other" "INBOX" "99:1" (raw "one" "Reading room" "An independent account.") '())
(check "count" 4 (mail-ref (mail-store-counts db) 'total))
(check "cached source locator found" #t (mail-store-source-cached? db "work" "INBOX" "99:1"))
(check "source cache lookup includes account" #f (mail-store-source-cached? db "missing" "INBOX" "99:1"))
(check "source cache lookup includes mailbox" #f (mail-store-source-cached? db "work" "other" "99:1"))
(check "uncached source locator absent" #f (mail-store-source-cached? db "work" "INBOX" "99:404"))
