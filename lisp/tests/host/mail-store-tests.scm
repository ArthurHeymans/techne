;; Cancel while the parser is busy, not merely after a successful commit.
;; Previously its fallback guards converted cancellation into an empty body.
(define qp-wire (string-append "Subject: Cancelled parse\nContent-Type: text/plain\nContent-Transfer-Encoding: quoted-printable\n\n"
                              (string-join (make-list 50000 "x=41") "")))
(define qp-text (string-join (make-list 50000 "xA") ""))
(define cancel-db (mail-store-open ":memory:"))
(define began #f)
(define parsing (spawn (lambda () (set! began #t)
  (mail-store-import-batch! cancel-db "cancel" "INBOX" (list (list (cons 'key "qp") (cons 'raw qp-wire)))))))
(sleep 5)
(check "cancellation fixture is in flight" #t (and began (not (task-done? parsing))))
(task-cancel parsing)
(check "cancelled MIME preparation propagates the original condition" #t
 (guard (e (#t (task-cancelled-condition? e))) (task-join parsing) #f))
(check "cancelled preparation cannot commit a partial index" 0 (mail-ref (mail-store-counts cancel-db) 'total))
(mail-store-close cancel-db)
(define cancel-source (string-append path ".cancel-maildir"))
(create-directory cancel-source #o700)
(create-directory (path-join cancel-source "cur") #o700)
(create-directory (path-join cancel-source "new") #o700)
(call-with-output-file (path-join cancel-source "new" "1000") (lambda (p) (display qp-wire p)))
(set! cancel-db (mail-store-open ":memory:"))
(define cancelled-source-errors 0)
(define cancelled-commits 0)
(define importing (spawn (lambda ()
  (mail-store-import-maildir! cancel-db "cancel" "INBOX" cancel-source
    #:on-error (lambda (key e) (set! cancelled-source-errors (+ cancelled-source-errors 1)))
    #:notify (lambda (n) (set! cancelled-commits (+ cancelled-commits n)))))))
(sleep 5)
(check "Maildir cancellation fixture is in flight" #f (task-done? importing))
(task-cancel importing)
(check "Maildir guards do not consume cancellation" #t
 (guard (e (#t (task-cancelled-condition? e))) (task-join importing) #f))
(check "cancellation is not reported as a bad source" 0 cancelled-source-errors)
(check "cancelled pending work is not acknowledged" 0 cancelled-commits)
(check "cancelled Maildir key is not cached" #f (mail-store-source-cached? cancel-db "cancel" "INBOX" "1000"))
(check "resuming cancelled Maildir reimports the complete body" 1
 (mail-store-import-maildir! cancel-db "cancel" "INBOX" cancel-source))
(check "resumed searchable text is complete, not a poisoned cache hit" #t
 (string=? qp-text (caar (sqlite-query cancel-db "SELECT body FROM mail_messages" '()))))
(mail-store-close cancel-db)
