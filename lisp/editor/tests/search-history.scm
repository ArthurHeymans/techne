;;; Start with a fresh history, independent of other search scenarios.
(import (techne test))
(test-file #:script #t #:environment (quote editor))
(require "../main.scm")
(require "../session.scm")
(require "../dispatch.scm")
(define s (start-session (make-view (make-document "alpha beta gamma") "user") "emacs"))
(define (after keys message)
  (press-keys s keys) (check keys message (echo-line s)))
(press-keys s "C-s b e t a RET C-a C-s g a m m a RET C-a C-s")
(after "M-p" "I-search: gamma")
(after "M-p" "I-search: beta")
(check "point after recalled match" 10 (view-point (pane-view s)))
(after "M-p" "I-search: beta  Beginning of history; no preceding item")
(after "M-n M-n" "I-search: ")
(after "C-s" "I-search: gamma")
(test-failures)
