;;; Drive incremental search from keys; the frontend click/coordinate check
;;; stays in the host suite. Use the pane, not the minibuffer's input view,
;;; when asking where the match is.
(require "../../test.scm")
(require "../main.scm")
(require "../api.scm")
(require "../session.scm")
(require "../dispatch.scm")
(require "../minibuffer.scm")

(define (editing text) (start-session (make-view (make-document text) "user") "emacs"))
(define (head s) (view-point (pane-view s)))
(define (message-after s keys want)
  (press-keys s keys) (check keys want (echo-line s)))

(let ((s (editing "foo bar")))
  (press-keys s "C-s f o o RET C-s b a r M-e RET C-g")
  (check "remember edits only when the search ends" '("foo") (minibuffer-history 'isearch)))
(let ((s (editing "foo bar baz\nfoo bar qux\n")))
  (message-after s "C-s f C-w" "I-search: foo")
  (message-after s "C-w" "I-search: foo bar")
  (message-after s "M-s C-e" "I-search: foo bar baz")
  (check "match end" 11 (head s))
  (check "unchanged document" "foo bar baz\nfoo bar qux\n" (document-string (session-document s))))
(let ((s (editing "one two three onetwo")))
  (press-keys s "M-d C-f M-d")
  (message-after s "C-a C-s C-y" "I-search: two")
  (message-after s "M-y" "I-search: one")
  (message-after s "M-y" "I-search: two")
  (message-after s "DEL DEL DEL e M-y" "I-search: etwo"))
(let ((s (editing "abc abx abe")))
  (press-keys s "C-s a b c M-e")
  (check "edit the search in the minibuffer" "abc" (minibuffer-input s))
  (message-after s "DEL e RET" "I-search: abe")
  (check "minibuffer closed" #f (editor-minibuffer s))
  (check "edited match end" 11 (head s))
  (message-after s "M-e C-a C-k C-g" "I-search: abe  Quit")
  (press-keys s "C-g") (check "cancel goes back" 0 (head s)))
(let ((s (editing "one two")))
  (message-after s "C-s t w C-f" "") (check "unbound key ran" 7 (head s))
  (message-after s "C-a C-s o C-x 2" "")
  (check "unbound prefix ran" 2 (length (session-panes s))))
(let* ((s (editing "text")) (maps (lambda () (map car (explain-key s '("C-w") 'chord)))))
  (check "before search" '(emacs) (maps))
  (press-keys s "C-s") (check "during search" '(isearch emacs) (maps))
  (press-keys s "RET") (check "after search" '(emacs) (maps)))
(let* ((s (editing "one one one")) (v (session-view s)))
  (view-set-ranges! v '((0 0) (4 4)) 1)
  (press-keys s "C-s o n e") (check "search from primary" 7 (head s))
  (press-keys s "C-g") (check "restore ranges and primary" '(((0 0) (4 4)) 1) (list (view-ranges v) (view-primary v))))
(let ((s (editing "foo bar foo bar")))
  (message-after s "C-s f o o C-s C-w" "I-search: foo bar") (check "forward" 15 (head s))
  (message-after s "RET M-> C-r f o o C-w" "I-search: foo bar") (check "backward" 8 (head s))
  (message-after s "C-r" "I-search: foo bar") (check "previous" 0 (head s))
  (message-after s "M-s C-e" "I-search: foo bar foo bar") (check "grow in place" 0 (head s)))
(let ((s (editing "foo\nbar\n")))
  (press-keys s "C-s f o o M-s C-e") (check "append following line" "foo\nbar" (cadr (sget s 'isearch))))
(test-failures)
