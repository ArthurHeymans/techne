;;; Run in fresh, attached sessions by techne-editor/tests/terminal.rs.
(require "../../../test.scm")
(require "../../main.scm")
(require "../../dispatch.scm")
(require "../../keymaps.scm")
(require "../../session.scm")
(require "../../buffers.scm")
(require "../../modes.scm")
(require "../../files.scm")
(require "../../live.scm")
(provide osc-prompts alignment resize initial-size split-size shell-exit redraw-retry burst paste test-failures)

(define s (current-session))
(define (keys k) (for-each (lambda (key) (editor-press s key)) (kbd k)))
(define (typing str) (for-each (lambda (c) (editor-press s (key-for-char c))) (string->list str)))
(define (text) (document-string (session-document s)))
(define (status) (pane-status s (session-view s)))
(define (contains? str part) (and (string-contains str part) #t))
(define (wait-for what pred)
  (let ((end (+ (current-jiffy) (* 10 (jiffies-per-second)))))
    (let loop ()
      (unless (pred)
        (when (> (current-jiffy) end) (error "timed out" what (status) (text) (echo-line s)))
        (sleep 5) (loop)))))
(define (output part) (wait-for part (lambda () (contains? (text) part))))
(define (exited) (wait-for "exit" (lambda () (contains? (status) "Exit 0"))))
(define (command script)
  (keys "M-x") (type-text s "terminal-command") (keys "RET")
  (check "command prompt" "Terminal command: " (car (editor-minibuffer s)))
  (type-text s script) (keys "RET"))

(define (osc-prompts)
  (command "printf '\\033]7;file:///tmp/a%%20b\\007\\033]133;A\\007one\\n\\033]133;A\\007\\033]8;;https://example.org/\\007two\\033]8;;\\007\\n'; read -r go")
  (output "two")
  (check-true "first prompt" (string-prefix? "one" (text)))
  (check "reported cwd" "/tmp/a b/" (default-directory s))
  (keys "C-c C-p")
  (check-true "copy mode" (contains? (status) "COPY"))
  (check-true "second prompt" (string-prefix? "two" (substring (text) (view-point (session-view s)) (string-length (text)))))
  (keys "C-c C-p") (check "first prompt position" 0 (view-point (session-view s)))
  (keys "C-c M-n") (check-true "show link" (contains? (echo-line s) "https://example.org/")))

(define (alignment)
  (editor-viewport! s 5 4 1)
  (command "stty -echo; printf '\\033#8'; read -r go; printf '\\033[2;1H\\n'")
  (wait-for "alignment display" (lambda () (equal? (text) "EEEEE\nEEEEE\n")))
  (check "top" 0 (view-scroll (session-view s)))
  (keys "RET") (exited) (check "scrollback" "EEEEE\nEEEEE\n     \n" (text)))

(define (initial-size)
  (editor-viewport! s 37 10 1)
  (command "test -t 1 && test -z \"${COLUMNS+x}${LINES+x}\" && stty size")
  (exited) (check-true "initial tty size" (string-prefix? "8 37" (text))))

(define (split-size)
  (editor-viewport! s 100 24 4) (keys "C-x 3")
  (check "two panes" 2 (length (editor-panes s)))
  (unless (zero? (editor-focus s)) (keys "C-x o"))
  (command "stty size") (exited)
  (check-true "clip lines" (list-ref (pane-display s (session-view s)) 3))
  (check-true "left pane width" (string-prefix? "22 46" (text))))

(define (resize)
  (editor-viewport! s 80 27 1)
  (command "stty -echo; printf '\\033[8;12;34tready\\n'; read -r line; stty size")
  (output "ready") (keys "RET") (exited)
  (check-true "child resize survives input" (contains? (text) "12 34")))

(define (shell-exit only?)
  (run-command s 'terminal 1)
  (wait-for "shell" (lambda () (contains? (status) "SEMI")))
  (when only? (let ((b (current-buffer s)))
                (for-each (lambda (other) (unless (eq? b other) (drop-buffer! s other))) (buffer-list))))
  (typing "exit 0") (keys "RET")
  (wait-for "shell exits" (lambda () (or (contains? (status) "Exit 0") (not (contains? (status) "*terminal*")))))
  (check "retain only the last buffer" only? (contains? (status) "*terminal*")))

(define (redraw-retry)
  (let ((pkg (package-module (find-package 'terminal))))
    (eval '(begin (define original-render! render!) (define draws 0)
                  (set! render! (lambda (s b state)
                                  (when (process state) (set! draws (+ 1 draws))
                                        (when (= draws 1) (error "injected draw failure")))
                                  (original-render! s b state)))) pkg)
    (command "stty -echo; printf 'unshown tail'; read -r finish")
    (wait-for "first live draw" (lambda () (positive? (eval 'draws pkg))))
    (check "tail not yet visible" #f (contains? (text) "unshown tail"))
    (keys "RET") (exited)
    (check-true "tail after retry" (contains? (text) "unshown tail"))
    (check "retried before clearing process" 2 (eval 'draws pkg))))

(define (burst)
  (command "stty -echo; printf 'ready\\n'; read -r go; i=0; while [ \"$i\" -lt 120 ]; do printf 'burst %03d: synthetic kernel log line with some payload\\n' \"$i\"; i=$((i + 1)); sleep .003; done; read -r done; printf '\\033[31mfinal tail\\033[0m'")
  (output "ready")
  (let ((before (document-revision (session-document s))))
    (keys "RET")
    (wait-for "intermediate frame" (lambda () (and (contains? (text) "burst 000") (not (contains? (text) "burst 119")))))
    (output "burst 119")
    (check-true "coalesced revisions" (< (- (document-revision (session-document s)) before) 240)))
  (keys "RET") (exited) (check-true "final output" (contains? (text) "final tail")))

(define (paste)
  (editor-viewport! s 40 6 1)
  (command "stty -echo; printf 'old\\na\\nb\\nc\\nd\\nlive\\n\\033[?1049h\\033[?2004h\\033[?25lALT'; read -r line; printf '\\033[?1049l\\033[?25h\\n'; test \"$line\" = \"$(printf '\\033[200~pasted\\033[201~')\" || exit 3; printf 'received:pasted\\n'")
  (output "ALT") (check "hidden scrollback" #f (contains? (text) "old"))
  (editor-clipboard! s "pasted") (keys "C-S-v RET") (exited)
  (check-true "restored scrollback" (string-prefix? "old\na\nb\n" (text)))
  (check-true "received bracketed paste" (contains? (text) "received:pasted"))
  (check "alternate screen gone" #f (contains? (text) "ALT")))
