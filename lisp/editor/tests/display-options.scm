;;; A buffer's next snapshot must reflect changes made without editing text.
(import (techne test))
(test-file #:environment (quote editor))
(require "../main.scm")
(require "../modes.scm")
(require "../session.scm")

(define s (start-session (make-view (make-document "") "user") "emacs"))
(define b (current-buffer s))
(define (truncated?) (list-ref (pane-display s (session-view s)) 4))
(define (pointer?) (list-ref (pane-display s (session-view s)) 5))
(check "default" #f (truncated?))
(let ((scope (make-scope 'display-test)))
  (with-scope scope (set-option! 'truncate-lines #t))
  (check "global" #t (truncated?))
  (set-option! 'truncate-lines #f #:buffer b)
  (check "buffer overrides global" #f (truncated?))
  (unset-option! 'truncate-lines #:buffer b)
  (check "unset" #t (truncated?))
  (scope-shutdown! scope)
  (check "scope cleanup uncovers default" #f (truncated?)))
(register-mode! 'display-parent "Parent." #:options '((truncate-lines . #t)))
(register-mode! 'display-child "Child." #:parent 'display-parent)
(set-buffer-mode! b 'display-child)
(check "inherited option" #t (truncated?))
(register-mode! 'display-parent "Replaced parent.")
(check "parent redefined" #f (truncated?))
(set-option! 'report-pointer #t #:buffer b)
(check "reports" #t (pointer?))
(sset! s 'private-key #t)
(check "private input immediately suspends pointer reporting" #f (pointer?))
(sset! s 'private-key #f)
(check "resumed" #t (pointer?))
(vector-set! (buffer-display-options b) 5 #f)
(check "caller cannot mutate cached vector" #t (pointer?))
(test-failures)
