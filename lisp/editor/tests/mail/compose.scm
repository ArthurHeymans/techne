;;; Mail application tests. The host opens a fresh attached session with a
;;; private directory for its journal and SQLite database for each case.
(require "../../../test.scm")
(require "../../main.scm")
(require "../../dispatch.scm")
(import (techne editor) (techne mail store))
(provide run-compose-case compose-cases)

(define s (current-session))
(define (text) (document-string (session-document s)))
(define (command name)
  (run-command s name 1)
  (check (symbol->string name) '() (take-violations! s)))
(define (db) (mail-store-open (option #f 'mail-database)))
(define (contains label actual part) (check-true label (string-contains actual part)))

(define (stale-row)
  (let ((store (db)))
    (define (save body) (mail-store-draft! store "draft-fixture" "test" body))
    (define (saved) (caddr (mail-store-draft store "draft-fixture")))
    (save "From: ada@example.org\nSubject: Before\n\nOld body")
    (command 'mail-drafts) (contains "listed before update" (text) "Before")
    (save "From: ada@example.org\nSubject: After\n\nNew body")
    (press-keys s "RET") (contains "open latest text" (text) "New body")
    (save "Subject: Newer still\n\nNewer body")
    (let ((stale (current-buffer s)))
      (command 'mail-postpone) (contains "postpone doesn't overwrite" (saved) "Newer body")
      (drop-buffer! s stale) (contains "close doesn't overwrite" (saved) "Newer body"))))

(define (sent-record)
  (command 'mail-compose)
  (let* ((store (db)) (saved (car (mail-store-drafts store))) (id (car saved)))
    (call-with-mail-store-lease store
      (lambda ()
        (unless (mail-store-claim-draft! store id (caddr saved) "token") (error "draft claim failed"))
        (mail-store-finish-draft! store id "token" "sent")))
    (command 'mail-discard-draft)
    (contains "explain retention" (echo-line s) "delivery record retained")
    (check "retain delivery" "sent" (mail-store-draft-state store id))
    (check "no confirmation" #f (editor-minibuffer s))))

(define (uncertain-record)
  (command 'mail-compose)
  (let* ((store (db)) (id (caar (mail-store-drafts store))))
    (mail-store-draft! store id "test" "From: ada@example.org\nTo: ben@example.org\nSubject: ambiguous\n\nBody" #:state "uncertain")
    (command 'mail-save-draft) (drop-buffer! s (current-buffer s))
    (command 'mail-drafts)
    (contains "listed subject" (text) "ambiguous") (contains "listed state" (text) "uncertain")
    (press-keys s "RET") (contains "inspectable" (text) "Subject: ambiguous")
    (command 'mail-save-draft) (check "save doesn't resolve" "uncertain" (mail-store-draft-state store id))
    (let ((before (text))) (press-keys s "X") (check "not editable" before (text)))
    (command 'mail-resolve-delivery) (type-text s "Confirmed NOT delivered") (press-keys s "RET")
    (check "explicit resolution" "draft" (mail-store-draft-state store id))))

(define (recipient-field)
  (command 'mail-compose)
  (check "initial field" "To: " (document-substring (doc s) (line-start (doc s) (point s)) (point s)))
  (type-text s "ben@example.org") (contains "typed recipient" (text) "To: ben@example.org\n"))

(define (pasted-headers)
  (command 'mail-compose)
  (view-edit! (session-view s)
    (list (list 0 (document-length (doc s))
      "From: =?UTF-8?Q?D=C3=B6e=2C_Ada?= <ada@example.org>\nTo: =?UTF-8?Q?D=C3=B6e=2C_Jane?= <jane@example.org>\nCc: =?UTF-8?Q?Rivers=2C_Ben?= <ben@example.org>\nBcc: =?UTF-8?Q?Hidden=2C_Recipient?= <hidden@example.org>\nSubject: Pasted headers\n\nBody")) "new")
  (command 'mail-send)
  (contains "envelope confirmation" (car (editor-minibuffer s)) "Send to jane@example.org, ben@example.org, hidden@example.org?")
  (press-keys s "C-g")) ; Do not submit anything.

(define compose-cases (list stale-row sent-record uncertain-record recipient-field pasted-headers))
(define (run-compose-case index database)
  (set-option! 'mail-database database)
  (set-option! 'mail-accounts '(((id . "test") (kind . maildir) (path . "/missing-techne-mail-fixture")
                                 (from . "ada@example.org") (smtp-host . "smtp.invalid") (smtp-user . "ada@example.org"))))
  (command 'mail)
  ((list-ref compose-cases index))
  (test-failures))
