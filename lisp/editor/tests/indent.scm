;;; Exercise indentation through both key profiles, not through a renderer.
(import (techne test))
(test-file #:script #t #:environment (quote editor))
(require "../main.scm")
(require "../session.scm")
(require "../dispatch.scm")
(require "../modes.scm")

(define (editing profile filename text)
  (let ((s (start-session (make-view (make-document text) "user") profile)))
    (set-buffer-mode! (current-buffer s) (mode-for-file filename))
    s))
(define (text s) (document-string (session-document s)))
(define indented "(define (f x)\n  (let ((a 1)\n        (b 2))\n    (when (> a b)\n      (display a))\n    (+ a\n       b)))\n")
(define flat "(define (f x)\n(let ((a 1)\n(b 2))\n(when (> a b)\n(display a))\n(+ a\nb)))\n")

(let ((s (editing "emacs" "a.scm" "")))
  (type-text s flat)
  (check "RET indents while typing" indented (text s))
  (press-keys s "C-/")
  (check "undo the indented line break" (substring indented 0 (- (string-length indented) 1)) (text s)))
(let ((s (editing "emacs" "b.scm" flat)))
  (press-keys s "C-n TAB")
  (check-true "TAB indents its line" (string-prefix? "(define (f x)\n  (let" (text s)))
  (check "point after indentation" (string-length "(define (f x)\n  ") (view-point (session-view s)))
  (press-keys s "C-M-q") (check "indent expression" indented (text s)))
(let ((s (editing "emacs" "c.txt" "a\n")))
  (press-keys s "TAB RET") (check "literal tab in text" "\t\na\n" (text s)))
(let* ((before "(when #t\n(display 1))\n(when #t\n(display 2))\n")
       (s (editing "emacs" "multiple.scm" before))
       (a (string-contains before "(display 1)")) (b (string-contains before "(display 2)")))
  (view-set-ranges! (session-view s) `((,a ,a) (,(+ a 2) ,(+ a 2)) (,b ,b)) 0)
  (press-keys s "C-M-\\")
  (check "indent each line only once" "(when #t\n  (display 1))\n(when #t\n  (display 2))\n" (text s))
  (press-keys s "C-/") (check "one undo for all cursors" before (text s)))
;; Each cursor goes past the blanks of its own line: the later line's
;; blanks are found past those the earlier one gained.
(let ((s (editing "emacs" "cursors.scm" "(f a)\n(g b)\n")))
  (view-set-ranges! (session-view s) '((4 4) (10 10)) 0)
  (press-keys s "RET")
  (check "RET at each cursor" "(f a\n   )\n(g b\n   )\n" (text s))
  (check "each cursor after its indentation" '((8 8) (18 18)) (view-ranges (session-view s))))
;; Past characters of several bytes, and on a line already right, which
;; no edit says where its blanks end.
(let ((s (editing "emacs" "bytes.scm" "(é a\n   b)\n")))
  (press-keys s "C-n TAB")
  (check "a line already right is left" "(é a\n   b)\n" (text s))
  (check "point after its indentation" '((9 9)) (view-ranges (session-view s)))
  (press-keys s "C-p C-e RET")
  (check "a line opened under the argument" "(é a\n   \n   b)\n" (text s))
  (check "point counted in bytes" '((9 9)) (view-ranges (session-view s))))
;; A mode's edit may make only the start of the blanks: point goes past
;; all of them.
(define-mode one-more-blank-mode "Indents by a blank more each time."
  #:parent 'prog-mode
  #:indent (lambda (d starts) (map (lambda (p) (list p p " ")) starts)))
(let ((s (editing "emacs" "more.txt" "    x\n")))
  (set-buffer-mode! (current-buffer s) 'one-more-blank-mode)
  (press-keys s "TAB")
  (check "a blank more" "     x\n" (text s))
  (check "point past every blank" '((5 5)) (view-ranges (session-view s))))
;; A bracket far out: the line it opens is indented under it, and the
;; blanks are not looked at one by one.
(let* ((long (make-string 200000 #\x))
       (s (editing "emacs" "far.scm" (string-append "(" long "\n"))))
  (press-keys s "C-e SPC [ RET")
  (check "indented under the bracket" (+ (string-length long) 3 1 (string-length long) 3)
         (view-point (session-view s))))
;; `.` in a read-only buffer is refused once, not key by key, and leaves
;; the next insertion recorded as ever.
(let ((s (editing "modal" "dot.txt" "\n")))
  (press-keys s "i") (type-text s "abc") (press-keys s "ESC")
  (set-option! 'read-only #t #:buffer (current-buffer s))
  (press-keys s ".")
  (check "read-only: refused" "Buffer is read-only" (echo-line s))
  (check "read-only: nothing typed again" "abc\n" (text s))
  (check "read-only: no keys said typed again" #f (sget s 'repeated-keys))
  (set-option! 'read-only #f #:buffer (current-buffer s))
  (press-keys s "i") (type-text s "x") (press-keys s "ESC .")
  (check "the next insertion typed again" "abxxc\n" (text s)))
(let ((s (editing "modal" "a.scm" "(when x\n  (a))\n")))
  (press-keys s "o") (type-text s "(b\nc)") (press-keys s "ESC")
  (check "modal open and insert" "(when x\n  (b\n   c)\n  (a))\n" (text s)))
(let ((s (editing "modal" "b.scm" flat)))
  (press-keys s "= G") (check "indent operator" indented (text s)))
(test-failures)
