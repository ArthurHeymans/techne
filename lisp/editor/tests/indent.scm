;;; Exercise indentation through both key profiles, not through a renderer.
(require "../../test.scm")
(require "../main.scm")
(require "../session.scm")
(require "../dispatch.scm")
(require "../modes.scm")

(define (editing profile filename text)
  (let ((s (start-session (make-view (make-document text) "user") profile)))
    (set-buffer-mode! (current-buffer s) (mode-for-file filename))
    s))
(define (text s) (document-string (session-document s)))
(define indented "(define (f x)\n  (let ((a 1)\n        (b 2))\n    (when (> a b)\n      (display a))\n    (+ a\n       b)))\n")
(define flat "(define (f x)\n(let ((a 1)\n(b 2))\n(when (> a b)\n(display a))\n(+ a\nb)))\n")

(let ((s (editing "emacs" "a.scm" "")))
  (type-text s flat)
  (check "RET indents while typing" indented (text s))
  (press-keys s "C-/")
  (check "undo the indented line break" (substring indented 0 (- (string-length indented) 1)) (text s)))
(let ((s (editing "emacs" "b.scm" flat)))
  (press-keys s "C-n TAB")
  (check-true "TAB indents its line" (string-prefix? "(define (f x)\n  (let" (text s)))
  (check "point after indentation" (string-length "(define (f x)\n  ") (view-point (session-view s)))
  (press-keys s "C-M-q") (check "indent expression" indented (text s)))
(let ((s (editing "emacs" "c.txt" "a\n")))
  (press-keys s "TAB RET") (check "literal tab in text" "\t\na\n" (text s)))
(let* ((before "(when #t\n(display 1))\n(when #t\n(display 2))\n")
       (s (editing "emacs" "multiple.scm" before))
       (a (string-contains before "(display 1)")) (b (string-contains before "(display 2)")))
  (view-set-ranges! (session-view s) `((,a ,a) (,(+ a 2) ,(+ a 2)) (,b ,b)) 0)
  (press-keys s "C-M-\\")
  (check "indent each line only once" "(when #t\n  (display 1))\n(when #t\n  (display 2))\n" (text s))
  (press-keys s "C-/") (check "one undo for all cursors" before (text s)))
(let ((s (editing "modal" "a.scm" "(when x\n  (a))\n")))
  (press-keys s "o") (type-text s "(b\nc)") (press-keys s "ESC")
  (check "modal open and insert" "(when x\n  (b\n   c)\n  (a))\n" (text s)))
(let ((s (editing "modal" "b.scm" flat)))
  (press-keys s "= G") (check "indent operator" indented (text s)))
(test-failures)
