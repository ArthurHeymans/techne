(require "../../test.scm")
(require "../api.scm")
(require "../main.scm")
(require "../dispatch.scm")

(define (editor text profile) (start-session (make-view (make-document text) "user") profile))
(define (rejection thunk) (guard (e (#t (error-text e))) (thunk) "unexpected success"))
(define (written x) (call-with-output-string (lambda (p) (write x p))))

;; Changing one argument can invalidate another. Both key profiles use the
;; ordinary schema reader and run the command in the form's source buffer.
(for-each
  (lambda (profile)
    (let* ((s (editor "abc" profile)) (source (session-document s)) (runs 0))
      (define-command (pick s kind value) "Pick a KIND and a VALUE of it."
        #:arguments `((kind (one-of number text) #:default number)
                      (value ,(lambda (args) (if (eq? (dict-ref args 'kind) 'number) 'integer 'string))))
        #:effects '(edit)
        (set! runs (+ runs 1)) (insert-text! s (if (string? value) value (number->string value)) "new"))
      (let ((f (open-command-form! s 'pick)))
        (check "opening does not run" 0 runs)
        (check "missing value" '(value) (map car (form-problems f)))
        (form-set-argument! f 'value 3) (check "integer accepted" '() (form-problems f))
        (form-set-argument! f 'kind 'text)
        (check-true "old argument now invalid" (string-contains (written (form-problems f)) "expected a string"))
        (check-true "cannot invoke" (string-contains (rejection (lambda () (form-invoke! s f))) "need attention"))
        (check "still not run" 0 runs)
        (form-set-argument! f 'value "") (press-keys s "2 x y RET RET")
        (check profile 1 runs) (check "edited source" "xyabc" (document-string source))
        (let ((shown (document-string (session-document s))))
          (check-true "last run" (string-contains shown "last run"))
          (check-true "completed" (string-contains shown "done"))))))
  '("emacs" "modal"))

(let ((s (editor "" "emacs")))
  (define-command (choose s command keys last) "Return COMMAND, KEYS and LAST."
    #:arguments '((command string #:default "run") (keys string #:default "key") (last string #:default "tail"))
    (list command keys last))
  (let ((first (open-command-form! s 'choose)))
    (form-set-argument! first 'command "changed") (sset! s 'focus 0)
    (let ((second (open-command-form! s 'choose)))
      (check "distinct forms" 2 (length (filter (lambda (b) (string-prefix? "*arguments: choose " (buffer-name b))) (buffer-list))))
      (check "changed form" '("changed" "key" "tail") (form-invoke! s first))
      (check "independent defaults" '("run" "key" "tail") (form-invoke! s second)))))

(let* ((s (editor "abc" "emacs")) (source (session-document s)) (seen #f))
  (define-command (mark s at password text) "Record AT, PASSWORD and TEXT."
    #:arguments '((at location) (password string #:sensitive) (text string))
    (set! seen (list (location-position at) password text)))
  (invoke s 'mark (dict 'at (location source 2) 'password "hunter2" 'text "short"))
  (let ((old (car (kept-operation-records))))
    (view-edit! (session-view s) '((0 0 ">>")) "new")
    (let* ((f (open-command-form! s 'mark #:record old)) (args (written (form-arguments f))))
      (check "secret not replayed" #f (string-contains args "hunter2"))
      (check "redaction not a value" #f (string-contains args "<redacted>"))
      (check "password required" '(password) (map car (form-problems f)))
      (check "opening does not run" 2 (car seen))
      (form-set-argument! f 'password "new-password") (form-invoke! s f)
      (check "location moved with edit" 4 (car seen))
      (let ((new (car (kept-operation-records))))
        (check "linked operation" (operation-serial (record-operation old)) (operation-parent-serial (record-operation new)))
        (check "new secret not recorded" #f (string-contains (written (record-arguments new)) "new-password"))))))

(let ((s (editor "" "emacs")) (seen #f))
  (define-command (keep s text) "Keep TEXT." #:arguments '((text string)) (set! seen text))
  (invoke s 'keep (dict 'text (make-string 1000 #\x)))
  (let* ((old (car (kept-operation-records))) (f (open-command-form! s 'keep #:record old)))
    (check "shortened argument unavailable" '(text) (record-unavailable-arguments old))
    (check "form starts empty" 0 (dict-size (form-arguments f)))
    (form-set-argument! f 'text "new")
    (define-command (keep s text) "Keep TEXT differently." #:arguments '((text string)) (set! seen (string-append text "!")))
    (check-true "must review new definition" (string-contains (rejection (lambda () (form-invoke! s f))) "command changed"))
    (check "original invocation" 1000 (string-length seen))
    (form-invoke! s f) (check "reviewed definition runs" "new!" seen)))

(let ((s (editor "" "emacs")) (runs 0))
  (define-command (maybe s count) "Use COUNT when given."
    #:arguments '((count integer #:optional)) (set! runs (+ runs 1)))
  (let ((f (open-command-form! s 'maybe)))
    (form-set-argument! f 'count 3) (form-clear-argument! f 'count)
    (check "optional argument omitted" '() (form-problems f))
    (form-invoke! s f) (check "ran" 1 runs)
    (set-session-panes! s (cdr (session-panes s)) 0)
    (check-true "source pane closed" (string-contains (rejection (lambda () (form-invoke! s f))) "source pane was closed"))
    (check "did not run in another pane" 1 runs)))
(test-failures)
