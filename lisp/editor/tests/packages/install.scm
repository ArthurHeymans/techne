(require "../../../test.scm")
(require "../../dispatch.scm")
(import (techne editor) (techne packages) (techne path))
(provide install-and-use restore-offline)
(define fixture '(package pkg-test "entry.scm" ((pkg-hello "Say hello.") (pkg-other "Another entry."))
                          ((pkg-count 2 integer "Number of greetings."))))
(define code "(import (techne editor))
(define-command (pkg-hello s value) \"Say hello.\" #:arguments '((value integer)) (+ value (option #f 'pkg-count)))
(define-command (pkg-other s n) \"Another entry.\" n)")
(define (git root . args)
  (unless (eqv? 0 (call-with-process "git" args process-wait #:directory root #:stderr 'inherit)) (error "git failed" args)))
(define (bad? f) (guard (e (#t #t)) (f) #f))
(define (install-and-use tmp)
  (let* ((source (path-join tmp "repo")) (dir (path-join tmp "store")) (spec `(local ,source (tag "v1"))))
    (for-each (lambda (pair)
                (let* ((boot (car pair)) (runtime (cadr pair)) (path (package-path (find-package boot))))
                  (load-package boot path)
                  (check "bootstrap reload leaves runtime cold" #f (find-package runtime))
                  (check-true "entry remains advertised" (command-doc boot))))
              '((ibuffer ibuffer-runtime) (compile compile-runtime)))
    ;; A built-in in a directory of its own is advertised from its manifest,
    ;; as what is installed below: no bootstrap is loaded for it.
    (check "a package directory stays cold" #f (find-package 'mail))
    (check-true "its identity is reserved" (package-declared? 'mail))
    (check-true "its command is advertised" (command-doc 'mail))
    (check "its option is declared early" 'bottom (option #f 'mail-reader-position))
    (check "its libraries are found, none loaded" #f (and (member "(mail store)" (loaded-modules)) #t))
    (run-command (current-session) 'ibuffer 1)
    (let ((runtime (find-package 'ibuffer-runtime)) (override (make-scope 'reload-override)))
      (check-true "buffer list activated" runtime)
      (with-scope override (register-command! 'ibuffer "My buffer list." (lambda (s n) 'mine)))
      (load-package 'ibuffer (package-path (find-package 'ibuffer)))
      (check "bootstrap reload preserves active runtime" #t (eq? runtime (find-package 'ibuffer-runtime)))
      (check "user override stays above reloaded declaration" 'mine ((command 'ibuffer) (current-session) 1))
      (scope-shutdown! override)
      (check "active implementation still runs" #t (run-command (current-session) 'ibuffer 1)))
    (check "forge URL" "https://github.com/a/b.git" (package-source-url (parse-package-source '(github "a/b"))))
    (for-each (lambda (s) (check "invalid recipe" #t (bad? (lambda () (parse-package-source s)))))
              '((github "not-a-pair") (github "a/b" "main") (git "file:///tmp/repo") (github "../repo")))
    (create-directory source #o700)
    (git source "init" "--quiet")
    (call-with-output-file (path-join source "entry.scm") (lambda (p) (display code p)))
    (call-with-output-file (path-join source "techne-package.scm") (lambda (p) (write fixture p)))
    (git source "add" "entry.scm" "techne-package.scm")
    (git source "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qm" "fixture")
    (git source "-c" "tag.gpgSign=false" "tag" "v1")
    ;; Each rejected candidate is a real fetched checkout. It must leave
    ;; neither a pin to restore nor any partially announced commands/options.
    (for-each
      (lambda (manifest)
        (let ((file (path-join source "techne-package.scm")))
          (delete-file file) (call-with-output-file file (lambda (p) (write manifest p))))
        (git source "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qam" "collision")
        (check "reject conflicting manifest" #t (bad? (lambda () (package-install! `(local ,source) #:directory dir))))
        (check "no checkout published" '() (directory-list dir))
        (check "no command published" #f (command-doc 'pkg-collision))
        (check "built-in remains cold" #f (find-package 'markdown-preview))
        (check "original option default" 'bottom (option #f 'mail-reader-position)))
      '((package markdown-preview "entry.scm" ((pkg-collision "Unrelated command.")) ())
        (package different-name "entry.scm" ((pkg-collision "Unrelated command."))
                 ((mail-reader-position 123 integer "Conflicting declaration.")))))
    (register-package-recipe! `(recipe pkg-test ,spec))
    (check "install by catalog name" 'pkg-test (package-install! 'pkg-test #:directory dir))
    (delete-path source #t)
    (check "repeat without remote" 'pkg-test (package-install! spec #:directory dir))
    (check "discover" "Say hello." (command-doc 'pkg-hello))
    (check "proxy is callable" #t (procedure? (command 'pkg-hello)))
    (set-option! 'pkg-count 7)
    (check "agent cannot cold activate" #t (bad? (lambda () (invoke (current-session) 'pkg-hello (dict 'value 8) #:principal "bot"))))
    (check "still cold" #f (find-package 'pkg-test))
    (let ((user (make-scope 'test-override)))
      (with-scope user (register-command! 'pkg-other "User override." (lambda (s n) 'override)))
      (check "real contract, early option" 15 (invoke (current-session) 'pkg-hello (dict 'value 8)))
      (check "sibling did not bury override" 'override ((command 'pkg-other) (current-session) 1))
      (scope-shutdown! user))
    (check "real argument validation" #t (bad? (lambda () (invoke (current-session) 'pkg-hello (dict 'value "wrong")))))
    (check "one generation" 1 (package-generation (find-package 'pkg-test)))
    (unload-package 'pkg-test)
    (check "declaration survives unload" "Say hello." (command-doc 'pkg-hello))
    (check "load again" 15 (invoke (current-session) 'pkg-hello (dict 'value 8)))
    ;; A checkout that cannot be made known here is not left in the store,
    ;; where it would fail every later install and restore.
    (let ((broken (path-join tmp "broken")) (before (directory-list dir)))
      (create-directory broken #o700)
      (git broken "init" "--quiet")
      (call-with-output-file (path-join broken "entry.scm")
        (lambda (p) (display "(import (techne editor))\n(define-command (pkg-broken s n) \"Broken.\" n)" p)))
      (call-with-output-file (path-join broken "techne-package.scm")
        (lambda (p) (write '(package pkg-broken
                              (depends (pkg-absent (path "absent")))
                              (editor "entry.scm" (commands (pkg-broken "Broken."))))
                           p)))
      (git broken "add" "entry.scm" "techne-package.scm")
      (git broken "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qm" "broken")
      (check "a dependency that is missing" #t (bad? (lambda () (package-install! `(local ,broken) #:directory dir))))
      (check "its checkout is not kept" before (directory-list dir))
      (check "nor its command" #f (command-doc 'pkg-broken)))
    (let ((file (path-join tmp "incomplete.scm")))
      (call-with-output-file file (lambda (p) (display "(import (techne editor))\n(define-command (first-offer s n) \"First.\" n)\n(define-option incomplete-leak #t \"Never published.\")" p)))
      (register-command-package! 'incomplete file '((first-offer "First offer.") (another-offer "Another offer.")))
      (check "even a present command waits for all offers" #t (bad? (lambda () ((command 'first-offer) (current-session) 1))))
      (check "failed generation stays cold" #f (find-package 'incomplete))
      (check "unrelated registration discarded" #f (find-option 'incomplete-leak))
      (check "offer still registered" "First offer." (command-doc 'first-offer))
      (delete-file file)
      (call-with-output-file file (lambda (p) (display "(import (techne editor))\n(define-command (first-offer s n) \"First.\" n)\n(define-command (another-offer s n) \"Another.\" n)" p)))
      (check "retry corrected package" 9 ((command 'first-offer) (current-session) 9))))
  (test-failures))
(define (restore-offline tmp)
  (let ((owner (make-scope 'restore-option)))
    (with-scope owner (register-option! 'pkg-count "original" "Original option." #:type 'string))
    (check "restore rejects option collision" #t (bad? (lambda () (package-restore! #:directory (path-join tmp "store")))))
    (check "failed restore preserves declaration" "original" (option #f 'pkg-count))
    (check "failed restore does not reserve package" #f (package-declared? 'pkg-test))
    (check "failed restore publishes no command" #f (command-doc 'pkg-hello))
    (scope-shutdown! owner))
  (check "restore into fresh editor" '(pkg-test) (package-restore! #:directory (path-join tmp "store")))
  (check "still cold" #f (find-package 'pkg-test))
  (check "real command" 5 (invoke (current-session) 'pkg-hello (dict 'value 3)))
  (test-failures))
