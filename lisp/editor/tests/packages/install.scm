(require "../../../test.scm")
(require "../../dispatch.scm")
(import (techne editor) (techne packages) (techne path))
(provide install-and-use restore-offline)
(define fixture '(package (acme pkg-test)
                   (version "0.1.0")
                   (editor "entry.scm"
                     (commands (pkg-hello "Say hello.") (pkg-other "Another entry."))
                     (options (pkg-count 2 integer "Number of greetings.")))))
(define code "(import (techne editor))
(define-command (pkg-hello s value) \"Say hello.\" #:arguments '((value integer)) (+ value (option #f 'pkg-count)))
(define-command (pkg-other s n) \"Another entry.\" n)")
(define (git root . args)
  (unless (eqv? 0 (call-with-process "git" args process-wait #:directory root #:stderr 'inherit)) (error "git failed" args)))
(define (bad? f) (guard (e (#t #t)) (f) #f))
(define (install-and-use tmp)
  (let* ((source (path-join tmp "repo")) (dir (path-join tmp "store")) (spec `(local ,source (tag "v1"))))
    (for-each (lambda (pair)
                (let* ((boot (car pair)) (runtime (cadr pair)) (path (package-path (find-package boot))))
                  (load-package boot path)
                  (check "bootstrap reload leaves runtime cold" #f (find-package runtime))
                  (check-true "entry remains advertised" (command-doc boot))))
              '((ibuffer ibuffer-runtime) (compile compile-runtime)))
    ;; A built-in in a directory of its own is advertised from its manifest,
    ;; as what is installed below: no bootstrap is loaded for it.
    (check "a package directory stays cold" #f (find-package '(techne mail)))
    (check-true "its identity is reserved" (package-declared? '(techne mail)))
    (check-true "its command is advertised" (command-doc 'mail))
    (check "its option is declared early" 'bottom (option #f 'mail-reader-position))
    (check "its libraries are found, none loaded" #f (and (member "(techne mail store)" (loaded-modules)) #t))
    (run-command (current-session) 'ibuffer 1)
    (let ((runtime (find-package 'ibuffer-runtime)) (override (make-scope 'reload-override)))
      (check-true "buffer list activated" runtime)
      (with-scope override (register-command! 'ibuffer "My buffer list." (lambda (s n) 'mine)))
      (load-package 'ibuffer (package-path (find-package 'ibuffer)))
      (check "bootstrap reload preserves active runtime" #t (eq? runtime (find-package 'ibuffer-runtime)))
      (check "user override stays above reloaded declaration" 'mine ((command 'ibuffer) (current-session) 1))
      (scope-shutdown! override)
      (check "active implementation still runs" #t (run-command (current-session) 'ibuffer 1)))
    (check "forge URL" "https://github.com/a/b.git" (package-source-url (parse-package-source '(github "a/b"))))
    (for-each (lambda (s) (check "invalid recipe" #t (bad? (lambda () (parse-package-source s)))))
              '((github "not-a-pair") (github "a/b" "main") (git "file:///tmp/repo") (github "../repo")))
    (create-directory source #o700)
    (git source "init" "--quiet")
    (call-with-output-file (path-join source "entry.scm") (lambda (p) (display code p)))
    (call-with-output-file (path-join source "techne-package.scm") (lambda (p) (write fixture p)))
    (git source "add" "entry.scm" "techne-package.scm")
    (git source "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qm" "fixture")
    (git source "-c" "tag.gpgSign=false" "tag" "v1")
    ;; Each rejected candidate is a real fetched checkout. It must leave
    ;; neither a pin to restore nor any partially announced commands/options.
    (for-each
      (lambda (manifest)
        (let ((file (path-join source "techne-package.scm")))
          (delete-file file) (call-with-output-file file (lambda (p) (write manifest p))))
        (git source "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qam" "collision")
        (check "reject conflicting manifest" #t (bad? (lambda () (package-install! `(local ,source) #:directory dir))))
        (check "no checkout published" '() (directory-list dir))
        (check "no command published" #f (command-doc 'pkg-collision))
        (check "built-in remains cold" #f (find-package '(techne mail)))
        (check "original option default" 'bottom (option #f 'mail-reader-position)))
      '((package (techne mail) (editor "entry.scm" (commands (pkg-collision "Unrelated command."))))
        (package (acme different-name)
          (editor "entry.scm"
            (commands (pkg-collision "Unrelated command."))
            (options (mail-reader-position 123 integer "Conflicting declaration."))))))
    (register-package-recipe! `(recipe (acme pkg-test) ,spec))
    (check "install by catalog name" '(acme pkg-test) (package-install! '(acme pkg-test) #:directory dir))
    (delete-path source #t)
    (check "repeat without remote" '(acme pkg-test) (package-install! spec #:directory dir))
    (check "discover" "Say hello." (command-doc 'pkg-hello))
    (check "proxy is callable" #t (procedure? (command 'pkg-hello)))
    (set-option! 'pkg-count 7)
    (check "agent cannot cold activate" #t (bad? (lambda () (invoke (current-session) 'pkg-hello (dict 'value 8) #:principal "bot"))))
    (check "still cold" #f (find-package '(acme pkg-test)))
    (let ((user (make-scope 'test-override)))
      (with-scope user (register-command! 'pkg-other "User override." (lambda (s n) 'override)))
      (check "real contract, early option" 15 (invoke (current-session) 'pkg-hello (dict 'value 8)))
      (check "sibling did not bury override" 'override ((command 'pkg-other) (current-session) 1))
      (scope-shutdown! user))
    (check "real argument validation" #t (bad? (lambda () (invoke (current-session) 'pkg-hello (dict 'value "wrong")))))
    (check "one generation" 1 (package-generation (find-package '(acme pkg-test))))
    (unload-package '(acme pkg-test))
    (check "declaration survives unload" "Say hello." (command-doc 'pkg-hello))
    (check "load again" 15 (invoke (current-session) 'pkg-hello (dict 'value 8)))
    ;; A checkout that cannot be made known here is not left in the store,
    ;; where it would fail every later install and restore.
    (let ((broken (path-join tmp "broken")) (before (directory-list dir)))
      (create-directory broken #o700)
      (git broken "init" "--quiet")
      (call-with-output-file (path-join broken "entry.scm")
        (lambda (p) (display "(import (techne editor))\n(define-command (pkg-broken s n) \"Broken.\" n)" p)))
      (call-with-output-file (path-join broken "techne-package.scm")
        (lambda (p) (write '(package (acme pkg-broken)
                              (depends ((acme pkg-absent) (path "absent")))
                              (editor "entry.scm" (commands (pkg-broken "Broken."))))
                           p)))
      (git broken "add" "entry.scm" "techne-package.scm")
      (git broken "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qm" "broken")
      (check "a dependency that is missing" #t (bad? (lambda () (package-install! `(local ,broken) #:directory dir))))
      (check "its checkout is not kept" before (directory-list dir))
      (check "nor its command" #f (command-doc 'pkg-broken)))
    (let ((file (path-join tmp "incomplete.scm")))
      (call-with-output-file file (lambda (p) (display "(import (techne editor))\n(define-command (first-offer s n) \"First.\" n)\n(define-option incomplete-leak #t \"Never published.\")" p)))
      (register-command-package! 'incomplete file '((first-offer "First offer.") (another-offer "Another offer.")))
      (check "even a present command waits for all offers" #t (bad? (lambda () ((command 'first-offer) (current-session) 1))))
      (check "failed generation stays cold" #f (find-package 'incomplete))
      (check "unrelated registration discarded" #f (find-option 'incomplete-leak))
      (check "offer still registered" "First offer." (command-doc 'first-offer))
      (delete-file file)
      (call-with-output-file file (lambda (p) (display "(import (techne editor))\n(define-command (first-offer s n) \"First.\" n)\n(define-command (another-offer s n) \"Another offer.\" n)" p)))
      (check "retry corrected package" 9 ((command 'first-offer) (current-session) 9))))
  (install-from-subdirectory tmp)
  (test-failures))

;; A repository of several packages, side by side: one is installed, by
;; name, with the packages beside it that it depends on, at the same commit.
(define (write-file! root relative . forms)
  (let ((file (path-join root relative)))
    (make-directory (path-directory file))
    (call-with-output-file file (lambda (p) (for-each (lambda (f) (write f p) (newline p)) forms)))))
(define (loaded? name) (and (member name (loaded-modules)) #t))
(define (install-from-subdirectory tmp)
  (let ((multi (path-join tmp "multi")) (dir (path-join tmp "store-multi")))
    (check "the package wanted, in either place" '((acme x) (acme x))
           (map (lambda (s) (package-source-package (parse-package-source s)))
                '((github "a/b" (package (acme x)) (tag "v1")) (github "a/b" (tag "v1") (package (acme x))))))
    (check "none wanted" #f (package-source-package (parse-package-source '(github "a/b" (tag "v1")))))
    (for-each (lambda (s) (check "invalid source" #t (bad? (lambda () (parse-package-source s)))))
              '((github "a/b" (package (acme x)) (package (acme y))) (github "a/b" (tag "a") (branch "b"))
                (github "a/b" (package x)) (github "a/b" (package "x")) (github "a/b" (package (../x y)))))
    (check "a recipe names the package its source does" #t
           (bad? (lambda () (register-package-recipe! '(recipe (acme multi-edit) (github "a/b" (package (acme multi-other))))))))
    (create-directory multi #o700)
    (git multi "init" "--quiet")
    (write-file! multi "packages/multi-util/techne-package.scm" '(package (acme multi-util)))
    (write-file! multi "packages/multi-util/lib/acme/multi-util/words.sld"
                 '(define-library (acme multi-util words) (export shout) (import (scheme base))
                    (begin (define (shout s) (string-append s "!")))))
    (write-file! multi "packages/multi-edit/techne-package.scm"
                 '(package (acme multi-edit)
                    (depends ((acme multi-util) (path "../multi-util")))
                    (editor "entry.scm" (commands (multi-shout "Shout.")))))
    (write-file! multi "packages/multi-edit/entry.scm"
                 '(import (techne editor) (acme multi-util words))
                 '(define-command (multi-shout s n) "Shout." (shout "hi")))
    (write-file! multi "packages/multi-more/techne-package.scm"
                 '(package (acme multi-more)
                    (depends ((acme multi-util) (path "../multi-util")))
                    (editor "entry.scm" (commands (multi-more "Shout more.")))))
    (write-file! multi "packages/multi-more/entry.scm"
                 '(import (techne editor) (acme multi-util words))
                 '(define-command (multi-more s n) "Shout more." (shout (shout "more"))))
    (write-file! multi "packages/multi-other/techne-package.scm"
                 '(package (acme multi-other) (editor "entry.scm" (commands (multi-other "Another package.")))))
    (write-file! multi "packages/multi-other/entry.scm"
                 '(import (techne editor))
                 '(define-command (multi-other s n) "Another package." 'other))
    ;; One depending on a package outside the repository, which is there:
    ;; beside the store, as far above the checkout as above a fetch of it.
    (write-file! multi "packages/multi-stray/techne-package.scm"
                 '(package (acme multi-stray)
                    (depends ((acme multi-outside) (path "../../../../../multi-outside")))
                    (editor "entry.scm" (commands (multi-stray "Stray.")))))
    (write-file! multi "packages/multi-stray/entry.scm" '(import (techne editor)) '(define-command (multi-stray s n) "Stray." n))
    (write-file! tmp "multi-outside/techne-package.scm" '(package (acme multi-outside)))
    ;; A package in a directory a pin would not name: no candidate.
    (write-file! multi "packages/multi spaced/techne-package.scm"
                 '(package (acme multi-spaced) (editor "entry.scm" (commands (multi-spaced "Spaced.")))))
    (write-file! multi "packages/multi spaced/entry.scm" '(import (techne editor)) '(define-command (multi-spaced s n) "Spaced." n))
    (git multi "add" ".")
    (git multi "-c" "user.name=Test" "-c" "user.email=test@example.org" "-c" "commit.gpgSign=false" "commit" "-qm" "packages")
    (for-each (lambda (case)
                (check (car case) #t
                       (and (string-contains (guard (e (#t (condition/report-string e))) (package-install! (cadr case) #:directory dir) "")
                                             (car case))
                            #t))
                (check "no checkout published" '() (directory-list dir)))
              `(("several packages" (local ,multi))
                ("no package of this name" (local ,multi (package (acme multi-none))))
                ("no package of this name" (local ,multi (package (acme multi-spaced))))
                ("outside its repository" (local ,multi (package (acme multi-stray))))))
    (check "nothing of them advertised" '(#f #f) (map command-doc '(multi-shout multi-stray)))
    (check "nor made known" #f (%library-provider '(acme multi-outside)))
    (check "install the one named" '(acme multi-edit)
           (package-install! `(local ,multi (package (acme multi-edit))) #:directory dir))
    (check "its command" "Shout." (command-doc 'multi-shout))
    (check "not the one beside it" #f (command-doc 'multi-other))
    (check "cold, its dependency too" '(#f #f) (list (and (find-package '(acme multi-edit)) #t) (loaded? "(acme multi-util words)")))
    (check "first use loads it, with the library of the package beside it" "hi!" ((command 'multi-shout) (current-session) 1))
    (check "its dependency is of the checkout" #t
           (string-prefix? (file-truename dir) (%library-provider '(acme multi-util))))
    ;; Another package of the repository depending on the same one beside
    ;; it: both find it in the one checkout they share.
    (check "another, with the same dependency" '(acme multi-more)
           (package-install! `(local ,multi (package (acme multi-more))) #:directory dir))
    (check "which it finds too" "more!!" ((command 'multi-more) (current-session) 1))
    (register-package-recipe! `(recipe (acme multi-other) (local ,multi)))
    (check "a catalog name says which" '(acme multi-other) (package-install! '(acme multi-other) #:directory dir))
    (check "that one runs" 'other ((command 'multi-other) (current-session) 1))
    (check "one checkout for the repository" 1 (length (directory-list dir)))
    ;; One that cannot be installed, asked of the checkout that is there.
    (check "refused beside them" #t (bad? (lambda () (package-install! `(local ,multi (package (acme multi-stray))) #:directory dir))))
    (check "and not advertised" #f (command-doc 'multi-stray))
    (delete-path multi #t)
    (check "repeat without remote" '(acme multi-edit)
           (package-install! `(local ,multi (package (acme multi-edit))) #:directory dir))))

(define (restore-offline tmp)
  (let ((owner (make-scope 'restore-option)))
    (with-scope owner (register-option! 'pkg-count "original" "Original option." #:type 'string))
    (check "restore rejects option collision" #t (bad? (lambda () (package-restore! #:directory (path-join tmp "store")))))
    (check "failed restore preserves declaration" "original" (option #f 'pkg-count))
    (check "failed restore does not reserve package" #f (package-declared? '(acme pkg-test)))
    (check "failed restore publishes no command" #f (command-doc 'pkg-hello))
    (scope-shutdown! owner))
  (check "restore into fresh editor" '((acme pkg-test)) (package-restore! #:directory (path-join tmp "store")))
  (check "still cold" #f (find-package '(acme pkg-test)))
  (check "real command" 5 (invoke (current-session) 'pkg-hello (dict 'value 3)))
  ;; Packages from a repository's subdirectories, each where its pin says.
  (check "restore those of a repository of several" '("(acme multi-edit)" "(acme multi-more)" "(acme multi-other)")
         (sort (map repr (package-restore! #:directory (path-join tmp "store-multi"))) string<?))
  (check "cold" #f (and (find-package '(acme multi-edit)) #t))
  (check "with the package beside it" "hi!" ((command 'multi-shout) (current-session) 1))
  (check "which another shares" "more!!" ((command 'multi-more) (current-session) 1))
  (test-failures))
