;;; Source faces in a unified patch. Parse the old and new snippets separately,
;;; without their signs, and map captures back to the displayed lines.

(import (techne editor))
(provide patch-syntax paint-patch-line)

(define (bytes text) (bytevector-length (string->utf8 text)))

;; Each pair is (patch-row . source). Prefer the new side for shared context.
(define (highlight-side! marks language reversed-lines)
  (when (and language (pair? reversed-lines))
    (let* ((lines (reverse reversed-lines))
           (text (string-join (map cdr lines) "\n"))
           (faces (if (<= (bytes text) 16384)
                      (guard (e (#t '())) (syntax-highlights (make-document text) language))
                      '())))
      (let loop ((lines lines) (start 0) (faces faces))
        (unless (or (null? lines) (null? faces))
          (let* ((line (car lines)) (end (+ start (bytes (cdr line))))
                 (live (let skip ((fs faces))
                         (if (and (pair? fs) (<= (caddar fs) start)) (skip (cdr fs)) fs)))
                 (here (let take ((fs live))
                         (if (and (pair? fs) (< (cadar fs) end)) (cons (car fs) (take (cdr fs))) '()))))
            (unless (null? here)
              (hash-table-set! marks (car line)
                (filter-map (lambda (f)
                              (let ((a (max start (cadr f))) (b (min end (caddr f))))
                                (and (< a b) (list (car f) (+ 1 (- a start)) (+ 1 (- b start))))))
                            here)))
            (loop (cdr lines) (+ end 1) live)))))))

(define (header-language line fallback)
  ;; Git may use a tab after a name containing spaces, or quote the name.
  (let* ((field (substring line 4 (string-length line)))
         (name (if (string=? field "") "" (car (string-split field "\t"))))
         (name (if (string-suffix? "\"" name) (substring name 0 (- (string-length name) 1)) name)))
    (if (string=? name "/dev/null") #f (or (path-language name) fallback))))

(define (patch-syntax lines path)
  "Return source face spans by zero-based patch line, with byte offsets.
PATH supplies the language when LINES omit their file headers."
  (let ((marks (make-hash-table)) (fallback (path-language path)))
    (let scan ((lines lines) (i 0) (old fallback) (new fallback))
      (unless (null? lines)
        (let ((line (car lines)))
          (cond ((string-prefix? "diff " line) (scan (cdr lines) (+ i 1) fallback fallback))
                ((string-prefix? "--- " line) (scan (cdr lines) (+ i 1) (header-language line fallback) new))
                ((string-prefix? "+++ " line) (scan (cdr lines) (+ i 1) old (header-language line fallback)))
                ((and (or old new) (string-prefix? "@@ " line))
                 (let hunk ((rest (cdr lines)) (i (+ i 1)) (before '()) (after '()))
                   (let ((sign (and (pair? rest) (not (string=? (car rest) "")) (string-ref (car rest) 0))))
                     (cond ((memv sign '(#\space #\- #\+))
                            (let ((entry (cons i (substring (car rest) 1 (string-length (car rest))))))
                              (hunk (cdr rest) (+ i 1) (if (eqv? sign #\+) before (cons entry before))
                                                       (if (eqv? sign #\-) after (cons entry after)))))
                           ((eqv? sign #\\) (hunk (cdr rest) (+ i 1) before after))
                           (else (highlight-side! marks old before)
                                 (highlight-side! marks new after)
                                 (scan rest i old new))))))
                (else (scan (cdr lines) (+ i 1) old new))))))
    marks))

(define (paint-patch-line runs faces)
  "Colour RUNS using source FACES, leaving signs and refined words intact."
  (let* ((chunks (map (lambda (r) (string->utf8 (car r))) runs))
         (paint (make-vector (apply + (map bytevector-length chunks)) #f)))
    (for-each (lambda (f)
                (do ((i (cadr f) (+ i 1))) ((>= i (caddr f)))
                  (vector-set! paint i (car f))))
              faces)
    (let loop ((runs runs) (chunks chunks) (offset 0) (out '()))
      (if (null? runs) (reverse out)
          (let* ((run (car runs)) (face (cadr run)) (chunk (car chunks)) (len (bytevector-length chunk)))
            (if (not (memq face '(diff.added diff.removed diff.context)))
                (loop (cdr runs) (cdr chunks) (+ offset len) (cons run out))
                (let piece ((start 0) (out out))
                  (if (= start len) (loop (cdr runs) (cdr chunks) (+ offset len) out)
                      (let* ((colour (vector-ref paint (+ offset start)))
                             (end (let next ((i (+ start 1)))
                                    (if (and (< i len) (eq? colour (vector-ref paint (+ offset i))))
                                        (next (+ i 1)) i))))
                        (piece end (cons (list (utf8->string (bytevector-copy chunk start end)) (or colour face)) out)))))))))))
