(require "remote.scm")
(provide terminal-directory-uri)

(define (decode-path s)
  (let* ((raw (string->utf8 s)) (len (bytevector-length raw)) (out (open-output-bytevector)))
    (let decode ((i 0))
      (if (= i len) (utf8->string (get-output-bytevector out))
          (let ((b (bytevector-u8-ref raw i)))
            (if (= b 37)
                (let ((n (and (< (+ i 2) len) (string->number (utf8->string raw (+ i 1) (+ i 3)) 16))))
                  (unless (and (exact-integer? n) (<= 0 n 255)) (error "Invalid file URI"))
                  (write-u8 n out) (decode (+ i 3)))
                (begin (write-u8 b out) (decode (+ i 1)))))))))

(define (terminal-directory-uri dir host uri)
  "Resolve OSC 7 URI on the same route as DIR, for endpoint HOST."
  (and (string-prefix? "file://" uri)
       (let* ((tail (substring uri 7)) (slash (string-index tail #\/))
              (authority (and slash (substring tail 0 slash))))
         (and slash (or (member authority '("" "localhost")) (and host (string-ci=? authority host)))
              (let ((path (guard (e (#t #f)) (decode-path (substring tail slash)))))
                (and path (not (any (lambda (c) (< (char->integer c) 32)) (string->list path)))
                     (not (and (not (remote-path? dir)) (remote-path? path)))
                     (location-at dir (if (string-suffix? "/" path) path (string-append path "/")))))))))
