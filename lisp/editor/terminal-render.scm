;;; Cached row projection. History offsets are absolute in a virtual log,
;;; so evicting its first row does not move the remaining index entries.
(require "faces.scm")
(import (techne terminal))
(provide make-terminal-projection terminal-project! terminal-layers terminal-live-start terminal-caret)

(define-record-type projection
  (%projection writer history first end base live screen caret) projection?
  (writer writer) (history history)
  (first first first-set!) (end end end-set!) (base base base-set!)
  (live live live-set!) (screen screen screen-set!) (caret terminal-caret caret-set!))

(define (make-terminal-projection d limit)
  "Make a projection into document D with a scrollback row LIMIT."
  (%projection (make-view d "terminal") (make-vector (max 1 limit) #f) 0 0 0 0 '#() 0))
(define (terminal-live-start p)
  "Return the start of the active screen in the document of P."
  (- (live p) (base p)))
(define (width text) (bytevector-length (string->utf8 text)))

(define (hex n)
  (let ((digits "0123456789abcdef"))
    (string (string-ref digits (quotient n 16)) (string-ref digits (modulo n 16)))))
(define (color c default)
  (cond ((not c) default)
        ((pair? c) (string-append "#" (apply string-append (map hex c))))
        ((< c 16) (string->symbol (string-append "ansi-" (number->string c))))
        ((>= c 232) (let ((h (hex (+ 8 (* 10 (- c 232)))))) (string-append "#" h h h)))
        (else (let* ((n (- c 16))
                     (level (lambda (i) (hex (if (= i 0) 0 (+ 55 (* 40 i)))))))
                (string-append "#" (level (quotient n 36)) (level (modulo (quotient n 6) 6)) (level (modulo n 6)))))))

(define colors (make-hash-table))
(define (style-face style)
  (define (field k default) (let ((v (assq k style))) (if v (cdr v) default)))
  (let* ((inverse (field 'inverse #f))
         (fg (color (field (if inverse 'bg 'fg) #f) (if inverse 'base '())))
         (bg (color (field (if inverse 'fg 'bg) #f) (if inverse 'text '())))
         (weight (field 'weight '())) (slant (field 'slant '()))
         (underline (field 'underline '())) (strike (field 'strike '()))
         (key (list fg bg weight slant underline strike))
         (known (hash-table-ref/default colors key #f)))
    (if (and known (find-face known)) known
        ;; Output must not grow the global face table without limit.
        (and (or known (< (hash-table-size colors) 1024))
             (let ((name (or known (string->symbol (string-append "terminal-cell-" (number->string (hash-table-size colors)))))))
               (register-face! name "An ANSI terminal cell." #:inherit #f #:fg fg #:bg bg #:weight weight
                               #:slant slant #:underline underline #:strike strike)
               (hash-table-set! colors key name)
               name)))))

;; (live text, trimmed history text, byte position per column, style runs,
;; live byte size). Screen rows are padded so the cursor can sit on a blank.
(define (render-row r)
  (or (terminal-row-cache r)
      (let* ((cells (terminal-row-cells r)) (cols (vector-length cells))
             (double (and (>= cols 2) (terminal-row-double-width? r)))
             (visible-cols (if double (quotient cols 2) cols)) (pos (make-vector visible-cols))
             (out (open-output-string)))
        (let loop ((i 0) (at 0) (chars 0) (ink 0) (runs '()) (prior #f) (face #f))
          (if (= i visible-cols)
              (let* ((text (get-output-string out))
                     (snapshot (vector (string-append text "\n") (string-append (substring text 0 ink) "\n")
                                       pos (reverse runs) (+ at 1))))
                (terminal-row-cache-set! r snapshot)
                snapshot)
              (let ((cell (vector-ref cells i)))
                (if (eq? cell 'tail)
                    (begin (vector-set! pos i (vector-ref pos (- i 1)))
                           (loop (+ i 1) at chars ink runs prior face))
                    (let* ((style (if cell (cdr cell) '()))
                           (wide (and (< (+ i 1) visible-cols) (eq? (vector-ref cells (+ i 1)) 'tail)))
                           (text (cond ((not cell) " ")
                                       ((assq 'conceal style)
                                        (if wide "  " " "))
                                       (else (car cell))))
                           ;; Preserve DEC column spacing without scaling the glyphs.
                           (text (if double (string-append text (if wide "  " " ")) text))
                           (face (cond ((null? style) #f) ((eq? style prior) face) (else (style-face style))))
                           (to (+ at (if (not cell) (if double 2 1) (width text)))) (chars (+ chars (string-length text))))
                      (vector-set! pos i at)
                      (display text out)
                      (loop (+ i 1) to chars (if cell chars ink)
                            (cond ((not face) runs)
                                  ((and (pair? runs) (= at (cadar runs)) (eq? face (caddar runs)))
                                   (cons (list (caar runs) to face) (cdr runs)))
                                  (else (cons (list at to face) runs))) style face)))))))))

(define (edit p from to text)
  (unless (and (= from to) (string=? text ""))
    (view-edit! (writer p) (list (list from to text)) "new")))
(define (history-at p i) (vector-ref (history p) (modulo i (vector-length (history p)))))
(define (history-project! p t)
  (let* ((start (terminal-history-start t)) (finish (terminal-history-end t))
         (old-first (first p)) (old-end (end p)) (base (base p)) (live (live p)))
    (when (or (not (= start old-first)) (not (= finish old-end)))
      (let* ((overlap (<= old-first start old-end))
             (cut (if (and overlap (< start old-end)) (car (history-at p start)) live))
             (out (open-output-string)))
        (edit p 0 (- cut base) "")
        (base-set! p cut)
        (let loop ((i (if overlap old-end start)) (at live))
          (if (= i finish)
              (begin (edit p (- live cut) (- live cut) (get-output-string out)) (live-set! p at))
              (let* ((r (render-row (terminal-history-row t i))) (text (vector-ref r 1)))
                (vector-set! (history p) (modulo i (vector-length (history p))) (cons at r))
                (display text out)
                (loop (+ i 1) (+ at (width text))))))
        (first-set! p start) (end-set! p finish)))))

(define (terminal-project! p t)
  "Update projection P with the current screen and history of terminal T."
  (history-project! p t)
  (let* ((old (screen p)) (n (vector-length old)) (rows (terminal-rows t)) (new (make-vector rows))
         (start (terminal-live-start p)) (replace (not (= n rows)))
         (out (and replace (open-output-string))))
    (let loop ((i 0) (at 0) (edits '()))
      (if (= i rows)
          (if replace
              (edit p start (document-length (view-document (writer p))) (get-output-string out))
              (unless (null? edits) (view-edit! (writer p) (reverse edits) "new")))
          (let* ((r (render-row (terminal-row t i))) (text (vector-ref r 0))
                 (entry (and (not replace) (vector-ref old i))))
            (vector-set! new i (cons at r))
            (when replace (display text out))
            (loop (+ i 1) (+ at (vector-ref r 4))
                  (if (or replace (eq? r (cdr entry)) (string=? text (vector-ref (cdr entry) 0))) edits
                      (let ((from (+ start (car entry))))
                        (cons (list from (+ from (vector-ref (cdr entry) 4)) text) edits)))))))
    (screen-set! p new)
    (let* ((entry (vector-ref new (terminal-y t))) (positions (vector-ref (cdr entry) 2)))
      (caret-set! p (+ start (car entry) (vector-ref positions (terminal-x t)))))))

(define (terminal-layers p from to)
  "Return the face spans of projection P intersecting FROM through TO."
  (let ((out '()) (base (base p)) (start (terminal-live-start p)))
    (define (add offset r)
      (for-each (lambda (h)
                  (let ((a (+ offset (car h))) (b (+ offset (cadr h))))
                    (when (and (< a to) (> b from)) (set! out (cons (list a b (caddr h)) out)))))
                (vector-ref r 3)))
    (when (< from start)
      (let ((end (end p)))
        (let search ((lo (first p)) (hi end))
          (if (= lo hi)
              (let scan ((i lo))
                (when (< i end)
                  (let* ((entry (history-at p i)) (offset (- (car entry) base)))
                    (when (< offset to) (add offset (cdr entry)) (scan (+ i 1))))))
              (let* ((mid (quotient (+ lo hi) 2))
                     (after (if (= (+ mid 1) end) start (- (car (history-at p (+ mid 1))) base))))
                (if (<= after from) (search (+ mid 1) hi) (search lo mid)))))))
    (when (> to start)
      (vector-for-each (lambda (e) (add (+ start (car e)) (cdr e))) (screen p)))
    (reverse out)))
