;;; Bounded direct Kitty APC transfers. There is deliberately no file,
;;; temporary-file, shared-memory, compression, or external loader path.
(import (techne terminal) (techne crypto))
(require "terminal-render.scm")
(provide make-terminal-graphics terminal-graphics-event! terminal-graphics-projections)

(define-record-type graphics
  (make-graphics images placements virtual transfer serial)
  graphics?
  (images images images-set!) (placements placements placements-set!)
  (virtual virtual virtual-set!)
  (transfer transfer transfer-set!) (serial serial serial-set!))

(define (make-terminal-graphics)
  "Make storage for a terminal's inline images."
  (make-graphics '() '() '() #f 0))

(define (controls text)
  (filter-map (lambda (s) (let ((i (string-index s #\=)))
                           (and i (= i 1) (cons (string-ref s 0) (substring s 2)))))
              (string-split text ",")))

(define (attr opts k fallback)
  (let ((p (assv k opts))) (if p (cdr p) fallback)))
(define (num opts k fallback)
  (let ((n (string->number (attr opts k ""))))
    (if (and (exact-integer? n) (<= 0 n 4294967295)) n fallback)))
(define limit (* 2 1024 1024))

(define (reply! send opts status)
  (let ((id (num opts #\i 0)) (q (num opts #\q 0)))
    (when (and (> id 0) (< q 2) (or (zero? q) (not (string=? status "OK"))))
      (send (string-append "\x1b;_Gi=" (number->string id) ";" status "\x1b;\\")))))

(define (erase-image! g id)
  (define (other p) (not (eqv? (car p) id)))
  (images-set! g (filter other (images g)))
  (placements-set! g (filter other (placements g)))
  (virtual-set! g (filter other (virtual g))))

(define (decoded opts bytes)
  (case (num opts #\f 32)
    ((100) (image-inline-png bytes))
    ((24 32)
     (let* ((w (num opts #\s 0)) (h (num opts #\v 0)) (n (* w h)) (rgb (= (num opts #\f 32) 24)))
       (unless (and (<= 1 w 4096) (<= 1 h 4096) (<= n 1048576)
                    (= (bytevector-length bytes) (* n (if rgb 3 4)))) (error "Invalid RGB or RGBA size"))
       (if (not rgb) (image-inline-rgba w h bytes)
           (let ((rgba (make-bytevector (* n 4) 255)))
             (do ((i 0 (+ i 1)) (a 0 (+ a 3)) (b 0 (+ b 4))) ((= i n))
               (bytevector-u8-set! rgba b (bytevector-u8-ref bytes a))
               (bytevector-u8-set! rgba (+ b 1) (bytevector-u8-ref bytes (+ a 1)))
               (bytevector-u8-set! rgba (+ b 2) (bytevector-u8-ref bytes (+ a 2))))
             (image-inline-rgba w h rgba)))))
    (else (error "Unsupported image format"))))

(define (place! g t id image opts)
  (if (= (num opts #\U 0) 1)
      (let ((cols (num opts #\c 0)) (rows (num opts #\r 0)))
        (unless (and (<= 1 id #xffffff) (<= 1 cols 512) (<= 1 rows 256))
          (error "Expected virtual image dimensions and a 24-bit ID"))
        (let ((v (cons (list id cols rows image (terminal-alternate? t))
                       (remove (lambda (p) (= id (car p))) (virtual g)))))
          (virtual-set! g (take v (min 8 (length v))))))
      (place-at! g t id image opts)))

(define (place-at! g t id image opts)
  (let* ((row (terminal-row t (terminal-y t))) (column (terminal-x t))
         (cols (max 1 (min (- (terminal-columns t) column)
                           (num opts #\c (quotient (+ (image-width image) 7) 8)))))
         (rows (max 1 (min (terminal-rows t) (num opts #\r (quotient (+ (image-height image) 15) 16)))))
         (placement (list id row column cols rows image (terminal-alternate? t))))
    (let ((ps (cons placement (placements g)))) (placements-set! g (take ps (min 16 (length ps)))))
    ;; Reserve the rows below this image, unless the client owns the cursor.
    (unless (= (num opts #\C 0) 1)
      (terminal-feed! t (make-string (- rows 1) #\newline)))))

(define (transfer! g t opts payload send)
  (let* ((pending (transfer g)) (more (= (num opts #\m 0) 1)) (opts (if pending (caar pending) opts))
         (part (base64-decode payload)) (size (+ (if pending (cdr pending) 0) (bytevector-length part)))
         (parts (cons part (if pending (cdar pending) '()))))
    (unless (and (<= size limit) (member (attr opts #\t "d") '("d"))
                 (equal? (attr opts #\o "") "") (<= (num opts #\U 0) 1))
      (error "Unsupported or oversized image transfer"))
    (if more
        (begin
          (when (or (= (bytevector-length part) 0) (>= (length parts) 1024))
            (error "Invalid image chunk count"))
          (transfer-set! g (cons (cons opts parts) size)))
        (let* ((image (decoded opts (apply bytevector-append (reverse parts))))
               (action (attr opts #\a "t")) (id (num opts #\i 0)))
          (transfer-set! g #f)
          (unless (string=? action "q")
            (when (= id 0) (serial-set! g (- (serial g) 1)) (set! id (serial g)))
            (erase-image! g id)
            (let ((xs (cons (cons id image) (images g))))
              (images-set! g (take xs (min 8 (length xs)))))
            (when (string=? action "T") (place! g t id image opts)))
          (reply! send opts "OK")))))

(define (terminal-graphics-event! g t kind value send)
  "Handle terminal T's graphics event KIND with VALUE in G; reply via SEND."
  (case kind
    ((reset-graphics) (images-set! g '()) (placements-set! g '()) (virtual-set! g '()) (transfer-set! g #f))
    ((clear-images) (placements-set! g (remove (lambda (p) (eq? (list-ref p 6) value)) (placements g))))
    ((graphics)
     (let* ((sep (string-index value #\;)) (opts (controls (if sep (substring value 0 sep) value)))
            (action (attr opts #\a "t")) (id (num opts #\i 0)))
       (guard (e (#t (transfer-set! g #f) (reply! send opts "EINVAL: unsupported or invalid inline image")))
         (cond ((member action '("t" "T" "q"))
                (transfer! g t opts (if sep (substring value (+ sep 1)) "") send))
               ((string=? action "p")
                (let ((image (assv id (images g))))
                  (unless image (error "Unknown image"))
                  (place! g t id (cdr image) opts) (reply! send opts "OK")))
               ((string=? action "d")
                (let ((what (attr opts #\d "a")))
                  (cond ((string=? what "A") (images-set! g '()) (placements-set! g '()) (virtual-set! g '()))
                        ((string=? what "a") (placements-set! g '()) (virtual-set! g '()))
                        ((string=? what "I") (erase-image! g id))
                        ((string=? what "i")
                          (placements-set! g (remove (lambda (p) (eqv? (car p) id)) (placements g)))
                          (virtual-set! g (remove (lambda (p) (eqv? (car p) id)) (virtual g))))
                        (else (error "Unsupported image deletion")))))
               (else (error "Unsupported graphics action"))))))))

;; Recognize the top-left placeholder of a full rectangle. Kitty uses
;; foreground as a 24-bit image ID and U+0305 as coordinate zero.
(define (virtual-origin cell)
  (and (pair? cell) (char=? (string-ref (car cell) 0) #\x10eeee)
       (let* ((s (car cell)) (n (string-length s)) (fg (assq 'fg (cdr cell))))
         (and fg (or (= n 1) (and (= n 3) (char=? (string-ref s 1) #\x0305)
                                  (char=? (string-ref s 2) #\x0305)))
              (let ((c (cdr fg)))
                (if (integer? c) c (+ (* (car c) 65536) (* (cadr c) 256) (caddr c))))))))

(define (virtual-projections g t p)
  (let ((todo (filter (lambda (a) (eq? (list-ref a 4) (terminal-alternate? t))) (virtual g))) (out '()))
    (do ((y 0 (+ y 1))) ((or (null? todo) (= y (terminal-rows t))) (reverse out))
      (let* ((row (terminal-row t y)) (at (terminal-grid-offset p y)))
        (when (and at (not (terminal-row-ascii row)))
          (let* ((cells (terminal-row-cells row)) (n (vector-length cells)))
            (do ((x 0 (+ x 1))) ((or (= x n) (null? todo)))
              (let* ((id (virtual-origin (vector-ref cells x))) (item (and id (assv id todo))))
                (when item
                  (set! todo (remove (lambda (entry) (eq? item entry)) todo))
                  (set! out (cons (append (list 'grid-image at x) (take (cdr item) 3)) out)))))))))))

(define (terminal-graphics-projections g t p)
  "Return G's visible inline image placements in terminal T's projection P."
  (append (virtual-projections g t p) (physical-projections g t p)))

(define (physical-projections g t p)
  (filter-map
   (lambda (item)
     (let ((row (cadr item)))
       (and (eq? (list-ref item 6) (terminal-alternate? t))
            (let find ((i 0))
              (and (< i (terminal-rows t))
                   (if (eq? row (terminal-row t i))
                       (let ((at (terminal-grid-offset p i)))
                         (and at (cons 'grid-image (cons at (take (cddr item) 4)))))
                       (find (+ i 1))))))))
   (reverse (placements g))))
