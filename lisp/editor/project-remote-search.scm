;;; The remote half of project search: the node runs ripgrep and only
;;; hits cross the route. Open documents are searched here as snapshots.

(require "minibuffer.scm")
(require "remote.scm")
(require "requests.scm")
(require "operations.scm")
(require "buffers.scm")
(require "targets.scm")
(require "lens.scm")
(require "keymaps.scm")
(require "modes.scm")
(require "dispatch.scm")
(require "commands.scm")

(provide read-remote-project-search)

(define (trim-line text)
  (let* ((n (string-length text))
         (end (if (string-suffix? "\n" text) (- n 1) n)))
    (substring text 0 (if (and (> end 0) (char=? (string-ref text (- end 1)) #\return)) (- end 1) end))))

;; 'skipped distinguishes an unrepresentable result from a non-match.
(define (parse-hit root record parts open)
  (let ((value (string->json record)))
    (and (equal? (dict-ref value "type" #f) "match")
         (let* ((data (dict-ref value "data"))
                (raw (dict-ref (dict-ref data "path") "text" #f))
                (name (and raw (if (string-prefix? "./" raw) (substring raw 2 (string-length raw)) raw)))
                (text (dict-ref (dict-ref data "lines") "text" #f))
                (line (dict-ref data "line_number"))
                (path (and name (not (any (lambda (p) (member p '("" "." ".."))) (string-split name "/")))
                           (string-append root name))))
           (cond ((and path (hash-table-contains? open path)) #f)
                 ((or (not path) (not text) (> (string-length text) 8192)) 'skipped)
                 (else (let ((text (trim-line text)))
                         (and (matches? (candidate text) parts) (list path name line 0 text #f #f)))))))))

(define (drain-errors p)
  (let loop ((tail ""))
    (let ((chunk (process-read p 'stderr)))
      (if (eof-object? chunk) tail
          (let* ((text (string-append tail chunk)) (n (string-length text)))
            (loop (substring text (max 0 (- n 2048)) n)))))))

(define (read-hits p endpoint root parts limit open stderr)
  (let ((skipped #f))
    (define (answer found) (cons skipped (reverse found)))
    (let read ((pieces '()) (size 0) (found '()) (left limit))
      (cond ((node-lost endpoint) (error "Remote search disconnected"))
          ((zero? left) (answer found))
          (else
           (let ((chunk (process-read p 'stdout)))
             (if (eof-object? chunk)
                 (let* ((why (task-join stderr)) (status (process-wait p)))
                   (cond ((node-lost endpoint) (error "Remote search disconnected"))
                         ((> (process-dropped p) 0) (error "Remote search output was dropped; narrow the query"))
                         ((not (memv status '(0 1))) (error "Remote ripgrep failed" status why))
                         ((not (eqv? size 0)) (error "Incomplete remote search output"))
                         (else (answer found))))
                 ;; Skip oversized records without assembling them; #f is discard mode.
                 (let consume ((lines (string-split chunk "\n")) (pieces pieces) (size size)
                               (found found) (left left))
                   (if (zero? left)
                       (read '() 0 found left)
                       (let* ((part (car lines)) (n (and size (+ size (string-length part))))
                              (n (and n (<= n (* 128 1024)) n))
                              (pieces (if n (if (string=? part "") pieces (cons part pieces)) '())))
                         (if (null? (cdr lines))
                             (read pieces n found left)
                             (let* ((hit (if n (and (> n 0) (parse-hit root (apply string-append (reverse pieces)) parts open)) 'skipped))
                                    (match (pair? hit)))
                               (when (eq? hit 'skipped) (set! skipped #t))
                               (consume (cdr lines) '() 0 (if match (cons hit found) found) (if match (- left 1) left))))))))))))))

(define (literal-regexp text)
  (apply string-append
         (map (lambda (c) (if (memv c '(#\\ #\. #\^ #\$ #\| #\? #\* #\+ #\( #\) #\[ #\] #\{ #\}))
                              (string #\\ c) (string c)))
              (string->list text))))

(define (disk-hits endpoint root parts limit open)
  ;; Prefer an exact, case-sensitive seed when there is one. Otherwise
  ;; rg's Unicode fold is not a superset of the editor's lowercase
  ;; matching (e.g. dotted I); pass non-ASCII lines to the exact filter.
  (let* ((ranked (sort parts (lambda (a b) (> (string-length a) (string-length b)))))
         (exact (find (lambda (p) (any char-upper-case? (string->list p))) ranked))
         (patterns (if exact (list "--fixed-strings" "-e" exact)
                       (list "--ignore-case" "-e" (literal-regexp (car ranked)) "-e" "[^\\x00-\\x7f]"))))
    (call-with-process "rg" (append '("--no-config" "--json" "--max-filesize" "8M") patterns '("--" "."))
      (lambda (p)
        (process-close-input p)
        (let ((stderr (spawn (lambda () (drain-errors p)))))
          (dynamic-wind (lambda () #f)
                        (lambda () (read-hits p endpoint root parts limit open stderr))
                        (lambda () (unless (task-done? stderr) (task-cancel stderr))))))
      #:node endpoint #:directory (location-path root))))

(define (checked-place c)
  (let* ((l (target-value (candidate-target c))) (d (location-document l)) (p (location-position l)))
    (unless (if (location-revision l)
                (= (location-revision l) (document-revision d))
                (and (= (line-number d p) (location-offset l))
                     (string=? (trim-line (line-candidate-text d p)) (candidate-text c))))
      (error "A search result changed; retry the query" (document-path d)))
    (list d p (document-revision d))))

(define (current-place? place)
  (= (caddr place) (document-revision (car place))))

(define (place-target place)
  (target 'location (location (car place) (cadr place))))

(define remote-search-map (make-keymap))
(define-key! remote-search-map "C-c C-r" 'minibuffer-retry)

(define (read-remote-project-search s dir find-root snapshot-hits make-candidate limit)
  "Read remote search results for DIR in session S asynchronously.
FIND-ROOT resolves DIR's project. SNAPSHOT-HITS takes parts, limit, paths
and documents. MAKE-CANDIDATE takes documents and a hit. LIMIT bounds results."
  (let ((mb #f) (root #f) (endpoint #f) (complete? #f)
        (preview (make-request-slot)) (export (make-request-slot)) (submit (make-request-slot)))
    (define (same-reading? input)
      (and (minibuffer-open? s) (eq? mb (open-minibuffer s)) (string=? input (minibuffer-input s))))
    (define (background slot produce deliver valid?)
      (without-operation
       (lambda () (request! slot produce deliver #:fail (lambda (e) (when (valid?) (message! s (error-text e))))))))
    (define (invalidate!)
      (set! endpoint #f)
      (cancel-request! preview)
      (cancel-request! export)
      (cancel-request! submit))
    (define (live? node)
      (if (and node (not (node-lost node))) #t
          (begin (minibuffer-set-prompt! s (string-append "Disconnected · C-c C-r retry · " (or root dir) ": "))
                 (message! s "Remote search results are stale; retry on the same route")
                 #f)))
    (define (produce input)
      (sleep 110)
      (let ((parts (pattern-parts input)))
        (if (null? parts) '()
            (let* ((base (find-root dir))
                   (node (location-endpoint base))
                   (docs (filter (lambda (d) (let ((p (document-path d))) (and p (string-prefix? base p))))
                                 (map buffer-document (buffer-list))))
                   (paths (map document-path docs))
                   (open (make-hash-table))
                   (hits (if (null? docs) '() (snapshot-hits parts (+ limit 1) paths docs)))
                   (left (- (+ limit 1) (length hits))))
              (when (same-reading? input)
                (minibuffer-set-prompt! s (string-append "Search " base ": ")))
              (for-each (lambda (p) (hash-table-set! open p #t)) paths)
              (let* ((scan (if (> left 0) (disk-hits node base parts left open) (list #f)))
                     (all (append hits (cdr scan)))
                     (capped (> (length all) limit)))
                (when (node-lost node) (error "Remote search disconnected"))
                (set! root base)
                (set! endpoint node)
                (set! complete? (and (not capped) (not (car scan))))
                (when (and (not complete?) (same-reading? input))
                  (minibuffer-set-prompt! s (string-append (if capped "Capped · narrow query · " "Some results skipped · ") base ": ")))
                (map (lambda (m)
                       (make-candidate docs
                         (if (list-ref m 5)
                             (cons (car m) (cons (substring (car m) (string-length base) (string-length (car m))) (cddr m)))
                             m)))
                     (take all (min (length all) limit))))))))
    (define (preview! _ c)
      (cancel-request! submit)
      (let ((input (minibuffer-input s)) (node endpoint))
        (define (valid?) (and (same-reading? input) (eq? c (minibuffer-selected s))))
        (when (live? node)
          (background preview (lambda () (sleep 70) (and (valid?) (not (node-lost node)) (checked-place c)))
                      (lambda (place)
                        (when (and (valid?) (live? node) place (current-place? place))
                          (with-pane s (lambda () (act-default! s (place-target place))))))
                      valid?))))
    (define (submit! _ c accept)
      (let ((input (minibuffer-input s)) (node endpoint) (selected (minibuffer-selected s)))
        (define (valid?) (and (same-reading? input) (eq? selected (minibuffer-selected s))))
        (when (live? node)
          (cancel-request! preview)
          (cancel-request! export)
          (background submit (lambda () (checked-place c))
                      (lambda (place)
                        (when (and (valid?) (live? node))
                          (if (current-place? place)
                              (accept (candidate (candidate-text c) #:target (place-target place)))
                              (message! s "A search result changed; retry the query"))))
                      valid?))))
    (define (export! _)
      (let ((input (minibuffer-input s)) (cs (minibuffer-candidates s)) (node endpoint))
        (define (valid?) (and (same-reading? input) (equal? cs (minibuffer-candidates s))))
        (cond ((null? cs) (message! s "No results to export yet"))
              ((not (live? node)) #f)
              ((not complete?) (message! s "Cannot export incomplete results; narrow the query"))
              (else
              (check-lens-size (length cs))
              (cancel-request! preview)
              (cancel-request! submit)
              (background export (lambda () (map checked-place cs))
                          (lambda (places)
                            (when (and (valid?) (live? node))
                              (if (every current-place? places)
                                  (let ((rows (line-rows (map (lambda (p) (cons (car p) (cadr p))) places))))
                                    (abort-minibuffer! s)
                                    (show-lens! s (string-append "*lens " root " " input "*") rows))
                                  (message! s "A search result changed; retry the query"))))
                          valid?)))))
    (completing-read s (string-append "Search project of " dir ": ")
                     (async-source produce #:fresh-only #t)
                     #:keymap remote-search-map #:preview preview! #:export export!
                     #:submit submit! #:invalidate invalidate! #:history 'search #:remember 'input)
    (set! mb (open-minibuffer s))))
