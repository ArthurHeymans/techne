# Source from a Fish config to report the cwd and semantic prompts.
if status is-interactive; and test "$TERM_PROGRAM" = techne
    function __techne_precmd --on-event fish_prompt
        set -l path (string replace -a '%' '%25' -- "$PWD")
        printf '\e]7;file://%s%s\e\\\e]133;A\e\\' (hostname) "$path"
    end
end
