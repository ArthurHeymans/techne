(import (techne) (techne mail smtp) (techne mail address) (techne mail mime))
(import (techne test))

(check "addresses" '("ada@example.org" "ben@example.org") (mail-addresses "Ada <ada@example.org>, ben@example.org"))
(check "quoted commas and escaped names" '("jane@example.org" "ben@example.org")
       (mail-addresses "\"Doe, Jane\" <jane@example.org>, \"Ben \\\"B\\\" Rivers\" <ben@example.org>"))
(check "comments do not split mailbox lists" '("jane@example.org" "ben@example.org")
       (mail-addresses "Jane (Sales, (Europe)) <jane@example.org>, ben@example.org (Office)"))
(check "CFWS around mailbox boundary" '("jane@example.org") (mail-addresses "Jane < jane (office) @ example.org >"))
(check "quoted local part comma" '("\"last,first\"@example.org") (mail-addresses "\"last,first\"@example.org"))
(check "quoted angle in name" '("jane@example.org") (mail-addresses "\"<Doe>, Jane\" <jane@example.org>"))
(check "canonical names quote commas" "\"Doe, Jane\" <jane@example.org>"
       (mail-display-addresses "\"Doe, Jane\" <jane@example.org>"))
(define encoded-address "=?UTF-8?Q?D=C3=B6e=2C_Jane?= <jane@example.org>")
(check "encoded display word comma is not syntax" "\"Döe, Jane\" <jane@example.org>" (mail-display-addresses encoded-address))
(define source (mail-parse (string-append "From: " encoded-address "\r\n\r\nHello")))
(check "raw field preserves address syntax" encoded-address (mail-header-raw source "from"))
(check "raw address canonical reply path" '("jane@example.org") (mail-addresses (mail-display-addresses (mail-header-raw source "from"))))
(define named (mail-compose-message "\"Doe, Jane\" <jane@example.org>" "\"Rivers, Ben\" <ben@example.org>" "Hello" "Body"))
(check "outgoing quoted comma preserved" "\"Doe, Jane\" <jane@example.org>" (mail-header-raw (mail-parse named) "from"))
(check "header and envelope share parser" '("ben@example.org") (mail-addresses (mail-header-raw (mail-parse named) "to")))
(define emoji-name "😀😀😀😀😀😀😀😀😀😀😀😀")
(define unicode-named (mail-compose-message (string-append "\"" emoji-name "\" <jane@example.org>") "ben@example.org" "Hello" "Body"))
(define unicode-from (mail-header-raw (mail-parse unicode-named) "from"))
(check "Unicode name round trip" emoji-name (cdr (assq 'name (car (mail-parse-addresses unicode-from)))))
(check-true "encoded words within RFC length" (every (lambda (word) (<= (string-length word) 75))
                                                    (filter (lambda (word) (string-prefix? "=?" word)) (string-split unicode-from " "))))
(for-each (lambda (text) (check-true "malformed syntax rejected" (guard (e (#t #t)) (mail-addresses text) #f)))
          '("\"unclosed <jane@example.org>" "Jane <<jane@example.org>>" "Jane <jane@example.org> extra"
            "jane@example.org (unclosed" "a..b@example.org" "a@@example.org" "a@" "a@example..org"
            "=?UTF-8?Q?Jane=0D=0ABcc=3A_x?= <jane@example.org>"))
(check-true "header injection refused" (guard (e (#t #t)) (mail-addresses "x@example.org\r\nRCPT TO:<bad@example.org>") #f))
(check-true "address injection refused" (guard (e (#t #t)) (mail-addresses "a@example.org> X") #f))
(define generated (mail-compose-message "ada@example.org" "ben@example.org" "Hello λ" "Plain *text*\nsecond"))
(check-true "MIME UTF-8" (string-contains generated "charset=UTF-8"))
(check-true "encoded subject" (string-contains generated "Subject: =?UTF-8?B?"))
(check-true "no Bcc" (not (string-contains generated "Bcc:")))

(define chunks (list "220 ready\r\n250-local\r\n250 AUTH PLAIN\r\n235 ok\r\n250 ok\r\n250 ok\r\n354 go\r\n250 queued\r\n221 bye\r\n"))
(define output "")
(define s (smtp-session (lambda () (if (null? chunks) #f (let ((c (car chunks))) (set! chunks (cdr chunks)) c)))
                        (lambda (text) (set! output (string-append output text))) (lambda () #t)))
(check "accepted" #t (smtp-submit! s "user" "secret" "\"Doe, Ada\" <ada@example.org>" '("ben@example.org") "Subject: hi\r\n\r\n.first\r\nlast\r\n"))
(check-true "dot stuffing" (string-contains output "\r\n..first\r\nlast\r\n.\r\n"))
(check-true "envelope" (string-contains output "MAIL FROM:<ada@example.org>\r\nRCPT TO:<ben@example.org>\r\n"))
(define bad (smtp-session (lambda () "535 authentication failed\r\n") (lambda (x) #t) (lambda () #t)))
(check-true "rejection" (guard (e (#t #t)) (smtp-submit! bad "user" "secret" "ada@example.org" '("ben@example.org") "x") #f))
;; No AUTH or envelope before the upgrade; the first TLS command is a fresh EHLO.
(define (try-starttls chunks upgrade)
  (let* ((writes '()) (data? #f)
         (s (smtp-session (lambda () (if (null? chunks) #f (let ((c (car chunks))) (set! chunks (cdr chunks)) c)))
                          (lambda (text) (set! writes (cons text writes))) (lambda () #t)))
         (accepted? (guard (e (#t #f))
                      (smtp-submit! s "user" "secret" "ada@example.org" '("ben@example.org") "body"
                                    #:starttls (lambda () (set! writes (cons 'upgrade writes)) (upgrade))
                                    #:on-data (lambda () (set! data? #t))))))
    (list accepted? data? (reverse writes))))
(define ehlo "EHLO techne.invalid\r\n")
(define starttls "STARTTLS\r\n")
(define advertised "250-local\r\n250 sTaRtTlS\r\n")
(define success (try-starttls (list "220 ready\r\n" "250-local\r\n250 sTaRt" "TlS\r\n" "220 go\r\n"
                                   "250-local\r\n250 AUTH PLAIN\r\n235 ok\r\n250 ok\r\n250 ok\r\n354 go\r\n250 queued\r\n221 bye\r\n")
                              (lambda () #t)))
(check "STARTTLS submission accepted" '(#t #t) (list (car success) (cadr success)))
(let ((writes (caddr success)))
  (check "SMTP negotiates before auth and repeats EHLO" (list ehlo starttls 'upgrade ehlo)
         (list (car writes) (cadr writes) (caddr writes) (cadddr writes)))
  (check-true "first authenticated command is inside TLS" (string-prefix? "AUTH PLAIN " (list-ref writes 4))))
(for-each
 (lambda (ehlo-reply)
   (check "SMTP requires the STARTTLS extension" (list #f #f (list ehlo))
          (try-starttls (list "220 ready\r\n" ehlo-reply) (lambda () #t))))
 '("250 STARTTLS\r\n" "250-local\r\n250 XSTARTTLS\r\n" "250-local\r\n250 AUTH PLAIN\r\n"))
(for-each
 (lambda (reply)
   (check "SMTP rejects refusal or extra plaintext, without AUTH" (list #f #f (list ehlo starttls))
          (try-starttls (list "220 ready\r\n" advertised reply) (lambda () #t))))
 '("454 unavailable\r\n" "220 go\r\n250 injected\r\n"))
(check "SMTP does not write after TLS failure" (list #f #f (list ehlo starttls 'upgrade))
       (try-starttls (list "220 ready\r\n" advertised "220 go\r\n") (lambda () (error "certificate rejected"))))
;; A server may leave the connection open after acceptance. There must be
;; no subsequent read, not even one guarded against EOF or another error.
(let ((replies "220 ready\r\n250 hello\r\n250 sender\r\n250 recipient\r\n354 go\r\n250 accepted\r\n")
      (reads 0) (writes '()))
  (let ((s (smtp-session (lambda () (set! reads (+ reads 1)) (if (= reads 1) replies (error "would hang")))
                         (lambda (text) (set! writes (cons text writes))) (lambda () #t))))
    (check "DATA acceptance does not depend on QUIT" #t
           (smtp-submit! s "" "" "a@example.org" '("b@example.org") "hello"))
    (check "no read after DATA acceptance" 1 reads)
    (check "no command after DATA acceptance" 5 (length writes))))
(test-summary)
