(import (techne) (mail date) (techne time))
(import (techne test))
(test-file #:script #t)
(define now (civil->instant '(2026 11 5 15 0 0) "UTC"))
(check "timezone" (civil->instant '(2026 11 5 13 32 0) "UTC") (mail-date->instant "Thu, 5 Nov 2026 14:32:00 +0100"))
(check "today" "13:32" (mail-date-label "5 Nov 2026 14:32:00 +0100" #:now now))
(check "yesterday" "Yesterday" (mail-date-label "Wed, 4 Nov 2026 09:15:00 +0100" #:now now))
(check "older" "Oct 30" (mail-date-label "30 Oct 2026 10:00 +0000" #:now now))
(check "other year" "2025-11-05" (mail-date-label "5 Nov 2025 10:00 +0000" #:now now))
(check "invalid" #f (mail-date->instant "31 Feb 2026 12:00:00 +0000"))
(check "unknown zone" #f (mail-date->instant "5 Nov 2026 12:00:00 WHATEVER"))
(check "missing label" "Unknown date" (mail-date-label "" #:now now))
(check "two digit year" (civil->instant '(1997 11 21 15 55 6) "UTC") (mail-date->instant "Fri, 21 Nov 97 09:55:06 -0600"))
(test-summary)
