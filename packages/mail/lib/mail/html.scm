;;; Safe, generated rich.scm trees. This is deliberately not a browser:
;;; no fetch, CSS evaluation, document spans, pictures or file targets.
;; Link targets are safe URL strings. The reader bridges them to editor
;; (target 'url URL) records, keeping this library independent of the host.

(define (h-space? c) (memv c '(#\space #\tab #\return #\newline #\x0C)))
(define (h-trim s)
  (let ((n (string-length s)))
    (let start ((a 0))
      (if (and (< a n) (h-space? (string-ref s a))) (start (+ a 1))
          (let end ((b n))
            (if (and (> b a) (h-space? (string-ref s (- b 1)))) (end (- b 1)) (substring s a b)))))))
(define (h-at? s at text)
  (let ((m (string-length text)))
    (and (<= (+ at m) (string-length s))
         (let loop ((i 0))
           (or (= i m)
               (and (char=? (string-ref s (+ at i)) (string-ref text i))
                    (loop (+ i 1))))))))
(define (h-find s text at)
  (and (<= at (string-length s)) (string-contains s text at)))
(define (h-ref xs key fallback)
  (let ((p (assoc key xs))) (if p (cdr p) fallback)))
(define (h-name? c)
  (let ((v (char->integer c)))
    (or (<= 65 v 90) (<= 97 v 122) (<= 48 v 57) (memv c '(#\- #\: #\_)))))
(define h-entities
  '(("amp" . "&") ("lt" . "<") ("gt" . ">") ("quot" . "\"") ("apos" . "'")
    ("nbsp" . " ") ("copy" . "©") ("reg" . "®") ("trade" . "™")
    ("hellip" . "…") ("mdash" . "—") ("ndash" . "–") ("lsquo" . "‘") ("rsquo" . "’")
    ("ldquo" . "“") ("rdquo" . "”") ("bull" . "•") ("middot" . "·") ("euro" . "€")
    ("pound" . "£") ("yen" . "¥") ("laquo" . "«") ("raquo" . "»") ("times" . "×") ("divide" . "÷")))
(define (h-entity word)
  (if (and (> (string-length word) 1) (char=? (string-ref word 0) #\#))
      (let* ((hex? (and (> (string-length word) 2) (memv (string-ref word 1) '(#\x #\X))))
             (digits (substring word (if hex? 2 1) (string-length word)))
             (v (and (> (string-length digits) 0)
                     (every (lambda (c) (or (char<=? #\0 c #\9)
                                            (and hex? (char<=? #\a (char-downcase c) #\f))))
                            (string->list digits))
                     (string->number digits (if hex? 16 10)))))
        (and v (string (integer->char (if (or (<= v 0) (> v 1114111) (<= 55296 v 57343)) 65533 v)))))
      (h-ref h-entities word #f)))
(define (h-unescape s)
  (let ((n (string-length s)) (out (open-output-string)))
    (let loop ((i 0))
      (when (< i n)
        (let* ((end (and (char=? (string-ref s i) #\&)
                         (let scan ((j (+ i 1)))
                           (cond ((or (= j n) (> (- j i) 32)) #f)
                                 ((char=? (string-ref s j) #\;) j)
                                 ((or (h-space? (string-ref s j)) (memv (string-ref s j) '(#\< #\&))) #f)
                                 (else (scan (+ j 1)))))))
               (value (and end (h-entity (substring s (+ i 1) end)))))
          (if value (begin (display value out) (loop (+ end 1)))
              (begin (write-char (string-ref s i) out) (loop (+ i 1)))))))
    (get-output-string out)))

;; Return #(closing? name attributes self-closing? next), or #f. Attribute
;; names remain strings: untrusted input never interns arbitrary symbols.
(define (h-tag s at)
  (let* ((n (string-length s)) (closing? (h-at? s (+ at 1) "/")) (start (+ at (if closing? 2 1)))
         (name-end (let loop ((i start)) (if (and (< i n) (h-name? (string-ref s i))) (loop (+ i 1)) i))))
    (and (> name-end start)
         (let find-end ((i name-end) (quoted-char #f))
           (cond ((= i n) #f)
                 ;; Reject malformed nested '<' in tags, including quoted
                 ;; attributes, to keep recovery linear rather than rescanning
                 ;; an unterminated quoted tail for every '<' in the message.
                 ((char=? (string-ref s i) #\<) #f)
                 ((and (not quoted-char) (char=? (string-ref s i) #\>))
                  (let ((self? (and (> i name-end) (char=? (string-ref s (- i 1)) #\/)))
                        (name (string-downcase (substring s start name-end))))
                    (let attrs ((j name-end) (acc '()))
                      (cond ((>= j i) (vector closing? name (reverse acc) self? (+ i 1)))
                            ((or (h-space? (string-ref s j)) (char=? (string-ref s j) #\/)) (attrs (+ j 1) acc))
                            (else
                             (let* ((end (let scan ((k j))
                                           (if (and (< k i) (not (h-space? (string-ref s k)))
                                                    (not (memv (string-ref s k) '(#\= #\/ #\>)))) (scan (+ k 1)) k)))
                                    (key (string-downcase (substring s j end)))
                                    (eq (let scan ((k end)) (if (and (< k i) (h-space? (string-ref s k))) (scan (+ k 1)) k))))
                               (if (= end j) (attrs (+ j 1) acc)
                                   (if (and (< eq i) (char=? (string-ref s eq) #\=))
                                       (let* ((value-start (let scan ((k (+ eq 1))) (if (and (< k i) (h-space? (string-ref s k))) (scan (+ k 1)) k)))
                                              (q (and (< value-start i) (memv (string-ref s value-start) '(#\' #\")) (string-ref s value-start)))
                                              (from (if q (+ value-start 1) value-start))
                                              (stop (let scan ((k from))
                                                      (if (and (< k i) (if q (not (char=? (string-ref s k) q)) (not (h-space? (string-ref s k)))))
                                                          (scan (+ k 1)) k))))
                                         (attrs (if q (min i (+ stop 1)) stop)
                                                (cons (cons key (h-unescape (substring s from stop))) acc)))
                                       (attrs eq (cons (cons key "") acc))))))))))
                 ((and quoted-char (char=? (string-ref s i) quoted-char)) (find-end (+ i 1) #f))
                 ((and (not quoted-char) (memv (string-ref s i) '(#\' #\"))) (find-end (+ i 1) (string-ref s i)))
                 (else (find-end (+ i 1) quoted-char)))))))

(define h-void '("area" "base" "br" "col" "embed" "hr" "img" "input" "link" "meta" "param" "source" "track" "wbr"))
(define h-drop '("script" "style" "head" "title" "iframe" "object" "svg" "math" "template" "noscript"
                 "audio" "video" "canvas" "form" "textarea" "select" "button" "applet" "frameset" "frame" "portal"))
(define h-block-tags '("p" "div" "section" "article" "header" "footer" "main" "aside" "address" "center"
                  "h1" "h2" "h3" "h4" "h5" "h6" "pre" "blockquote" "ul" "ol" "li" "hr" "table" "tr" "td" "th" "dl" "dt" "dd"))
;; Frames are #(tag attrs reversed-children). Finish mismatched elements
;; conservatively; support omitted p/li/td/tr closing tags common in email.
(define (h-dom html max-nodes)
  (let* ((n (string-length html))
         ;; Only ASCII tag names are folded; Unicode expansion would shift offsets.
         ;; Computed lazily so documents with no dropped raw-content tags skip the pass.
         (lower #f)
         (root (vector "root" '() '())) (stack (list root)) (count 0))
    (define (add! node)
      (set! count (+ count 1))
      (when (> count max-nodes) (error "mail html: node budget exceeded" max-nodes))
      (vector-set! (car stack) 2 (cons node (vector-ref (car stack) 2))))
    (define (finish!)
      (let ((node (car stack)))
        (set! stack (cdr stack))
        (vector-set! node 2 (reverse (vector-ref node 2)))
        (add! node)))
    (define (close! name)
      (when (any (lambda (f) (string=? (vector-ref f 0) name)) (cdr (reverse stack)))
        (let loop ()
          (let ((same? (string=? (vector-ref (car stack) 0) name)))
            (finish!) (unless same? (loop))))))
    (define (skip-content name at)
      (unless lower
        (set! lower (string-map (lambda (c) (if (char<=? #\A c #\Z) (char-downcase c) c)) html)))
      (let loop ((at at))
        (let ((pos (h-find lower (string-append "</" name) at)))
          (if (not pos) n
              (let ((tag (h-tag html pos)))
                (if (and tag (string=? (vector-ref tag 1) name)) (vector-ref tag 4) (loop (+ pos 2))))))))
    (let loop ((at 0))
      (when (< at n)
        (cond ((h-at? html at "<!--") (loop (let ((end (h-find html "-->" (+ at 4)))) (if end (+ end 3) n))))
              ((or (h-at? html at "<!") (h-at? html at "<?"))
               (loop (let ((end (h-find html ">" (+ at 2)))) (if end (+ end 1) n))))
              ((char=? (string-ref html at) #\<)
               (let ((tag (h-tag html at)))
                 (if (not tag) (begin (add! "<") (loop (+ at 1)))
                     (let ((name (vector-ref tag 1)) (next (vector-ref tag 4)))
                       (cond ((vector-ref tag 0) (close! name) (loop next))
                             ((member name h-drop) (loop (if (vector-ref tag 3) next (skip-content name next))))
                             ((member name '("base" "link" "meta" "embed" "input" "source" "track" "param" "area" "col")) (loop next))
                             (else
                              (when (and (member name h-block-tags) (string=? (vector-ref (car stack) 0) "p")) (finish!))
                              (when (or (and (string=? name "li") (string=? (vector-ref (car stack) 0) "li"))
                                        (and (member name '("td" "th")) (member (vector-ref (car stack) 0) '("td" "th")))) (finish!))
                              (when (string=? name "tr")
                                (when (member (vector-ref (car stack) 0) '("td" "th")) (finish!))
                                (when (string=? (vector-ref (car stack) 0) "tr") (finish!)))
                              (let ((node (vector name (vector-ref tag 2) '())))
                                (if (or (vector-ref tag 3) (member name h-void) (>= (length stack) 64))
                                    (add! node) (set! stack (cons node stack))))
                              (loop next)))))))
              (else (let ((end (or (h-find html "<" at) n)))
                      (add! (h-unescape (substring html at end))) (loop end))))))
    (let loop () (when (pair? (cdr stack)) (finish!) (loop)))
    (reverse (vector-ref root 2))))

(define (h-safe-url s)
  (let* ((s (h-trim s)) (lower (string-downcase s)))
    (and (every (lambda (c) (let ((v (char->integer c))) (and (> v 32) (not (= v 127))))) (string->list s))
         (or (and (h-at? lower 0 "https://") (> (string-length s) 8))
             (and (h-at? lower 0 "http://") (> (string-length s) 7))
             (and (h-at? lower 0 "mailto:") (> (string-length s) 7))) s)))
(define (h-collapse s)
  (let ((out (open-output-string)))
    (let loop ((xs (string->list s)) (space? #f))
      (unless (null? xs)
        (let ((c (car xs)))
          (if (h-space? c)
              (begin (unless space? (write-char #\space out)) (loop (cdr xs) #t))
              (begin
                ;; Drop controls and bidi overrides rather than spoof labels.
                (unless (or (< (char->integer c) 32) (<= 8234 (char->integer c) 8238) (<= 8294 (char->integer c) 8297))
                  (write-char c out))
                (loop (cdr xs) #f))))))
    (get-output-string out)))
(define (h-tag-name node) (and (vector? node) (vector-ref node 0)))
(define (h-children node) (vector-ref node 2))
(define (h-raw-text nodes)
  (apply string-append
         (map (lambda (x) (cond ((string? x) x) ((string=? (h-tag-name x) "br") "\n")
                               (else (h-raw-text (h-children x))))) nodes)))
(define (h-lines s)
  (let loop ((at 0) (acc '()))
    (let ((end (h-find s "\n" at)))
      (if end (loop (+ end 1) (cons (substring s at end) acc))
          (reverse (cons (substring s at (string-length s)) acc))))))
(define (h-inlines nodes)
  (append-map
   (lambda (node)
     (if (string? node) (let ((s (h-collapse node))) (if (string=? s "") '() (list s)))
         (let* ((name (h-tag-name node)) (children (h-children node)) (xs (h-inlines children)))
           (cond ((member name '("strong" "b")) (list (cons 'strong xs)))
                 ((member name '("em" "i")) (list (cons 'emph xs)))
                 ((member name '("s" "del" "strike")) (list (cons 'strike xs)))
                 ((member name '("code" "kbd" "samp")) (list (cons 'code xs)))
                 ((string=? name "br") '((hard-break)))
                 ((string=? name "img")
                  (let* ((attrs (vector-ref node 1))
                         (w (h-trim (h-ref attrs "width" "")))
                         (h (h-trim (h-ref attrs "height" ""))))
                    ;; Never parse untrusted, potentially huge numeric attributes.
                    (if (and (member w '("0" "1" "2")) (member h '("0" "1" "2"))) '()
                        (list (string-append "[remote-image-blocked: "
                                             (h-collapse (h-ref attrs "alt" "image")) "]")))))
                 ((string=? name "a")
                  (let ((url (h-safe-url (h-ref (vector-ref node 1) "href" ""))))
                    (if url (list (cons 'link (cons url (if (null? xs) (list url) xs)))) xs)))
                 (else xs))))) nodes))

;; Group text/inline runs into paragraphs, retaining block structure. Unknown
;; wrappers are transparent, but cannot turn attributes into rich primitives.
(define (h-has-block? nodes)
  (any (lambda (x) (and (vector? x)
                        (or (member (h-tag-name x) h-block-tags) (h-has-block? (h-children x))))) nodes))
(define (h-inline-visible? x)
  (cond ((string? x) (not (string=? (h-trim x) "")))
        ((not (pair? x)) #f)
        ((eq? (car x) 'hard-break) #f)
        ((eq? (car x) 'link) (any h-inline-visible? (cddr x)))
        (else (any h-inline-visible? (cdr x)))))
(define (h-blocks nodes)
  (let ((pending '()) (blocks '()))
    (define (flush!)
      (let ((xs (h-inlines (reverse pending))))
        (when (any h-inline-visible? xs)
          (set! blocks (cons (cons 'paragraph xs) blocks)))
        (set! pending '())))
    (for-each
     (lambda (node)
       (let ((name (h-tag-name node)))
         (cond ((not name) (set! pending (cons node pending)))
               ((member name h-block-tags)
                (flush!) (set! blocks (append (reverse (h-block node)) blocks)))
               ;; Layout/unknown wrappers are transparent even when their
               ;; block descendants are several levels below the wrapper.
               ((or (member name '("html" "body" "tbody" "thead" "tfoot")) (h-has-block? (h-children node)))
                (flush!) (set! blocks (append (reverse (h-blocks (h-children node))) blocks)))
               (else (set! pending (cons node pending)))))) nodes)
    (flush!) (reverse blocks)))
(define (h-descendants nodes tag)
  (append-map (lambda (x)
                (cond ((string? x) '()) ((string=? (h-tag-name x) tag) (list x))
                      (else (h-descendants (h-children x) tag)))) nodes))
(define (h-table node)
  ;; Newsletter tables usually position content, not tabular data. Preserve
  ;; their blocks in reading order instead of drawing empty spacer grids.
  (let ((role (string-downcase (h-ref (vector-ref node 1) "role" ""))))
    (if (or (member role '("presentation" "none"))
            (pair? (h-descendants (h-children node) "table"))
            (and (null? (h-descendants (h-children node) "th"))
                 (or (assoc "width" (vector-ref node 1))
                     (equal? (h-ref (vector-ref node 1) "border" #f) "0")
                     (every (lambda (row)
                              (<= (length (filter (lambda (x) (member (h-tag-name x) '("td" "th"))) (h-children row))) 1))
                            (h-descendants (h-children node) "tr")))))
        (h-blocks (h-children node))
        (h-data-table node))))
(define (h-data-table node)
  (let* ((rows (h-descendants (h-children node) "tr"))
         (cells (map (lambda (row)
                       (map (lambda (cell) (h-inlines (h-children cell)))
                            (filter (lambda (x) (member (h-tag-name x) '("td" "th"))) (h-children row)))) rows))
         (width (if (null? cells) 0 (apply max (map length cells)))))
    ;; Ragged rows must not amplify a bounded DOM into an enormous padded grid.
    (if (or (= width 0) (> width 32) (> (* width (length cells)) 4096)) (h-blocks (h-children node))
        (let* ((cells (map (lambda (r) (append r (make-list (- width (length r)) '()))) cells))
               (header? (and (pair? rows) (any (lambda (x) (equal? (h-tag-name x) "th")) (h-children (car rows)))))
               (header (if header? (car cells) (make-list width '())))
               (body (if header? (cdr cells) cells)))
          (list (cons 'table (cons (make-list width 'left) (cons header body))))))))
(define (h-block node)
  (let ((name (h-tag-name node)) (children (h-children node)))
    (cond ((member name '("h1" "h2" "h3" "h4" "h5" "h6"))
           (list (cons 'heading (cons (string->number (substring name 1 2)) (h-inlines children)))))
          ((string=? name "pre") (list (cons 'code-block (cons #f (h-lines (h-raw-text children))))))
          ((string=? name "blockquote") (list (cons 'quote (h-blocks children))))
          ((member name '("ul" "ol"))
           (let ((index 0))
             (list (cons 'list
                         (filter-map
                          (lambda (child)
                            (and (equal? (h-tag-name child) "li")
                                 (begin (set! index (+ index 1))
                                        (cons 'item (cons (and (string=? name "ol") (string-append (number->string index) "."))
                                                          (cons #f (h-blocks (h-children child)))))))) children)))))
          ((string=? name "hr") '((rule)))
          ((string=? name "table") (h-table node))
          (else (h-blocks children)))))

(define (mail-html->rich html #:max-nodes [max-nodes 50000])
  "Convert untrusted HTML to a generated rich.scm block list, without I/O.
Head/script/style and embedded active content are discarded. No CSS,
images or remote resources are loaded. Every img becomes descriptive text
marked remote-image-blocked, including cid/data/file images. Only explicit
HTTP(S)/mailto links become link nodes with URL string targets; other
schemes are inert. A reader converts these strings to (target 'url URL)
records before rich-present!, so this library needs no editor primitives.
Text is entity-decoded, never interpreted as Markdown. Common headings,
paragraphs, emphasis, links, quotes, lists, pre/code and tables survive.
Reject inputs over 2 Mi characters or MAX-NODES (default 50000) nodes;
flatten nesting past 64. This is a bounded tolerant reader, not an HTML5
browser or HTML serializer."
  (unless (string? html) (error "mail html: expected text"))
  (when (> (string-length html) 2097152) (error "mail html: input exceeds 2 Mi characters"))
  (h-blocks (h-dom html max-nodes)))
