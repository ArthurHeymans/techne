    (define (mail-charset-name charset)
      "Return the canonical name of CHARSET, a MIME charset label.
Case, underscores and the usual aliases (latin1, cp1252, win-1252,
iso8859-15) are folded; a label not known is returned in lower case."
      (let* ((s (string-replace (string-downcase (string-trim charset)) "_" "-"))
             (after (lambda (prefix) (substring s (string-length prefix) (string-length s)))))
        (cond ((member s '("utf-8" "utf8")) "utf-8")
              ((member s '("us-ascii" "ascii" "ansi-x3.4-1968")) "us-ascii")
              ((member s '("latin1" "latin-1" "l1" "iso8859-1" "cp819")) "iso-8859-1")
              ((member s '("latin2" "latin-2" "l2")) "iso-8859-2")
              ((member s '("latin5" "latin-5" "l5")) "iso-8859-9")
              ((member s '("latin9" "latin-9" "l9")) "iso-8859-15")
              ((string-prefix? "iso8859-" s) (string-append "iso-8859-" (after "iso8859-")))
              ((string-prefix? "x-cp125" s) (string-append "windows-" (after "x-cp")))
              ((string-prefix? "cp125" s) (string-append "windows-" (after "cp")))
              ((string-prefix? "win-125" s) (string-append "windows-" (after "win-")))
              ((string-prefix? "windows125" s) (string-append "windows-" (after "windows")))
              ((string=? s "koi8r") "koi8-r")
              (else s))))

    (define (mail-charset-table charset)
      "Return the table of the single-byte CHARSET, or #f if it has none.
The table is a vector of 128 code points, for the bytes 128 to 255;
bytes below 128 are ASCII. UTF-8, Latin-1 and unknown labels have none."
      (let ((entry (assoc (mail-charset-name charset) tables)))
        (and entry (cdr entry))))))
